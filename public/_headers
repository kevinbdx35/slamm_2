/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://*.basemaps.cartocdn.com https://*.tile.openstreetmap.org https://img.youtube.com https://i.ytimg.com; connect-src 'self'; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'

# Les PDF sont affichés dans des <iframe> same-origin (/reglement, /sparring) :
# on autorise le cadrage par notre propre domaine, sinon DENY/frame-ancestors 'none'
# du bloc /* bloque l'affichage ("n'autorise pas la connexion").
/SLAMM_reglement_interieur.pdf
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'

/SLAMM_poster_regles_sparring.pdf
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
