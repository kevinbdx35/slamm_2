---
import { Image } from 'astro:assets';
import { ASSOCONNECT_URLS } from '../config/urls.js';
import { CLUB_STATS } from '../config/club.js';
import cagePhoto from '../assets/img/team/cage.webp';
---

<section class="hero" id="accueil">
  <div class="container hero-inner">
    <div class="hero-content">
      <p class="hero-eyebrow">Saint-Lunaire, Bretagne · Association loi 1901</p>

      <h1 class="hero-title">
        <span class="title-line title-line-1">Saint-Lunaire</span>
        <span class="title-line title-line-2">Arts Martiaux Mixtes</span>
      </h1>

      <p class="hero-desc">
        Une approche moderne des arts martiaux mixtes. Technique, discipline et
        communauté, au cœur de la Côte d'Émeraude.
      </p>

      <div class="hero-actions">
        <a href={ASSOCONNECT_URLS.TRIAL_BOOKING} target="_blank" rel="noopener noreferrer" class="btn-primary">
          Réserver un cours d'essai
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href={ASSOCONNECT_URLS.ANNUAL_MEMBERSHIP} target="_blank" rel="noopener noreferrer" class="btn-ghost">
          S'inscrire au club
        </a>
      </div>

      <dl class="hero-stats">
        {CLUB_STATS.map(s => (
          <div class="stat">
            <dt class="stat-label">{s.label}</dt>
            <dd class="stat-num">{s.num}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="hero-media">
      <Image
        src={cagePhoto}
        alt="Entraînement de MMA dans la cage de la salle SLAMM à Saint-Lunaire"
        class="hero-photo"
        widths={[480, 720, 1000]}
        sizes="(max-width: 900px) 100vw, 480px"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: center;
    gap: 64px;
    padding-top: 96px;
    padding-bottom: 72px;
  }

  /* Eyebrow (texte simple, sans pastille) */
  .hero-eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--g400);
    margin-bottom: 28px;
    animation: fadeUp 500ms var(--ease-out) both;
  }

  /* Title */
  .hero-title {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(34px, 3.8vw, 54px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin-bottom: 28px;
    overflow: hidden;
    text-wrap: initial;
  }

  .title-line {
    display: block;
    animation: slideIn 600ms var(--ease-out) both;
  }
  /* Deux lignes, deux couleurs : le lieu en blanc, la discipline en vert */
  .title-line-1 {
    color: var(--text);
    animation-delay: 60ms;
  }
  .title-line-2 {
    color: var(--g400);
    animation-delay: 120ms;
  }

  @keyframes slideIn {
    from { transform: translateY(100%); opacity: 0; }
    to   { transform: translateY(0);    opacity: 1; }
  }

  /* Desc */
  .hero-desc {
    font-size: clamp(16px, 1.5vw, 19px);
    color: var(--text-3);
    line-height: 1.65;
    margin-bottom: 40px;
    max-width: 30em;
    animation: fadeUp 500ms var(--ease-out) 260ms both;
  }

  /* Actions */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    animation: fadeUp 500ms var(--ease-out) 320ms both;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--bg);
    background: var(--g500);
    padding: 14px 28px;
    border-radius: 100px;
    white-space: nowrap;
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease, transform 160ms var(--ease-out);
  }

  .btn-primary:active {
    transform: scale(0.97);
  }

  .btn-primary:hover {
    background: var(--g400);
  }

  .btn-primary svg {
    transition: transform 200ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .btn-primary:hover svg {
      transform: translateX(3px);
    }
  }

  /* Action secondaire : contour bien lisible (objectif de conversion n°2) */
  .btn-ghost {
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
    padding: 14px 24px;
    border-radius: 100px;
    border: 1px solid rgba(74,222,128,0.45);
    white-space: nowrap;
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease, transform 160ms var(--ease-out);
  }

  .btn-ghost:active {
    transform: scale(0.97);
  }

  .btn-ghost:hover {
    color: var(--text);
    border-color: rgba(74,222,128,0.7);
    background: rgba(34,197,94,0.06);
  }

  /* Chiffres clés : bloc de preuve sous les CTA, séparé par un filet */
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, max-content));
    gap: 56px;
    margin-top: 44px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
    animation: fadeUp 500ms var(--ease-out) 380ms both;
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 6px;
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-3);
  }

  /* Photo : pleine hauteur de colonne, collée au bord droit de l'écran */
  .hero-media {
    position: relative;
    align-self: stretch;
    margin-right: calc(-1 * (max(0px, (100vw - 1200px) / 2) + 24px));
    min-height: min(64svh, 560px);
    animation: heroPhotoIn 700ms var(--ease-out) 120ms both;
  }

  /* Positionnée en absolu : c'est la colonne de texte qui fixe la hauteur, pas le ratio de l'image */
  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 58%;
    border-radius: var(--r-lg) 0 0 var(--r-lg);
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Photo : léger zoom arrière + fondu (jamais depuis scale(0)) */
  @keyframes heroPhotoIn {
    from { opacity: 0; transform: scale(0.97); }
    to   { opacity: 1; transform: scale(1); }
  }

  @media (max-width: 900px) {
    .hero { min-height: auto; }
    .hero-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
      padding-top: 104px;
      padding-bottom: 48px;
    }
    /* Photo de bord à bord, sous les chiffres */
    .hero-media { margin-inline: -24px; min-height: 0; }
    .hero-photo {
      position: static;
      height: auto;
      aspect-ratio: 4 / 3;
      border-radius: 0;
    }
  }

  @media (max-width: 768px) {
    .hero-media { margin-inline: -16px; }
  }

  @media (max-width: 600px) {
    .hero-eyebrow { font-size: 11px; letter-spacing: 0.06em; margin-bottom: 20px; }
    .hero-title { font-size: 36px; }
    .hero-stats { gap: 16px; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 36px; padding-top: 24px; }
    .stat-num { font-size: 32px; }
    .hero-desc { margin-bottom: 32px; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .btn-primary, .btn-ghost { justify-content: center; text-align: center; }
  }
</style>
