---
import { Image } from 'astro:assets';
import { ASSOCONNECT_URLS } from '../config/urls.js';
import cagePhoto from '../assets/img/team/cage.webp';
---

<section class="hero" id="accueil">
  <div class="container hero-inner">
    <div class="hero-content">
      <p class="hero-eyebrow">Saint-Lunaire, Bretagne · Association loi 1901</p>

      <h1 class="hero-title">
        <span class="title-line title-line-1">Saint-Lunaire</span>
        <span class="title-line title-line-2">Arts Martiaux</span>
        <span class="title-line title-line-3">Mixtes</span>
      </h1>

      <p class="hero-desc">
        Une approche moderne des arts martiaux mixtes. Technique, discipline et
        communauté, au cœur de la Côte d'Émeraude.
      </p>

      <div class="hero-actions">
        <a href={ASSOCONNECT_URLS.TRIAL_BOOKING} target="_blank" rel="noopener noreferrer" class="btn-primary">
          Réserver un cours d'essai
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href={ASSOCONNECT_URLS.ANNUAL_MEMBERSHIP} target="_blank" rel="noopener noreferrer" class="btn-ghost">
          S'inscrire au club
        </a>
      </div>
    </div>

    <div class="hero-media">
      <Image
        src={cagePhoto}
        alt="Entraînement de MMA dans la cage de la salle SLAMM à Saint-Lunaire"
        class="hero-photo"
        widths={[480, 720, 1000]}
        sizes="(max-width: 900px) 100vw, 480px"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: center;
    gap: 64px;
    padding-top: 112px;
    padding-bottom: 72px;
  }

  /* Eyebrow (texte simple, sans pastille) */
  .hero-eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--g400);
    margin-bottom: 28px;
    animation: fadeUp 1s var(--ease-out) 0.2s both;
  }

  /* Title */
  .hero-title {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(34px, 4.3vw, 62px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin-bottom: 28px;
    overflow: hidden;
    text-wrap: initial;
  }

  .title-line {
    display: block;
    animation: slideIn 1s var(--ease-out) both;
  }
  .title-line-1 {
    color: var(--text-3);
    animation-delay: 0.4s;
  }
  .title-line-2 {
    color: var(--text);
    animation-delay: 0.55s;
  }
  .title-line-3 {
    color: var(--g400);
    animation-delay: 0.7s;
  }

  @keyframes slideIn {
    from { transform: translateY(100%); opacity: 0; }
    to   { transform: translateY(0);    opacity: 1; }
  }

  /* Desc */
  .hero-desc {
    font-size: clamp(16px, 1.5vw, 19px);
    color: var(--text-3);
    line-height: 1.65;
    margin-bottom: 40px;
    max-width: 30em;
    animation: fadeUp 1s var(--ease-out) 0.9s both;
  }

  /* Actions */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    animation: fadeUp 1s var(--ease-out) 1.1s both;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--bg);
    background: var(--g500);
    padding: 14px 28px;
    border-radius: 100px;
    white-space: nowrap;
    transition: background 0.25s, transform 0.25s, box-shadow 0.25s;
  }

  .btn-primary:hover {
    background: var(--g400);
    transform: translateY(-2px);
  }

  .btn-primary svg {
    transition: transform 0.2s;
  }
  .btn-primary:hover svg {
    transform: translateX(3px);
  }

  .btn-ghost {
    font-size: 15px;
    font-weight: 500;
    color: var(--text-2);
    padding: 14px 24px;
    border-radius: 100px;
    border: 1px solid var(--border-strong);
    white-space: nowrap;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .btn-ghost:hover {
    color: var(--text);
    border-color: rgba(74,222,128,0.4);
    background: rgba(34,197,94,0.04);
  }

  /* Photo */
  .hero-media {
    position: relative;
    animation: fadeUp 1s var(--ease-out) 0.6s both;
  }

  .hero-photo {
    width: 100%;
    height: min(68svh, 600px);
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: var(--r-lg);
    border: 1px solid var(--border);
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 900px) {
    .hero { min-height: auto; }
    .hero-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
      padding-top: 104px;
      padding-bottom: 48px;
    }
    .hero-photo {
      height: auto;
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 600px) {
    .hero-eyebrow { font-size: 11px; letter-spacing: 0.06em; margin-bottom: 20px; }
    .hero-title { font-size: 30px; }
    .hero-desc { margin-bottom: 32px; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .btn-primary, .btn-ghost { justify-content: center; text-align: center; }
  }
</style>
