---
import { ASSOCONNECT_URLS } from '../config/urls.js';
---

<section class="hero" id="accueil">
  <div class="container hero-inner">
    <div class="hero-badge">
      <span class="badge-dot"></span>
      Saint-Lunaire, Bretagne · Association loi 1901
    </div>

    <h1 class="hero-title">
      <span class="title-line title-line-1">Saint-Lunaire</span>
      <span class="title-line title-line-2">Arts Martiaux</span>
      <span class="title-line title-line-3">Mixtes</span>
    </h1>

    <p class="hero-desc">
      Une approche moderne des arts martiaux mixtes.<br/>
      Technique, discipline, communauté — au cœur de la Côte d'Émeraude.
    </p>

    <div class="hero-actions">
      <a href={ASSOCONNECT_URLS.TRIAL_BOOKING} target="_blank" rel="noopener noreferrer" class="btn-primary">
        Réserver un cours d'essai
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a href="/disciplines" class="btn-ghost">Découvrir les disciplines</a>
    </div>

    <div class="hero-stats">
      <div class="stat">
        <span class="stat-num">35+</span>
        <span class="stat-label">Licenciés</span>
      </div>
      <div class="stat-sep" aria-hidden="true"></div>
      <div class="stat">
        <span class="stat-num">2</span>
        <span class="stat-label">Disciplines</span>
      </div>
      <div class="stat-sep" aria-hidden="true"></div>
      <div class="stat">
        <span class="stat-num">16+</span>
        <span class="stat-label">ans</span>
      </div>
    </div>
  </div>

  <div class="hero-scroll" aria-hidden="true">
    <span></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    padding-top: 120px;
    padding-bottom: 80px;
    max-width: 900px;
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--g400);
    background: rgba(34,197,94,0.08);
    border: 1px solid rgba(34,197,94,0.18);
    padding: 6px 14px;
    border-radius: 100px;
    margin-bottom: 40px;
    animation: fadeUp 1s var(--ease-out) 0.2s both;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background: var(--g500);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--g500);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.4; }
  }

  /* Title */
  .hero-title {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(36px, 6vw, 80px);
    line-height: 0.92;
    letter-spacing: -0.03em;
    margin-bottom: 32px;
    overflow: hidden;
  }

  .title-line {
    display: block;
    animation: slideIn 1s var(--ease-out) both;
  }
  .title-line-1 {
    color: var(--text-3);
    animation-delay: 0.4s;
  }
  .title-line-2 {
    color: var(--text);
    animation-delay: 0.55s;
  }
  .title-line-3 {
    color: var(--g400);
    animation-delay: 0.7s;
  }

  @keyframes slideIn {
    from { transform: translateY(100%); opacity: 0; }
    to   { transform: translateY(0);    opacity: 1; }
  }

  /* Desc */
  .hero-desc {
    font-size: clamp(16px, 2vw, 20px);
    color: var(--text-3);
    font-weight: 400;
    line-height: 1.7;
    margin-bottom: 48px;
    max-width: 520px;
    animation: fadeUp 1s var(--ease-out) 0.9s both;
  }

  /* Actions */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 72px;
    animation: fadeUp 1s var(--ease-out) 1.1s both;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--bg);
    background: var(--g500);
    padding: 14px 28px;
    border-radius: 100px;
    transition: background 0.25s, transform 0.25s, box-shadow 0.25s;
    box-shadow: 0 0 0 0 rgba(34,197,94,0.4);
  }

  .btn-primary:hover {
    background: var(--g400);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(34,197,94,0.3);
  }

  .btn-primary svg {
    transition: transform 0.2s;
  }
  .btn-primary:hover svg {
    transform: translateX(3px);
  }

  .btn-ghost {
    font-size: 15px;
    font-weight: 500;
    color: var(--text-3);
    padding: 14px 24px;
    border-radius: 100px;
    border: 1px solid var(--border-strong);
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .btn-ghost:hover {
    color: var(--text);
    border-color: rgba(74,222,128,0.4);
    background: rgba(34,197,94,0.04);
  }

  /* Stats */
  .hero-stats {
    display: flex;
    align-items: center;
    gap: 32px;
    animation: fadeUp 1s var(--ease-out) 1.3s both;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .stat-label {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .stat-sep {
    width: 1px;
    height: 40px;
    background: var(--border);
  }

  /* Scroll hint */
  .hero-scroll {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    width: 24px;
    height: 40px;
    border: 1.5px solid var(--border-strong);
    border-radius: 100px;
    display: flex;
    justify-content: center;
    padding-top: 6px;
    animation: fadeUp 1s var(--ease-out) 1.6s both;
  }

  .hero-scroll span {
    width: 4px;
    height: 8px;
    background: var(--g500);
    border-radius: 100px;
    animation: scrollAnim 2s ease-in-out infinite;
  }

  @keyframes scrollAnim {
    0%   { transform: translateY(0);  opacity: 1; }
    80%  { transform: translateY(12px); opacity: 0; }
    100% { transform: translateY(0);  opacity: 0; }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 600px) {
    .hero-stats { gap: 20px; }
    .stat-num   { font-size: 24px; }
    .hero-actions { flex-direction: column; align-items: flex-start; }
  }
</style>
