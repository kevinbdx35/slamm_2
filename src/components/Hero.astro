---
import { Image } from 'astro:assets';
import { ASSOCONNECT_URLS } from '../config/urls.js';
import { CLUB_STATS } from '../config/club.js';
import cagePhoto from '../assets/img/team/cage.webp';
---

<section class="hero" id="accueil">
  <!-- Photo en fond : pleine hauteur à droite (desktop), plein écran (mobile), fondue dans le noir -->
  <div class="hero-media">
    <Image
      src={cagePhoto}
      alt="Entraînement de MMA dans la cage de la salle SLAMM à Saint-Lunaire"
      class="hero-photo"
      widths={[480, 750, 1000, 1170]}
      sizes="(max-width: 900px) 100vw, 60vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-scrim" aria-hidden="true"></div>
  </div>

  <div class="container hero-inner">
    <div class="hero-content">
      <p class="hero-eyebrow">Saint-Lunaire, Bretagne · Association loi 1901</p>

      <h1 class="hero-title">
        <span class="title-line title-line-1"><span class="title-text">Saint-Lunaire</span></span>
        <span class="title-line title-line-2"><span class="title-text">Arts Martiaux Mixtes</span></span>
      </h1>

      <p class="hero-desc">
        Une approche moderne des arts martiaux mixtes. Technique, discipline et
        communauté, au cœur de la Côte d'Émeraude.
      </p>

      <div class="hero-actions">
        <a href={ASSOCONNECT_URLS.TRIAL_BOOKING} target="_blank" rel="noopener noreferrer" class="btn-primary">
          Réserver un cours d'essai
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href={ASSOCONNECT_URLS.ANNUAL_MEMBERSHIP} target="_blank" rel="noopener noreferrer" class="btn-ghost">
          S'inscrire au club
        </a>
      </div>

      <dl class="hero-stats">
        {CLUB_STATS.map(s => {
          // « 35+ » → compteur animé sur 35, suffixe « + » fixe
          const to = parseInt(s.num, 10);
          const suffix = s.num.slice(String(to).length);
          return (
            <div class="stat">
              <dt class="stat-label">{s.label}</dt>
              <dd class="stat-num">
                <span class="sr-only">{s.num}</span>
                <span aria-hidden="true"><span class="count" data-to={to} style={`min-width: ${String(to).length}ch`}>{to}</span>{suffix}</span>
              </dd>
            </div>
          );
        })}
      </dl>
    </div>

  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    isolation: isolate;
    overflow: hidden;
  }

  /* Le texte passe au-dessus de la photo et empiète sur sa zone fondue */
  .hero-inner {
    position: relative;
    z-index: 1;
    padding-top: 112px;
    padding-bottom: 72px;
  }

  .hero-content {
    max-width: 640px;
  }

  /* Eyebrow (texte simple, sans pastille) */
  .hero-eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--g400);
    margin-bottom: 28px;
    animation: fadeUp 500ms var(--ease-out) both;
  }

  /* Title */
  .hero-title {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(34px, 3.8vw, 54px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin-bottom: 28px;
    text-wrap: initial;
  }

  /* Chaque ligne est sa propre fente : le texte en sort par le bas, sans fondu.
     Marge de 0.08em (compensée) pour ne pas rogner accents et jambages. */
  .title-line {
    display: block;
    overflow: clip;
    padding-block: 0.08em;
    margin-block: -0.08em;
  }
  .title-text {
    display: block;
    animation: lineReveal 600ms var(--ease-out) both;
  }
  /* Deux lignes, deux couleurs : le lieu en blanc, la discipline en vert */
  .title-line-1 { color: var(--text); }
  .title-line-2 { color: var(--g400); }
  .title-line-1 .title-text { animation-delay: 60ms; }
  .title-line-2 .title-text { animation-delay: 120ms; }

  @keyframes lineReveal {
    from { transform: translateY(120%); }
    to   { transform: translateY(0); }
  }

  /* Desc */
  .hero-desc {
    font-size: clamp(16px, 1.5vw, 19px);
    color: var(--text-3);
    line-height: 1.65;
    margin-bottom: 40px;
    max-width: 30em;
    animation: fadeUp 500ms var(--ease-out) 260ms both;
  }

  /* Actions */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    animation: fadeUp 500ms var(--ease-out) 320ms both;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--bg);
    background: var(--g500);
    padding: 14px 28px;
    border-radius: 100px;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 200ms ease, transform 160ms var(--ease-out);
  }

  .btn-primary:active {
    transform: scale(0.97);
  }

  .btn-primary svg {
    transition: transform 200ms var(--ease-out);
  }

  /* Survols réservés aux pointeurs fins : pas d'état collé après un tap */
  @media (hover: hover) and (pointer: fine) {
    .btn-primary:hover { background: var(--g400); }
    .btn-primary:hover svg { transform: translateX(3px); }
    .btn-ghost:hover {
      border-color: rgba(74,222,128,0.7);
      background: rgba(34,197,94,0.06);
    }
  }

  /* Action secondaire : contour bien lisible (objectif de conversion n°2) */
  .btn-ghost {
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
    padding: 14px 24px;
    border-radius: 100px;
    border: 1px solid rgba(74,222,128,0.45);
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 200ms ease, border-color 200ms ease, transform 160ms var(--ease-out);
  }

  .btn-ghost:active {
    transform: scale(0.97);
  }

  /* Chiffres clés : bloc de preuve sous les CTA, séparé par un filet */
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, max-content));
    gap: 56px;
    margin-top: 44px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
    animation: fadeUp 500ms var(--ease-out) 380ms both;
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 6px;
  }

  /* Compteur : largeur réservée (chiffres tabulaires) pour que le « + » ne bouge pas */
  .count {
    display: inline-block;
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-3);
  }

  /* Photo : pleine hauteur du hero, collée en haut, à droite et en bas, sans cadre */
  .hero-media {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 60%;
    z-index: 0;
    /* Fondu réel (transparence) vers la gauche et vers le bas : aucune arête
       visible, quel que soit le fond (halo vert du site compris) */
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 45%), linear-gradient(0deg, transparent 0%, #000 30%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(90deg, transparent 0%, #000 45%), linear-gradient(0deg, transparent 0%, #000 30%);
    mask-composite: intersect;
  }

  .hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
    /* Visible dès la 1re frame (LCP) : zoom lent qui se pose, jamais de bord visible */
    animation: heroPhotoSettle 1200ms var(--ease-out) both;
  }

  /* Assombrissement léger : côté texte et sous la nav (lisibilité des liens) */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(8,15,10,0.55) 0%, rgba(8,15,10,0) 60%),
      linear-gradient(180deg, rgba(8,15,10,0.85) 0%, rgba(8,15,10,0.4) 12%, rgba(8,15,10,0) 26%);
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes heroPhotoSettle {
    from { transform: scale(1.06); }
    to   { transform: scale(1); }
  }

  @keyframes heroFade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* Mouvement réduit : simple fondu de 300ms pour le texte, photo fixe (compteurs coupés en JS).
     Plus spécifique que la règle globale (*), qui sinon supprime tout. */
  @media (prefers-reduced-motion: reduce) {
    .hero-eyebrow, .title-text, .hero-desc, .hero-actions, .hero-stats {
      animation: heroFade 300ms ease both !important;
    }
    .hero-photo { animation: none !important; }
  }

  /* Mobile / tablette : photo en plein écran, texte par-dessus en bas (effet story) */
  @media (max-width: 900px) {
    .hero { align-items: flex-end; }
    .hero-inner { padding-top: 30svh; padding-bottom: 40px; }
    .hero-media {
      width: 100%;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .hero-photo { object-position: 50% 22%; }
    .hero-scrim {
      background:
        linear-gradient(0deg, var(--bg) 0%, var(--bg) 22%, rgba(8,15,10,0.86) 58%, rgba(8,15,10,0.45) 84%, rgba(8,15,10,0.6) 100%);
    }
  }

  @media (max-width: 600px) {
    .hero-eyebrow { font-size: 11px; letter-spacing: 0.06em; margin-bottom: 20px; }
    .hero-title { font-size: 36px; }
    .hero-stats { gap: 16px; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 36px; padding-top: 24px; }
    .stat-num { font-size: 32px; }
    .hero-desc { margin-bottom: 32px; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .btn-primary, .btn-ghost { justify-content: center; text-align: center; }
  }
</style>

<script>
  // Compteurs des chiffres clés : de 0 à la valeur, 900ms, ease-out exponentielle,
  // décalés de 80ms, lancés quand le bloc a fini d'apparaître (~400ms).
  // Mouvement réduit : rien à faire, la valeur finale est déjà dans le HTML.
  const counters = document.querySelectorAll<HTMLElement>('.hero-stats .count');
  if (counters.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const easeOutExpo = (t: number) => (t >= 1 ? 1 : 1 - Math.pow(2, -10 * t));
    const DURATION = 900, START = 400, STAGGER = 80;
    counters.forEach((el, i) => {
      const to = Number(el.dataset.to) || 0;
      el.textContent = '0';
      const begin = performance.now() + START + i * STAGGER;
      const tick = (now: number) => {
        const t = Math.max(0, (now - begin) / DURATION);
        el.textContent = String(Math.round(to * easeOutExpo(t)));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }
</script>
