---
import { ASSOCONNECT_URLS } from '../config/urls.js';
---

<a
  id="fab"
  href={ASSOCONNECT_URLS.TRIAL_BOOKING}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Réserver un cours d'essai"
  title="Réserver un cours d'essai"
>
  <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
    <rect x="3" y="4" width="16" height="15" rx="2" stroke="currentColor" stroke-width="1.6"/>
    <path d="M7 2v4M15 2v4M3 9h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    <path d="M7 13h2M11 13h2M7 16h2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
  </svg>
</a>

<style>
  #fab {
    position: fixed;
    bottom: 28px;
    right: 24px;
    z-index: 200;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--g500);
    color: var(--bg);
    display: grid;
    place-items: center;
    box-shadow: 0 4px 20px rgba(34,197,94,0.35);
    opacity: 0;
    transform: scale(0.9);
    pointer-events: none;
    /* Sortie rapide */
    transition: opacity 150ms ease, transform 150ms ease, background-color 200ms ease;
  }

  #fab.visible {
    opacity: 1;
    transform: scale(1);
    pointer-events: all;
    transition: opacity 250ms var(--ease-out), transform 250ms var(--ease-out), background-color 200ms ease;
  }

  #fab:hover {
    background: var(--g400);
  }

  @media (hover: hover) and (pointer: fine) {
    #fab.visible:hover {
      transform: scale(1.04);
    }
  }

  #fab.visible:active {
    transform: scale(0.94);
    transition-duration: 120ms;
  }

  @media (max-width: 768px) {
    #fab { bottom: 20px; right: 16px; }
  }
</style>

<script>
  // Visible après 100px de scroll : sentinelle observée (pas d'écouteur scroll)
  const fab = document.getElementById('fab');
  if (fab) {
    const sentinel = document.createElement('div');
    sentinel.setAttribute('aria-hidden', 'true');
    sentinel.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:100px;pointer-events:none;visibility:hidden';
    document.body.prepend(sentinel);
    new IntersectionObserver(([entry]) => {
      fab.classList.toggle('visible', !entry.isIntersecting);
    }).observe(sentinel);
  }
</script>
