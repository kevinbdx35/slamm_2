---
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Layout from '../layouts/Layout.astro';
import { ASSOCONNECT_URLS, CONTACT_INFO } from '../config/urls.js';
import { SCHEDULE, PRICING, SEASON, getActivePeriodIndex, formatTimeDisplay } from '../config/schedule.js';
import { Image } from 'astro:assets';
import teamImg from '../assets/img/team/equipe2026.webp';
import TrialCta from './TrialCta.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  city: string;
  distance: string;
  areaServed: string[];
  schema: object;
}

const { title, description, canonical, city, distance, areaServed, schema } = Astro.props;

const disciplines = [
  { name: 'MMA', full: 'Mixed Martial Arts', desc: 'La discipline reine : debout, clinch, sol. Un sport complet qui synthétise les meilleures techniques de combat du monde.', sessions: 'Lun · Mer · Ven' },
  { name: 'Sparring', full: 'Séance MMA · Mise en pratique', desc: 'La mise en pratique libre. Appliquer ses techniques dans des échanges encadrés, en toute sécurité et dans le respect de l\'adversaire.', sessions: 'Vendredi 20h' },
  { name: 'Luta Livre', full: 'Luta Livre · No-Gi', desc: 'Lutte brésilienne sans kimono. Soumissions, contrôles au sol, étranglements et clés articulaires : le grappling dans sa forme la plus pure.', sessions: 'Mardi 18h15' },
];

const activeIdx = getActivePeriodIndex();
const displayIdx = activeIdx === -1 ? 0 : activeIdx;
const adultPrice = PRICING.adult.periods[displayIdx].price;
// « à 5 min » ne se coupe jamais en fin de ligne
const nbspDistance = `à\u00a0${distance.replace(/ /g, '\u00a0')}`;
---

<Layout {title} {description} {canonical} pageSchema={schema}>
  <Nav />
  <main id="main">

    <!-- Hero : texte à gauche, photo d'équipe à droite (même composition que l'accueil) -->
    <section class="geo-hero">
      <div class="container geo-hero-grid">
        <div class="geo-hero-text">
          <h1 class="geo-h1">
            <span class="title-slot"><span class="title-slot-text">MMA à {city},</span></span>{' '}
            <span class="title-slot title-accent"><span class="title-slot-text">le club SLAMM est {nbspDistance}</span></span>
          </h1>
          <p class="geo-hero-sub reveal reveal-delay-2">Pratique le MMA dans un club sérieux et convivial, à Saint-Lunaire.<br/>À partir de 16 ans · Tous niveaux · Coachs diplômés FMMAF</p>
          <div class="geo-actions reveal reveal-delay-3">
            <a href={ASSOCONNECT_URLS.TRIAL_BOOKING} target="_blank" rel="noopener noreferrer" class="btn-primary">
              Réserver un cours d'essai
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href="/disciplines" class="btn-ghost">Voir les disciplines</a>
          </div>
        </div>
        <div class="geo-hero-media">
          <Image src={teamImg} alt={`L'équipe SLAMM, club MMA proche de ${city}`} class="geo-img" widths={[560, 830, 1100]} sizes="(max-width: 960px) 100vw, 560px" loading="eager" />
        </div>
      </div>
    </section>

    <!-- Intro : une colonne de texte -->
    <section class="geo-intro-section">
      <div class="container">
        <div class="geo-intro-text reveal">
          <h2 class="section-title">
            Le club MMA<br/>
            <span>le plus proche de {city}</span>
          </h2>
          <p class="geo-body">Tu habites {areaServed.join(', ')} ? SLAMM est ton club de MMA le plus proche, à Saint-Lunaire, à seulement {distance} en voiture. Grappling, No-Gi, boxe, kickboxing et lutte pour tous les niveaux.</p>
          <p class="geo-body">Des coachs diplômés FMMAF, une vraie communauté, sans faire des kilomètres.</p>
          <a href={ASSOCONNECT_URLS.TRIAL_BOOKING} target="_blank" rel="noopener noreferrer" class="btn-primary btn-inline">
            Réserver un cours d'essai
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Disciplines : liste éditoriale -->
    <section class="geo-disc-section">
      <div class="container">
        <div class="section-header reveal">
          <h2 class="section-title">
            Les disciplines<br/>
            <span>accessibles depuis {city}</span>
          </h2>
        </div>
        <ul class="disc-list">
          {disciplines.map((d, i) => (
            <li class={`disc-row reveal reveal-delay-${i + 1}`}>
              <div class="disc-head">
                <h3 class="disc-name">{d.name}</h3>
                <p class="disc-full">{d.full}</p>
              </div>
              <p class="disc-desc">{d.desc}</p>
              <p class="disc-sessions">{d.sessions}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Infos pratiques : 3 colonnes à plat -->
    <section class="geo-infos-section">
      <div class="container geo-infos-grid">
        <div class="info-col reveal">
          <h2 class="info-card-title">Accès depuis {city}</h2>
          <ul class="info-list">
            <li>{distance} en voiture</li>
            <li>361 Rue de la Saudrais, 35800 Saint-Lunaire</li>
            <li>Parking gratuit sur place</li>
          </ul>
          <div class="schedule-list">
            {SCHEDULE.filter(s => !s.inactive).map(s => (
              <div class="schedule-row">
                <span class="schedule-day">{s.day}</span>
                <span class="schedule-time">{formatTimeDisplay(s.start)} → {formatTimeDisplay(s.end)}</span>
                {s.label && <span class="schedule-label">{s.label}</span>}
              </div>
            ))}
          </div>
        </div>
        <div class="info-col reveal reveal-delay-1">
          <h2 class="info-card-title">Tarifs {SEASON}</h2>
          <ul class="info-list">
            <li>Adhésion (+16 ans) : <strong>{adultPrice} €</strong> <span class="period-note">pour la saison, jusqu'à fin juin</span></li>
            <li>Tu rejoins en cours d'année ? Tu ne paies que les mois restants</li>
            <li>Licence fédérale + assurance incluses</li>
            <li>CB en 3 fois possible</li>
          </ul>
          <a href="/tarifs" class="info-link">Voir les tarifs détaillés →</a>
        </div>
        <div class="info-col reveal reveal-delay-2">
          <h2 class="info-card-title">Cours d'essai</h2>
          <ul class="info-list">
            <li>Gratuit en début de saison (sept-oct)</li>
            <li>{PRICING.trial.price} € par séance en cours d'année</li>
            <li>Déductible de l'adhésion si inscription</li>
            <li>À partir de 16 ans · Aucune expérience requise</li>
          </ul>
          <a href={ASSOCONNECT_URLS.TRIAL_BOOKING} target="_blank" rel="noopener noreferrer" class="info-link">Réserver un cours d'essai →</a>
        </div>
      </div>
    </section>

    <!-- Appel final : bande partagée, titre local conservé en h2 -->
    <section class="geo-cta-section">
      <div class="container">
        <TrialCta
          as="h2"
          title="Rejoins le club MMA"
          accent={`le plus proche de ${city}`}
          desc="Premier cours gratuit en début de saison. Aucune expérience requise."
        />
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  /* ── Hero ── */
  .geo-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 64px;
    align-items: center;
    padding-top: 136px;
    padding-bottom: 96px;
  }

  .geo-h1 {
    font-family: var(--font-display);
    font-size: clamp(34px, 4.2vw, 56px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 24px;
  }

  .geo-h1 .title-accent { color: var(--g400); }

  .geo-hero-sub {
    font-size: clamp(16px, 1.5vw, 18px);
    color: var(--text-3);
    line-height: 1.7;
    margin-bottom: 36px;
    max-width: 34em;
  }

  .geo-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* Photo visible dès la 1re image (élément LCP probable : pas de rideau),
     zoom lent qui se pose comme dans le hero de l'accueil ; l'overflow du
     cadre contient le zoom */
  .geo-hero-media {
    overflow: hidden;
    border-radius: var(--r-lg);
  }

  .geo-img {
    width: 100%;
    height: auto;
    aspect-ratio: 830 / 459;
    object-fit: cover;
    object-position: 50% 70%;
    animation: geoPhotoSettle 1200ms var(--ease-out) both;
  }

  @keyframes geoPhotoSettle {
    from { transform: scale(1.06); }
    to   { transform: scale(1); }
  }

  /* ── Boutons (mêmes que le hero de l'accueil) ── */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--bg);
    background: var(--g500);
    padding: 14px 28px;
    border-radius: 100px;
    transition: background-color 200ms ease, transform 160ms var(--ease-out);
  }

  .btn-primary:active { transform: scale(0.97); }
  .btn-primary svg { transition: transform 200ms var(--ease-out); }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
    border: 1px solid rgba(74,222,128,0.45);
    padding: 13px 26px;
    border-radius: 100px;
    transition: background-color 200ms ease, border-color 200ms ease, transform 160ms var(--ease-out);
  }

  .btn-ghost:active { transform: scale(0.97); }

  @media (hover: hover) and (pointer: fine) {
    .btn-primary:hover { background: var(--g400); }
    .btn-primary:hover svg { transform: translateX(3px); }
    .btn-ghost:hover { background: rgba(34,197,94,0.06); border-color: rgba(74,222,128,0.7); }
    .info-link:hover { color: var(--text); }
  }

  .btn-inline { align-self: flex-start; margin-top: 8px; }

  /* ── Titres ── */
  .section-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .section-title span { color: var(--g400); }

  .section-header { margin-bottom: 56px; }

  /* ── Intro ── */
  .geo-intro-section {
    padding: 112px 0;
    position: relative;
  }

  .geo-intro-section::before,
  .geo-disc-section::before,
  .geo-infos-section::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
  }

  .geo-intro-text {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 720px;
  }

  .geo-body {
    font-size: 17px;
    color: var(--text-3);
    line-height: 1.7;
  }

  /* ── Disciplines : nom (3) · description (5) · jours (3) ── */
  .geo-disc-section {
    padding: 112px 0;
    position: relative;
  }

  .disc-list {
    list-style: none;
    border-top: 1px solid var(--border-strong);
  }

  .disc-row {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 3fr);
    gap: 40px;
    align-items: baseline;
    padding: 32px 0;
    border-bottom: 1px solid var(--border);
  }

  .disc-name {
    font-family: var(--font-display);
    font-size: clamp(26px, 2.8vw, 34px);
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .disc-full {
    margin-top: 10px;
    font-size: 14px;
    font-weight: 500;
    color: var(--g400);
  }

  .disc-desc {
    font-size: 16px;
    color: var(--text-3);
    line-height: 1.7;
  }

  .disc-sessions {
    justify-self: end;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }

  /* ── Infos pratiques ── */
  .geo-infos-section {
    padding: 112px 0 96px;
    position: relative;
  }

  .geo-infos-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px;
  }

  .info-col {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-top: 24px;
    border-top: 1px solid var(--border-strong);
  }

  .info-card-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .info-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 15px;
    color: var(--text-3);
    line-height: 1.6;
    flex: 1;
  }

  .info-link {
    font-size: 14px;
    font-weight: 600;
    color: var(--g400);
    transition: color 200ms ease;
  }

  .schedule-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 1px solid var(--border);
    padding-top: 16px;
  }

  .schedule-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
  }

  .schedule-day {
    font-weight: 600;
    color: var(--text);
    min-width: 76px;
  }

  .schedule-time { color: var(--text-3); font-variant-numeric: tabular-nums; }

  .schedule-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--g400);
  }

  .period-note {
    font-size: 13px;
    color: var(--text-muted);
    font-weight: 400;
  }

  .info-list strong { color: var(--text); }

  /* ── Appel final ── */
  .geo-cta-section {
    padding: 0 0 112px;
  }

  /* ── Responsive ── */
  @media (max-width: 960px) {
    .geo-hero-grid { grid-template-columns: minmax(0, 1fr); gap: 40px; padding-top: 112px; padding-bottom: 64px; }
    /* Photo de bord à bord, au ratio d'origine */
    .geo-hero-media { margin-inline: -24px; border-radius: 0; }
    .geo-infos-grid { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .disc-row { grid-template-columns: minmax(0, 1fr); gap: 12px; padding: 26px 0; }
    .disc-sessions { justify-self: start; }
    .geo-intro-section, .geo-disc-section { padding: 80px 0; }
    .geo-infos-section { padding: 80px 0 72px; }
    .geo-cta-section { padding-bottom: 80px; }
  }

  @media (max-width: 768px) {
    .geo-hero-media { margin-inline: -16px; }
  }

  @media (max-width: 600px) {
    .geo-actions { flex-direction: column; align-items: stretch; }
    .btn-inline { align-self: stretch; }
  }

  @media (prefers-reduced-motion: reduce) {
    .geo-img { animation: none !important; }
    .btn-primary svg { transition: none; }
    .btn-primary:hover svg { transform: none; }
  }
</style>
