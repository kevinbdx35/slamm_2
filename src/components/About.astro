---
import { Image } from 'astro:assets';
import teamPhoto from '../assets/img/team/team.webp';

const stats = [
  { num: '35+', label: 'Licenciés' },
  { num: '2', label: 'Disciplines' },
  { num: '16+', label: 'ans' },
];
---

<section class="about" id="about">
  <div class="container">

    <div class="about-top">
      <div class="about-photo-wrap reveal">
        <Image
          src={teamPhoto}
          alt="Les licenciés et coachs du club SLAMM réunis sur le tatami à Saint-Lunaire"
          class="about-photo"
          widths={[560, 830]}
          sizes="(max-width: 900px) 100vw, 560px"
        />
      </div>

      <div class="about-text reveal reveal-delay-1">
        <h2 class="about-title">
          Nés de la passion,<br/>
          <span>construits ensemble.</span>
        </h2>
        <p class="about-body">
          Saint-Lunaire Arts Martiaux Mixtes est une association loi 1901 fondée par
          3 passionnés locaux. Notre philosophie : dépasser les codes du MMA traditionnel
          pour proposer un espace d'entraînement ouvert à tous, où la technique prime
          sur l'ego et la progression individuelle nourrit le collectif.
        </p>
        <p class="about-body">
          Au cœur de la Côte d'Émeraude, nous cultivons une discipline exigeante
          dans un environnement bienveillant. Ouvert à partir de 16 ans, du débutant
          au compétiteur confirmé, chacun trouve sa place.
        </p>
        <div class="about-tags">
          <span class="tag">Fédération française FMMAF</span>
          <span class="tag">Tous niveaux</span>
        </div>
      </div>
    </div>

    <div class="about-bottom">
      <dl class="about-stats reveal">
        {stats.map(s => (
          <div class="stat">
            <dt class="stat-label">{s.label}</dt>
            <dd class="stat-num">{s.num}</dd>
          </div>
        ))}
      </dl>

      <ul class="about-values reveal reveal-delay-1">
        <li class="value">
          <div class="value-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <h3>Excellence technique</h3>
            <p>Des coachs titulaires de diplômes fédéraux qui transmettent les fondamentaux avec rigueur et pédagogie.</p>
          </div>
        </li>
        <li class="value">
          <div class="value-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
              <path d="M8 12l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <h3>Inclusion &amp; respect</h3>
            <p>Un environnement safe où chaque pratiquant est respecté quels que soient son niveau ou son parcours.</p>
          </div>
        </li>
        <li class="value">
          <div class="value-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="1.5"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <h3>Communauté locale</h3>
            <p>Ancrés dans le territoire de Saint-Lunaire, nous tissons des liens forts entre sportifs, familles et partenaires locaux bretons.</p>
          </div>
        </li>
      </ul>
    </div>

  </div>
</section>

<style>
  .about {
    padding: 112px 0;
    position: relative;
  }

  .about::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
  }

  /* Haut : photo (gauche) + texte (droite), inverse du hero */
  .about-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
    margin-bottom: 96px;
  }

  .about-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 28px;
  }

  .about-title span { color: var(--g400); }

  .about-body {
    font-size: 16px;
    color: var(--text-3);
    line-height: 1.75;
    margin-bottom: 18px;
    max-width: 60ch;
  }

  .about-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .tag {
    font-size: 12px;
    font-weight: 500;
    color: var(--g400);
    background: rgba(34,197,94,0.08);
    border: 1px solid rgba(34,197,94,0.15);
    padding: 5px 12px;
    border-radius: 100px;
    letter-spacing: 0.02em;
  }

  /* Photo */
  .about-photo-wrap {
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .about-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 830 / 459;
    object-fit: cover;
  }

  /* Bas : stats (gauche) + valeurs en liste (droite) */
  .about-bottom {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 64px;
    align-items: start;
  }

  .about-stats {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: clamp(44px, 6vw, 72px);
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .stat:first-child .stat-num { color: var(--g400); }

  .stat-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .about-values {
    list-style: none;
  }

  .value {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 20px;
    padding: 28px 0;
    border-top: 1px solid var(--border);
  }

  .value:first-child {
    padding-top: 0;
    border-top: none;
  }

  .value-icon {
    width: 44px;
    height: 44px;
    background: rgba(34,197,94,0.1);
    border-radius: var(--r-md);
    display: grid;
    place-items: center;
    color: var(--g400);
  }

  .value h3 {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 6px;
    letter-spacing: -0.02em;
  }

  .value p {
    font-size: 15px;
    color: var(--text-3);
    line-height: 1.7;
    max-width: 52ch;
  }

  @media (max-width: 900px) {
    .about { padding: 80px 0; }
    .about-top { grid-template-columns: minmax(0, 1fr); gap: 40px; margin-bottom: 64px; }
    .about-bottom { grid-template-columns: minmax(0, 1fr); gap: 48px; }
    .about-stats { flex-direction: row; justify-content: space-between; gap: 16px; }
    .stat-num { font-size: clamp(36px, 11vw, 56px); }
  }
</style>
