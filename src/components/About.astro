---
import { Image } from 'astro:assets';
import teamPhoto from '../assets/img/team/equipe2026.webp';

const values = [
  {
    title: 'Excellence technique',
    text: 'Des coachs titulaires de diplômes fédéraux qui transmettent les fondamentaux avec rigueur et pédagogie.',
  },
  {
    title: 'Inclusion & respect',
    text: 'Un environnement safe où chaque pratiquant est respecté quels que soient son niveau ou son parcours.',
  },
  {
    title: 'Communauté locale',
    text: 'Ancrés dans le territoire de Saint-Lunaire, nous tissons des liens forts entre sportifs, familles et partenaires locaux bretons.',
  },
];
---

<section class="about" id="about">
  <div class="container">

    <!-- 1. Titre en tête, sur la largeur -->
    <h2 class="about-title reveal">
      <span class="about-title-line"><span class="about-title-text">Nés de la passion,</span></span>
      <span class="about-title-line about-title-accent"><span class="about-title-text">construits ensemble.</span></span>
    </h2>

    <!-- 2. Photo large (7/12) + texte étroit (5/12) -->
    <div class="about-split">
      <div class="about-photo-wrap reveal">
        <Image
          src={teamPhoto}
          alt="Les licenciés et coachs du club SLAMM réunis sur le tatami à Saint-Lunaire"
          class="about-photo"
          widths={[660, 990, 1320]}
          sizes="(max-width: 900px) 100vw, 660px"
          loading="eager"
          fetchpriority="low"
        />
      </div>

      <div class="about-text reveal">
        <p class="about-body">
          Association loi 1901 fondée par trois passionnés locaux. Ici, la technique
          prime sur l'ego et chaque progression nourrit le collectif.
        </p>
        <p class="about-body">
          Au cœur de la Côte d'Émeraude, nous cultivons une discipline exigeante
          dans un environnement bienveillant. Ouvert à partir de 16 ans, du débutant
          au compétiteur confirmé, chacun trouve sa place.
        </p>
        <div class="about-tags">
          <span class="tag">Fédération française FMMAF</span>
          <span class="tag">Tous niveaux</span>
        </div>
      </div>
    </div>

    <!-- 3. Valeurs : trois colonnes de texte sous un filet, sans cartes -->
    <ul class="about-values reveal">
      {values.map(v => (
        <li class="value">
          <h3>{v.title}</h3>
          <p>{v.text}</p>
        </li>
      ))}
    </ul>

  </div>
</section>

<script>
  // Le rideau ne s'ouvre qu'une fois l'image chargée, sinon il se déroulerait
  // sur un cadre vide (connexion lente). L'image est en eager + priorité basse :
  // en lazy, Chrome ne la chargerait jamais tant que le clip-path la masque.
  const photo = document.querySelector<HTMLImageElement>('.about-photo');
  if (photo && !photo.complete) {
    photo.classList.add('is-loading');
    const ready = () => photo.classList.remove('is-loading');
    photo.addEventListener('load', ready, { once: true });
    photo.addEventListener('error', ready, { once: true });
  }
</script>

<style>
  .about {
    padding: 112px 0;
    position: relative;
  }

  .about::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
  }

  .about-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 56px;
    text-wrap: initial;
  }

  /* Chaque ligne est une fente, comme le titre du hero : le texte en sort par
     le bas. Marge de 0.08em (compensée) pour ne pas rogner accents et jambages. */
  .about-title-line {
    display: block;
    overflow: clip;
    padding-block: 0.08em;
    margin-block: -0.08em;
  }
  .about-title-text { display: block; }
  .about-title-accent { color: var(--g400); }

  /* Photo large à gauche, texte étroit à droite (asymétrie 7/5) */
  .about-split {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 56px;
    align-items: center;
    margin-bottom: 96px;
  }

  .about-photo-wrap {
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .about-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 830 / 459;
    object-fit: cover;
    /* Photo 4:3 avec beaucoup de mur en haut : on cadre sur le groupe */
    object-position: 50% 70%;
  }

  .about-body {
    font-size: 16px;
    color: var(--text-3);
    line-height: 1.75;
    max-width: 60ch;
  }

  .about-body + .about-body { margin-top: 18px; }

  .about-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .tag {
    font-size: 12px;
    font-weight: 500;
    color: var(--g400);
    background: rgba(34,197,94,0.08);
    border: 1px solid rgba(34,197,94,0.15);
    padding: 5px 12px;
    border-radius: 100px;
    letter-spacing: 0.02em;
  }

  .about-values {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px;
  }

  /* Filet en pseudo-élément (et non border-top) pour pouvoir le dessiner */
  .value {
    --rule: var(--border-strong);
    position: relative;
    padding-top: 24px;
  }

  .value::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: var(--rule);
    transform-origin: left;
  }

  .value h3 {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 10px;
    letter-spacing: -0.02em;
  }

  .value p {
    font-size: 15px;
    color: var(--text-3);
    line-height: 1.7;
    max-width: 42ch;
  }

  @media (max-width: 900px) {
    .about { padding: 80px 0; }
    .about-title { margin-bottom: 32px; }
    .about-split { grid-template-columns: minmax(0, 1fr); gap: 32px; margin-bottom: 64px; }
    /* Photo de bord à bord, comme dans le hero */
    .about-photo-wrap { margin-inline: -24px; border-radius: 0; }
    .about-values { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .value { padding: 24px 0; --rule: var(--border); }
    .value:first-child { --rule: var(--border-strong); }
  }

  @media (max-width: 768px) {
    .about-photo-wrap { margin-inline: -16px; }
  }

  /* ── Entrées au scroll ──────────────────────────────────────────────
     Les blocs gardent la classe .reveal (l'observer du layout pose .visible),
     mais on remplace le fondu générique par un geste propre à chacun. */

  /* Titre : lignes qui sortent de leur fente, 60ms d'écart */
  :global(.js) .about-title.reveal { opacity: 1; transform: none; transition: none; }
  :global(.js) .about-title-text {
    transform: translateY(120%);
    transition: transform 600ms var(--ease-out);
  }
  :global(.js) .about-title-accent .about-title-text { transition-delay: 60ms; }
  :global(.js) .about-title.visible .about-title-text { transform: translateY(0); }

  /* Photo : dévoilée de haut en bas, zoom qui se pose. Le rideau est sur
     l'image, pas sur le wrapper observé : un clip-path total sur la cible
     empêcherait l'IntersectionObserver de la voir. Les coins arrondis
     restent gérés par l'overflow du wrapper. */
  :global(.js) .about-photo-wrap.reveal { opacity: 1; transform: none; transition: none; }
  :global(.js) .about-photo-wrap .about-photo {
    clip-path: inset(0 0 100% 0);
    transform: scale(1.04);
    transition:
      clip-path 700ms var(--ease-out),
      transform 1000ms var(--ease-out);
  }
  :global(.js) .about-photo-wrap.visible .about-photo:not(.is-loading) {
    clip-path: inset(0 0 0 0);
    transform: scale(1);
  }

  /* Texte : part pendant la fin du dévoilement de la photo */
  :global(.js) .about-text.reveal { transition-delay: 150ms; }

  /* Valeurs : filets dessinés depuis la gauche, puis texte, en cascade */
  :global(.js) .about-values.reveal { opacity: 1; transform: none; transition: none; }
  .value:nth-child(2) { --stagger: 60ms; }
  .value:nth-child(3) { --stagger: 120ms; }
  :global(.js) .value::before {
    transform: scaleX(0);
    transition: transform 500ms var(--ease-out) var(--stagger, 0ms);
  }
  :global(.js) .value > * {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 400ms var(--ease-out) calc(var(--stagger, 0ms) + 150ms),
      transform 400ms var(--ease-out) calc(var(--stagger, 0ms) + 150ms);
  }
  :global(.js) .about-values.visible .value::before { transform: scaleX(1); }
  :global(.js) .about-values.visible .value > * { opacity: 1; transform: none; }

  /* Mouvement réduit : fondus seuls, ni fente, ni rideau, ni zoom, filets déjà tracés */
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .about-title.reveal { opacity: 0; transition: opacity 300ms ease; }
    :global(.js) .about-title.reveal.visible { opacity: 1; }
    :global(.js) .about-title-text { transform: none; transition: none; }

    :global(.js) .about-photo-wrap.reveal { opacity: 0; transition: opacity 300ms ease; }
    :global(.js) .about-photo-wrap.reveal.visible { opacity: 1; }
    :global(.js) .about-photo-wrap .about-photo { clip-path: none; transform: none; transition: none; }

    :global(.js) .value::before { transform: none; transition: none; }
    :global(.js) .value > * {
      transform: none;
      transition: opacity 300ms ease calc(var(--stagger, 0ms) + 0ms);
    }
  }
</style>
