---
import { Image } from 'astro:assets';
import teamPhoto from '../assets/img/team/equipe2026.webp';

const values = [
  {
    title: 'Excellence technique',
    text: 'Des coachs titulaires de diplômes fédéraux qui transmettent les fondamentaux avec rigueur et pédagogie.',
  },
  {
    title: 'Inclusion & respect',
    text: 'Un environnement safe où chaque pratiquant est respecté quels que soient son niveau ou son parcours.',
  },
  {
    title: 'Communauté locale',
    text: 'Ancrés dans le territoire de Saint-Lunaire, nous tissons des liens forts entre sportifs, familles et partenaires locaux bretons.',
  },
];
---

<section class="about" id="about">
  <div class="container">

    <!-- 1. Titre en tête, sur la largeur -->
    <h2 class="about-title reveal">
      <span class="about-title-line">Nés de la passion,</span>
      <span class="about-title-line about-title-accent">construits ensemble.</span>
    </h2>

    <!-- 2. Photo large (7/12) + texte étroit (5/12) -->
    <div class="about-split">
      <div class="about-photo-wrap reveal">
        <Image
          src={teamPhoto}
          alt="Les licenciés et coachs du club SLAMM réunis sur le tatami à Saint-Lunaire"
          class="about-photo"
          widths={[660, 990, 1320]}
          sizes="(max-width: 900px) 100vw, 660px"
        />
      </div>

      <div class="about-text reveal reveal-delay-1">
        <p class="about-body">
          Association loi 1901 fondée par trois passionnés locaux. Ici, la technique
          prime sur l'ego et chaque progression nourrit le collectif.
        </p>
        <p class="about-body">
          Au cœur de la Côte d'Émeraude, nous cultivons une discipline exigeante
          dans un environnement bienveillant. Ouvert à partir de 16 ans, du débutant
          au compétiteur confirmé, chacun trouve sa place.
        </p>
        <div class="about-tags">
          <span class="tag">Fédération française FMMAF</span>
          <span class="tag">Tous niveaux</span>
        </div>
      </div>
    </div>

    <!-- 3. Valeurs : trois colonnes de texte sous un filet, sans cartes -->
    <ul class="about-values reveal">
      {values.map(v => (
        <li class="value">
          <h3>{v.title}</h3>
          <p>{v.text}</p>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .about {
    padding: 112px 0;
    position: relative;
  }

  .about::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
  }

  .about-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 56px;
    text-wrap: initial;
  }

  .about-title-line { display: block; }
  .about-title-accent { color: var(--g400); }

  /* Photo large à gauche, texte étroit à droite (asymétrie 7/5) */
  .about-split {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 56px;
    align-items: center;
    margin-bottom: 96px;
  }

  .about-photo-wrap {
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .about-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 830 / 459;
    object-fit: cover;
    /* Photo 4:3 avec beaucoup de mur en haut : on cadre sur le groupe */
    object-position: 50% 70%;
  }

  .about-body {
    font-size: 16px;
    color: var(--text-3);
    line-height: 1.75;
    max-width: 60ch;
  }

  .about-body + .about-body { margin-top: 18px; }

  .about-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .tag {
    font-size: 12px;
    font-weight: 500;
    color: var(--g400);
    background: rgba(34,197,94,0.08);
    border: 1px solid rgba(34,197,94,0.15);
    padding: 5px 12px;
    border-radius: 100px;
    letter-spacing: 0.02em;
  }

  .about-values {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px;
  }

  .value {
    padding-top: 24px;
    border-top: 1px solid var(--border-strong);
  }

  .value h3 {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 10px;
    letter-spacing: -0.02em;
  }

  .value p {
    font-size: 15px;
    color: var(--text-3);
    line-height: 1.7;
    max-width: 42ch;
  }

  @media (max-width: 900px) {
    .about { padding: 80px 0; }
    .about-title { margin-bottom: 32px; }
    .about-split { grid-template-columns: minmax(0, 1fr); gap: 32px; margin-bottom: 64px; }
    /* Photo de bord à bord, comme dans le hero */
    .about-photo-wrap { margin-inline: -24px; border-radius: 0; }
    .about-values { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .value { padding: 24px 0; border-top-color: var(--border); }
    .value:first-child { border-top-color: var(--border-strong); }
  }

  @media (max-width: 768px) {
    .about-photo-wrap { margin-inline: -16px; }
  }
</style>
