---
import { ASSOCONNECT_URLS } from '../config/urls.js';

interface Props {
  /** Titre (par défaut « Prêt à essayer ? »), avec une partie en vert optionnelle */
  title?: string;
  accent?: string;
  desc?: string;
  /** 'h2' quand le titre porte du sens pour le SEO (pages locales) */
  as?: 'p' | 'h2';
}
const {
  title = 'Prêt à essayer ?',
  accent,
  desc = "2 cours d'essai pour te lancer, gratuits en début de saison et sans engagement.",
  as: Tag = 'p',
} = Astro.props;
---

<!-- Bande d'appel final (accueil, disciplines…) : les deux actions de conversion -->
<div class="essentials-cta reveal">
  <div class="cta-body">
    <Tag class="cta-title">{title}{accent && <>{' '}<br/><span>{accent}</span></>}</Tag>
    <p class="cta-desc">{desc}</p>
  </div>
  <div class="cta-actions">
    <a href={ASSOCONNECT_URLS.TRIAL_BOOKING} target="_blank" rel="noopener noreferrer" class="cta-btn">
      Réserver un cours d'essai<span class="sr-only"> (nouvel onglet, AssoConnect)</span>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
    <!-- L'adhésion reste accessible, un cran sous l'essai (action principale) -->
    <p class="join-link">
      Déjà décidé ?{' '}
      <a href={ASSOCONNECT_URLS.ANNUAL_MEMBERSHIP} target="_blank" rel="noopener noreferrer">S'inscrire au club<span class="sr-only"> (nouvel onglet, AssoConnect)</span></a>
    </p>
  </div>
</div>

<style>
  /* Bande d'accent : le seul bloc coloré de la page, point d'arrivée de la conversion */
  .essentials-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    background: var(--g950);
    border-radius: var(--r-xl);
    padding: 56px;
  }

  .cta-title {
    font-family: var(--font-display);
    font-size: clamp(30px, 3.4vw, 40px);
    font-weight: 800;
    line-height: 1.05;
    color: var(--text);
    letter-spacing: -0.03em;
    margin-bottom: 12px;
  }

  .cta-title span { color: var(--g400); }

  .cta-desc {
    font-size: 16px;
    color: var(--text-2);
    max-width: 44ch;
  }

  /* Bouton d'essai, puis l'adhésion en lien discret dessous */
  .cta-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--bg);
    background: var(--g500);
    padding: 14px 26px;
    border-radius: 100px;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease, transform 160ms var(--ease-out);
  }

  .cta-btn:active {
    transform: scale(0.97);
  }

  .cta-btn svg { flex-shrink: 0; }

  /* Adhésion : lien texte discret, jamais au même rang que l'essai */
  .join-link {
    font-size: 14px;
    color: var(--text-muted);
  }

  .join-link a {
    display: inline-block;
    padding: 12px 0;
    margin: -12px 0; /* zone de tap de 44px sans décaler la ligne */
    color: var(--text);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: rgba(74,222,128,0.5);
    text-underline-offset: 4px;
    -webkit-tap-highlight-color: transparent;
    transition: color 200ms ease, text-decoration-color 200ms ease;
  }

  /* Survols réservés aux pointeurs fins : pas d'état collé après un tap */
  @media (hover: hover) and (pointer: fine) {
    .cta-btn:hover { background: var(--g400); }
    .join-link a:hover { color: var(--g400); text-decoration-color: currentColor; }
  }

  @media (max-width: 960px) {
    .essentials-cta { flex-direction: column; align-items: flex-start; padding: 44px 40px; }
  }

  @media (max-width: 600px) {
    .essentials-cta { padding: 36px 20px; }
    .cta-actions { align-items: stretch; width: 100%; }
    .cta-btn { justify-content: center; }
    .join-link { text-align: center; }
  }
</style>
