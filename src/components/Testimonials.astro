---
const testimonials = [
  {
    quote: "La pratique du MMA m'a apporté discipline, confiance en moi et une condition physique optimale. C'est bien plus qu'un sport, c'est un mode de vie qui m'a renforcé mentalement et physiquement.",
    name: 'Miguel',
    initials: 'M',
  },
  {
    quote: "Je pratique le MMA depuis septembre 2024 et ça m'a appris beaucoup de choses sur moi que j'ignorais : le dépassement de soi, la condition physique et le mental. Je me sens bien mieux depuis que j'ai découvert cette pratique qui, depuis mon inscription, m'anime jour et nuit.",
    excerpt: "Je pratique le MMA depuis septembre 2024 et ça m'a appris beaucoup de choses sur moi que j'ignorais : le dépassement de soi, la condition physique et le mental.",
    name: 'Florian',
    initials: 'F',
  },
  {
    quote: "Ce que j'apprécie particulièrement dans ce club, c'est l'équilibre entre exigence et bienveillance. Les entraînements sont structurés, techniques et progressifs, ce qui permet d'évoluer rapidement tout en restant en sécurité. En tant que femme, je me suis immédiatement sentie respectée et pleinement intégrée. L'ambiance est motivante, chacun pousse l'autre à se dépasser, et on sent une vraie cohésion d'équipe. Ici, on ne vient pas seulement s'entraîner, on vient progresser.",
    excerpt: "Ce que j'apprécie particulièrement dans ce club, c'est l'équilibre entre exigence et bienveillance. […] En tant que femme, je me suis immédiatement sentie respectée et pleinement intégrée.",
    name: 'Maëva',
    initials: 'Mv',
  },
];

// Maëva en citation principale, les deux autres en secondaire
const [featured, ...others] = [testimonials[2], testimonials[0], testimonials[1]];
---

<section class="testimonials" id="temoignages">
  <div class="container">
    <div class="section-header reveal">
      <h2 class="section-title">
        Ils en parlent<br/>
        <span>mieux que nous.</span>
      </h2>
    </div>

    <div class="testimonials-grid">
      {[featured, ...others].map((t, i) => (
        <blockquote class:list={['testi', { 'testi-featured': i === 0 }, 'reveal', `reveal-delay-${i + 1}`]}>
          <div class="stars" role="img" aria-label="5 étoiles sur 5">
            {Array.from({length: 5}).map(() => (
              <svg width={i === 0 ? 18 : 14} height={i === 0 ? 18 : 14} viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M8 1l1.8 5.6H15l-4.6 3.3 1.8 5.6L8 12.2l-4.2 3.3 1.8-5.6L1 6.6h5.2z"/>
              </svg>
            ))}
          </div>
          {t.excerpt ? (
            <>
              <p class="quote-text quote-excerpt">{t.excerpt}</p>
              <details class="quote-more">
                <summary><span class="more-label">Lire l'avis complet</span><span class="less-label">Réduire</span></summary>
                <p class="quote-text">{t.quote}</p>
              </details>
            </>
          ) : (
            <p class="quote-text">{t.quote}</p>
          )}
          <footer class="quote-author">
            <div class="author-avatar" aria-hidden="true">{t.initials}</div>
            <cite class="author-name">{t.name}</cite>
          </footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials {
    padding: 112px 0;
    position: relative;
  }

  .testimonials::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
  }

  .section-header {
    margin-bottom: 56px;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .section-title span { color: var(--g400); }

  /* Citation principale (gauche, 2 rangées) + deux secondaires (droite) */
  .testimonials-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-rows: auto auto;
    gap: 20px;
  }

  .testi {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 32px;
    background: var(--bg1);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
  }

  .testi-featured {
    grid-row: span 2;
    padding: 48px;
    justify-content: space-between;
    background:
      radial-gradient(ellipse 80% 60% at 0% 0%, rgba(34,197,94,0.10), transparent 70%),
      var(--bg1);
    border-color: var(--border-strong);
  }

  .stars {
    display: flex;
    gap: 4px;
    color: var(--g500);
  }

  .quote-text {
    font-size: 15px;
    color: var(--text-3);
    line-height: 1.75;
  }

  .testi-featured .quote-excerpt {
    font-size: clamp(20px, 2.1vw, 26px);
    line-height: 1.5;
    color: var(--text);
    letter-spacing: -0.01em;
    max-width: 30em;
  }

  /* Centre verticalement la citation principale entre étoiles et auteur */
  .testi-featured .stars + .quote-text { margin-top: auto; }

  /* Avis complet : remplace l'extrait une fois ouvert */
  .testi:has(.quote-more[open]) .quote-excerpt { display: none; }

  .quote-more summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    color: var(--g400);
    border-radius: 4px;
  }
  .quote-more summary::-webkit-details-marker { display: none; }
  .quote-more .less-label { display: none; }
  .quote-more[open] .more-label { display: none; }
  .quote-more[open] .less-label { display: inline; }
  /* Ouvert : le texte complet d'abord, le lien « Réduire » dessous */
  .quote-more[open] { display: flex; flex-direction: column-reverse; align-items: flex-start; gap: 12px; }

  .testi-featured .quote-more .quote-text {
    font-size: 17px;
    color: var(--text-2);
  }

  .quote-author {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }

  .author-avatar {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, var(--g700), var(--g900));
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 800;
    color: var(--g400);
    letter-spacing: -0.03em;
    flex-shrink: 0;
    border: 1px solid rgba(34,197,94,0.2);
  }

  .author-name {
    font-family: var(--font-display);
    font-style: normal;
    font-size: 17px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  @media (max-width: 900px) {
    .testimonials { padding: 80px 0; }
    .testimonials-grid { grid-template-columns: minmax(0, 1fr); }
    .testi-featured { grid-row: auto; padding: 32px 24px; }
    .testi { padding: 28px 24px; }
  }
</style>
