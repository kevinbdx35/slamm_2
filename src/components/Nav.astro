---
import { ASSOCONNECT_URLS } from '../config/urls.js';

const links = [
  { href: '/disciplines',  label: 'Disciplines' },
  { href: '/equipe',       label: 'Équipe' },
  { href: '/evenements',   label: 'Événements' },
  { href: '/tarifs',       label: 'Tarifs' },
  { href: '/faq',          label: 'FAQ' },
  { href: '/contact',      label: 'Contact' },
];
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const base = href.split('#')[0].replace(/\/$/, '') || '/';
  return pathname === base;
};
---

<header id="nav">
  <div class="container nav-inner">
    <a href="/" class="logo" aria-label="Saint-Lunaire MMA">
      <span class="logo-mark">SL</span>
      <span class="logo-text">Saint-Lunaire<br/><em>MMA</em></span>
    </a>

    <nav class="nav-links" aria-label="Navigation principale">
      {links.map(l => (
        <a href={l.href} class={`nav-link${isActive(l.href) ? ' active' : ''}`} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <a href={ASSOCONNECT_URLS.TRIAL_BOOKING} target="_blank" rel="noopener noreferrer" class="nav-cta">Cours d'essai</a>

    <button class="burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-menu" id="burger">
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  {links.map((l, i) => (
    <a href={l.href} class:list={['mobile-link', { active: isActive(l.href) }]} style={`--i: ${i}`} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
  ))}
  <a href={ASSOCONNECT_URLS.TRIAL_BOOKING} target="_blank" rel="noopener noreferrer" class="mobile-cta" style={`--i: ${links.length}`}>Réserver un cours d'essai</a>
</div>

<style>
  /* Hauteur fixe : seul le fond apparaît au scroll (opacité, pas de padding animé) */
  #nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 14px 0;
    isolation: isolate;
  }

  #nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(8,15,10,0.85);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--border);
    opacity: 0;
    transition: opacity 200ms ease;
  }

  #nav.scrolled::before {
    opacity: 1;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .logo-mark {
    width: 40px;
    height: 40px;
    background: var(--g700);
    color: white;
    border-radius: var(--r-sm);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 15px;
    letter-spacing: -0.5px;
    flex-shrink: 0;
  }

  .logo-text {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--text-2);
    letter-spacing: 0.02em;
  }

  .logo-text em {
    font-style: normal;
    color: var(--g400);
    font-weight: 600;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
  }

  .nav-link {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-3);
    padding: 6px 14px;
    border-radius: 100px;
    transition: color 0.2s, background 0.2s;
    letter-spacing: 0.01em;
  }

  .nav-link:hover {
    color: var(--text);
    background: var(--surface);
  }

  .nav-link.active {
    color: var(--g400);
    background: var(--surface);
  }

  .nav-cta {
    flex-shrink: 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--bg);
    background: var(--g500);
    padding: 8px 18px;
    border-radius: 100px;
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease, transform 160ms var(--ease-out);
    letter-spacing: 0.02em;
  }

  .nav-cta:active {
    transform: scale(0.97);
  }

  .nav-cta:hover {
    background: var(--g400);
  }

  .burger {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    width: 44px;
    height: 44px;
    margin-left: auto;
  }

  .burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition: transform 200ms var(--ease-out);
  }

  .burger.open span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .burger.open span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .mobile-menu {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 90;
    background: var(--bg1);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    /* Fermeture rapide (150ms), ouverture un peu plus posée */
    transition: opacity 150ms ease, visibility 0s linear 150ms;
  }

  .mobile-menu.open {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
    transition: opacity 200ms var(--ease-out), visibility 0s;
  }

  /* Liens : montée de 8px en cascade (40ms) à l'ouverture, sortie groupée */
  .mobile-link,
  .mobile-cta {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 120ms ease, transform 120ms ease, color 200ms ease, background-color 200ms ease;
  }

  .mobile-menu.open .mobile-link,
  .mobile-menu.open .mobile-cta {
    opacity: 1;
    transform: none;
    transition:
      opacity 250ms var(--ease-out) calc(var(--i, 0) * 40ms + 60ms),
      transform 250ms var(--ease-out) calc(var(--i, 0) * 40ms + 60ms),
      color 200ms ease,
      background-color 200ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-link, .mobile-cta { transform: none; }
  }

  .mobile-link {
    font-family: var(--font-display);
    font-size: clamp(28px, 8vw, 44px);
    font-weight: 800;
    color: var(--text-3);
  }

  .mobile-link:hover,
  .mobile-link.active { color: var(--g400); }

  .mobile-cta {
    margin-top: 16px;
    font-size: 15px;
    font-weight: 600;
    color: var(--bg);
    background: var(--g500);
    padding: 12px 28px;
    border-radius: 100px;
  }

  .mobile-menu.open .mobile-cta:active {
    transform: scale(0.97);
    transition: transform 120ms var(--ease-out);
  }

  @media (max-width: 1100px) {
    .nav-links, .nav-cta { display: none; }
    .burger { display: flex; }
    .mobile-menu { display: flex; }
  }
</style>

<script>
  const nav    = document.getElementById('nav')!;
  const burger = document.getElementById('burger')!;
  const menu   = document.getElementById('mobile-menu')!;

  // Fond de la nav dès 40px de scroll : sentinelle observée (pas d'écouteur scroll)
  const sentinel = document.createElement('div');
  sentinel.setAttribute('aria-hidden', 'true');
  sentinel.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:40px;pointer-events:none;visibility:hidden';
  document.body.prepend(sentinel);
  new IntersectionObserver(([entry]) => {
    nav.classList.toggle('scrolled', !entry.isIntersecting);
  }).observe(sentinel);

  const setMenu = (open: boolean) => {
    burger.classList.toggle('open', open);
    menu.classList.toggle('open', open);
    menu.setAttribute('aria-hidden', String(!open));
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) {
      menu.querySelector('a')?.focus();
    } else {
      burger.focus();
    }
  };

  burger.addEventListener('click', () => setMenu(!burger.classList.contains('open')));

  menu.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => setMenu(false));
  });

  // Fermeture au clavier (Échap) + piège de focus dans l'overlay
  document.addEventListener('keydown', (e) => {
    if (!menu.classList.contains('open')) return;
    if (e.key === 'Escape') {
      setMenu(false);
      return;
    }
    if (e.key === 'Tab') {
      const items = menu.querySelectorAll<HTMLElement>('a');
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>
