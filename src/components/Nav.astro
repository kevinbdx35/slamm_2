---
import { ASSOCONNECT_URLS, SOCIAL_URLS } from '../config/urls.js';

const links = [
  { href: '/disciplines',  label: 'Disciplines' },
  { href: '/equipe',       label: 'Équipe' },
  { href: '/evenements',   label: 'Événements' },
  { href: '/tarifs',       label: 'Tarifs' },
  { href: '/faq',          label: 'FAQ' },
  { href: '/contact',      label: 'Contact' },
];
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const base = href.split('#')[0].replace(/\/$/, '') || '/';
  return pathname === base;
};
---

<header id="nav">
  <div class="container nav-inner">
    <a href="/" class="logo" aria-label="SLAMM, Saint-Lunaire MMA, accueil">
      <span class="logo-mark">SL</span>
      <span class="logo-text">SLAMM<small>Saint-Lunaire MMA</small></span>
    </a>

    <nav class="nav-links" aria-label="Navigation principale">
      {links.map(l => (
        <a href={l.href} class={`nav-link${isActive(l.href) ? ' active' : ''}`} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="nav-actions">
      <a href={ASSOCONNECT_URLS.ANNUAL_MEMBERSHIP} target="_blank" rel="noopener noreferrer" class="nav-join">S'inscrire</a>
      <a href={ASSOCONNECT_URLS.TRIAL_BOOKING} target="_blank" rel="noopener noreferrer" class="nav-cta">Cours d'essai</a>
    </div>

    <button class="burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-menu" id="burger">
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <nav class="mobile-links" aria-label="Navigation mobile">
    {links.map((l, i) => (
      <a href={l.href} class:list={['mobile-link', { active: isActive(l.href) }]} style={`--i: ${i}`} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>
  <!-- Zone du pouce : les deux actions de conversion, puis Instagram -->
  <div class="mobile-actions">
    <a href={ASSOCONNECT_URLS.TRIAL_BOOKING} target="_blank" rel="noopener noreferrer" class="mobile-cta" style={`--i: ${links.length}`}>Réserver un cours d'essai</a>
    <a href={ASSOCONNECT_URLS.ANNUAL_MEMBERSHIP} target="_blank" rel="noopener noreferrer" class="mobile-cta mobile-cta--ghost" style={`--i: ${links.length + 1}`}>S'inscrire au club</a>
    <a href={SOCIAL_URLS.INSTAGRAM} target="_blank" rel="noopener noreferrer" class="mobile-social" style={`--i: ${links.length + 2}`} aria-label="Instagram @slamm35800">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.5"/>
        <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.5"/>
        <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
      </svg>
      @slamm35800
    </a>
  </div>
</div>

<style>
  /* Hauteur fixe : seul le fond apparaît au scroll (opacité, pas de padding animé) */
  #nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 14px 0;
    isolation: isolate;
  }

  #nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(8,15,10,0.85);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--border);
    opacity: 0;
    transition: opacity 200ms ease;
  }

  #nav.scrolled::before {
    opacity: 1;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .logo-mark {
    width: 40px;
    height: 40px;
    background: var(--g700);
    color: white;
    border-radius: var(--r-sm);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 15px;
    letter-spacing: -0.5px;
    flex-shrink: 0;
  }

  /* Acronyme du club (police des titres), nom complet en sous-titre */
  .logo-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 800;
    line-height: 1;
    color: var(--text);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .logo-text small {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--g400);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
  }

  .nav-link {
    position: relative;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-3);
    padding: 6px 14px;
    border-radius: 100px;
    transition: color 200ms ease, transform 160ms var(--ease-out);
    letter-spacing: 0.01em;
  }

  /* Un seul langage : le trait sous le libellé. Plein sur la page courante,
     il se dessine depuis la gauche au survol (transform seul, 200ms ease-out) */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: -3px;
    height: 2px;
    border-radius: 2px;
    background: var(--g400);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms var(--ease-out);
  }

  .nav-link.active {
    color: var(--text);
  }
  .nav-link.active::after {
    transform: scaleX(1);
  }

  .nav-link:active {
    transform: scale(0.97);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  /* Action secondaire : contour fin, un cran sous le bouton plein */
  .nav-join {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-2);
    padding: 7px 16px;
    border: 1px solid var(--border-strong);
    border-radius: 100px;
    letter-spacing: 0.02em;
    transition: color 200ms ease, border-color 200ms ease, transform 160ms var(--ease-out);
  }

  .nav-join:active {
    transform: scale(0.97);
  }

  .nav-cta {
    flex-shrink: 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--bg);
    background: var(--g500);
    padding: 8px 18px;
    border-radius: 100px;
    transition: background-color 200ms ease, transform 160ms var(--ease-out);
    letter-spacing: 0.02em;
  }

  .nav-cta:active {
    transform: scale(0.97);
  }

  /* Survols réservés aux pointeurs fins : pas d'état collé après un tap (iPad paysage) */
  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover { color: var(--text); }
    .nav-link:hover::after { transform: scaleX(1); }
    .nav-join:hover {
      color: var(--text);
      border-color: rgba(74,222,128,0.5);
    }
    .nav-cta:hover { background: var(--g400); }
    .mobile-link:hover { color: var(--g400); }
  }

  /* Le press state remplace le flash gris du tap (iOS/Android) */
  .logo, .nav-link, .nav-join, .nav-cta, .burger, .mobile-link, .mobile-cta, .mobile-social {
    -webkit-tap-highlight-color: transparent;
  }

  .burger {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    width: 44px;
    height: 44px;
    margin-left: auto;
    transition: transform 160ms var(--ease-out);
  }

  .burger:active {
    transform: scale(0.97);
  }

  .burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition: transform 200ms var(--ease-out);
  }

  .burger.open span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .burger.open span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .mobile-menu {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 90;
    background: var(--bg1);
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    /* Sous la barre de nav (68px) ; bas calé sur la zone de sécurité */
    padding: 92px 16px calc(24px + env(safe-area-inset-bottom));
    overflow-y: auto;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    /* Fermeture rapide (150ms), ouverture un peu plus posée (200ms) */
    transition: opacity 150ms var(--ease-out), visibility 0s linear 150ms;
  }

  .mobile-menu.open {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
    transition: opacity 200ms var(--ease-out), visibility 0s;
  }

  /* Liens, boutons et Instagram : montée de 8px en cascade (30ms) à l'ouverture, sortie groupée */
  .mobile-link,
  .mobile-cta,
  .mobile-social {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 120ms ease, transform 120ms ease, color 200ms ease, background-color 200ms ease;
  }

  .mobile-menu.open .mobile-link,
  .mobile-menu.open .mobile-cta,
  .mobile-menu.open .mobile-social {
    opacity: 1;
    transform: none;
    transition:
      opacity 250ms var(--ease-out) calc(var(--i, 0) * 30ms + 40ms),
      transform 250ms var(--ease-out) calc(var(--i, 0) * 30ms + 40ms),
      color 200ms ease,
      background-color 200ms ease;
  }

  /* Pression : 2 % suffisent sur un texte de 32px */
  .mobile-menu.open .mobile-link:active {
    transform: scale(0.98);
    transition: transform 160ms var(--ease-out), color 200ms ease;
  }

  /* Mouvement réduit : pas de déplacement ni de rotation, on garde les fondus */
  @media (prefers-reduced-motion: reduce) {
    .mobile-link, .mobile-cta, .mobile-social { transform: none; }
    .burger span { transition: none; }
    .nav-link::after { transition: none; }
  }

  .mobile-links {
    display: flex;
    flex-direction: column;
  }

  /* Liste alignée à gauche, un filet entre les entrées */
  .mobile-link {
    font-family: var(--font-display);
    font-size: clamp(24px, 7vw, 32px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text-2);
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
  }

  .mobile-link.active { color: var(--g400); }

  .mobile-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .mobile-cta {
    display: block;
    text-align: center;
    font-size: 15px;
    font-weight: 600;
    color: var(--bg);
    background: var(--g500);
    padding: 14px 28px;
    border-radius: 100px;
  }

  .mobile-cta--ghost {
    color: var(--text);
    background: transparent;
    border: 1px solid var(--border-strong);
  }

  .mobile-social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 6px;
    padding: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .mobile-menu.open .mobile-cta:active {
    transform: scale(0.97);
    transition: transform 160ms var(--ease-out);
  }

  @media (max-width: 1100px) {
    .nav-links, .nav-actions { display: none; }
    .burger { display: flex; }
    .mobile-menu { display: flex; }
  }
</style>

<script>
  const nav    = document.getElementById('nav')!;
  const burger = document.getElementById('burger')!;
  const menu   = document.getElementById('mobile-menu')!;

  // Fond de la nav dès 40px de scroll : sentinelle observée (pas d'écouteur scroll)
  const sentinel = document.createElement('div');
  sentinel.setAttribute('aria-hidden', 'true');
  sentinel.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:40px;pointer-events:none;visibility:hidden';
  document.body.prepend(sentinel);
  new IntersectionObserver(([entry]) => {
    nav.classList.toggle('scrolled', !entry.isIntersecting);
  }).observe(sentinel);

  const setMenu = (open: boolean) => {
    burger.classList.toggle('open', open);
    menu.classList.toggle('open', open);
    menu.setAttribute('aria-hidden', String(!open));
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) {
      menu.querySelector('a')?.focus();
    } else {
      burger.focus();
    }
  };

  burger.addEventListener('click', () => setMenu(!burger.classList.contains('open')));

  menu.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => setMenu(false));
  });

  // Fermeture au clavier (Échap) + piège de focus dans l'overlay
  document.addEventListener('keydown', (e) => {
    if (!menu.classList.contains('open')) return;
    if (e.key === 'Escape') {
      setMenu(false);
      return;
    }
    if (e.key === 'Tab') {
      const items = menu.querySelectorAll<HTMLElement>('a');
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>
