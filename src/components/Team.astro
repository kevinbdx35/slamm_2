---
import { Image } from 'astro:assets';
import teamPhoto from '../assets/img/team/team.webp';

const coaches = [
  {
    name: 'Thomas',
    role: 'Coach MMA & Pieds/Poings',
    fonction: 'Trésorier',
    bio: 'Pratiquant de Muaythai et ancien compétiteur semi-pro. Spécialiste du striking et du combat debout.',
    bioFull: [
      "Pratiquant de Muaythai depuis de nombreuses années et ancien compétiteur semi-pro, il co-fonde en 2023 SLAMM, premier véritable club de MMA de la Côte d'Émeraude et premier club de Bretagne à proposer officiellement de la luta livre. Coach de MMA, il y encadre plus spécifiquement les phases de striking et de combat debout.",
    ],
    grades: [
      'Grade vert MMA (FMMAF)',
    ],
    diplomes: [
      'Brevet Fédéral BF2 MMA',
      'Brevet Fédéral BF1 MMA',
      'PSC1',
    ],
    disciplines: ['MMA', 'Muay Thaï'],
    initials: 'T',
    photo: null,
  },
  {
    name: 'Kévin',
    role: 'Coach MMA & Luta Livre',
    fonction: 'Secrétaire',
    bio: 'Passionné de grappling et de MMA. Pédagogie bienveillante et technique millimétrée, du débutant au compétiteur.',
    bioFull: [
      "Pratiquant de Jiu-Jitsu Brésilien depuis 2009, il fonde dès 2010 le premier club de JJB de Saint-Malo, qu'il préside jusqu'en 2015 et où il organise plusieurs stages. Il est le premier à faire venir Caio Terra et Samir Chantre en France, et les réinvite à plusieurs reprises.",
      "Après huit ans de pause, il renoue avec les sports de combat en 2023 et co-fonde la même année SLAMM, premier véritable club de MMA de la Côte d'Émeraude et premier club de Bretagne à proposer officiellement de la luta livre. Coach de MMA, il y encadre plus spécifiquement les phases de lutte et de combat au sol, et impulse le développement du club, qui lance son propre cycle de stages dès la saison 2025-2026.",
    ],
    grades: [
      'Grade vert MMA (FMMAF)',
      'Ceinture bleue luta livre',
      'Ceinture bleue JJB (4 stripes)',
      'Grade bleu grappling & grappling fight (FFL)',
    ],
    diplomes: [
      'Brevet Fédéral BF2 MMA',
      'Brevet Fédéral BF1 MMA',
      'Brevet Fédéral BF1 grappling (FFL)',
      'PSC1',
    ],
    disciplines: ['MMA', 'Luta Livre', 'Grappling', 'JJB'],
    initials: 'K',
    photo: null,
  },
  {
    name: 'Malik',
    role: 'Coach MMA',
    fonction: 'Président',
    bio: 'Biographie à venir…',
    grades: [
      'Grade vert MMA (FMMAF)',
    ],
    diplomes: [
      'Brevet Fédéral BF2 MMA',
      'Brevet Fédéral BF1 MMA',
      'PSC1',
    ],
    disciplines: ['MMA'],
    initials: 'M',
    photo: null,
  },
  {
    name: 'Miguel',
    role: 'Coach MMA',
    fonction: 'Vice-Président',
    bio: 'Biographie à venir…',
    grades: [
      'Grade vert MMA (FMMAF)',
    ],
    diplomes: [
      'Brevet Fédéral BF2 MMA',
      'Brevet Fédéral BF1 MMA',
      'PSE1',
      'PSE2',
    ],
    disciplines: ['MMA'],
    initials: 'Mi',
    photo: null,
  },
];
---

<section class="team" id="equipe">
  <div class="container">
    <div class="section-header reveal">
      <p class="section-label">L'équipe</p>
      <h2 class="section-title">
        Tes coachs,<br/>
        <span>tes guides.</span>
      </h2>
      <p class="section-sub">
        Une équipe de bénévoles diplômés FMMAF, passionnés par la transmission et le développement du MMA sur la Côte d'Émeraude.
      </p>
    </div>

    <div class="team-photo-wrap reveal">
      <Image src={teamPhoto} alt="L'équipe SLAMM" class="team-photo" />
      <div class="team-photo-overlay">
        <span>Saint-Lunaire Arts Martiaux Mixtes</span>
      </div>
    </div>

    <div class="carousel-wrap reveal">
      <div class="carousel">
        <div class="carousel-track" id="team-carousel">
        {coaches.map((coach) => {
          const paragraphs = coach.bioFull ?? [coach.bio];
          return (
            <div class="carousel-slide">
              <div class="coach-profile">
                <div class="profile-avatar">
                  <span>{coach.initials}</span>
                </div>
                <div class="profile-body">
                  <div class="profile-head">
                    <div>
                      <h3 class="profile-name">{coach.name}</h3>
                      <p class="profile-role">{coach.role}</p>
                    </div>
                    {coach.fonction && <span class="profile-fonction">{coach.fonction}</span>}
                  </div>
                  <div class="profile-bio">
                    {paragraphs.map(p => <p>{p}</p>)}
                  </div>
                  {(coach.grades?.length > 0 || coach.diplomes?.length > 0) && (
                    <div class="profile-columns">
                      {coach.grades && coach.grades.length > 0 && (
                        <div class="profile-col">
                          <p class="profile-col-title">Grades & Ceintures</p>
                          <ul>
                            {coach.grades.map(g => <li>{g}</li>)}
                          </ul>
                        </div>
                      )}
                      {coach.diplomes && coach.diplomes.length > 0 && (
                        <div class="profile-col">
                          <p class="profile-col-title">Diplômes Fédéraux</p>
                          <ul>
                            {coach.diplomes.map(d => <li>{d}</li>)}
                          </ul>
                        </div>
                      )}
                    </div>
                  )}
                  <div class="profile-tags">
                    {coach.disciplines.map(d => <span class="coach-tag">{d}</span>)}
                  </div>
                </div>
              </div>
            </div>
          );
        })}
        </div>
      </div>

      <div class="carousel-controls">
        <button class="carousel-btn" id="carousel-prev" aria-label="Coach précédent">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M12 4l-6 6 6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="carousel-dots" id="carousel-dots">
          {coaches.map((c, i) => (
            <button class={`carousel-dot${i === 0 ? ' active' : ''}`} data-index={i} aria-label={`Voir ${c.name}`}></button>
          ))}
        </div>
        <button class="carousel-btn" id="carousel-next" aria-label="Coach suivant">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M8 4l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .team {
    padding: 120px 0;
    position: relative;
  }

  .team::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
  }

  .section-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: end;
    margin-bottom: 48px;
  }

  .section-label {
    grid-column: 1 / -1;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--g500);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .section-title span { color: var(--g400); }

  .section-sub {
    font-size: 16px;
    color: var(--text-3);
    line-height: 1.7;
    font-weight: 400;
    align-self: end;
  }

  /* Team photo */
  .team-photo-wrap {
    position: relative;
    border-radius: var(--r-xl);
    overflow: hidden;
    margin-bottom: 48px;
    border: 1px solid var(--border);
  }

  .team-photo {
    width: 100%;
    height: 400px;
    object-fit: cover;
    display: block;
  }

  .team-photo-overlay {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 24px 32px;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 100%);
  }

  .team-photo-overlay span {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
  }

  /* Carousel */
  .carousel-wrap {
    position: relative;
  }

  .carousel {
    overflow: hidden;
  }

  .carousel-track {
    display: flex;
    transition: transform 0.5s var(--ease-out);
  }

  .carousel-slide {
    min-width: 100%;
  }

  /* Coach profile card */
  .coach-profile {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 48px;
    padding: 48px;
    background: var(--bg1);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    position: relative;
    overflow: hidden;
  }

  .coach-profile::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--g600), var(--g400));
  }

  .profile-avatar {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding-top: 8px;
  }

  .profile-avatar span {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 2px solid var(--border-strong);
    background: linear-gradient(135deg, var(--g700), var(--g900));
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 800;
    color: var(--g400);
    letter-spacing: -0.03em;
  }

  .profile-body {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .profile-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .profile-name {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .profile-role {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--g500);
    margin-top: 6px;
  }

  .profile-fonction {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--g400);
    background: rgba(74,222,128,0.08);
    border: 1px solid rgba(74,222,128,0.2);
    padding: 4px 10px;
    border-radius: 4px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .profile-bio {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }

  .profile-bio p {
    font-size: 15px;
    color: var(--text-2);
    line-height: 1.8;
  }

  .profile-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .profile-col-title {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 12px;
  }

  .profile-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .profile-col li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--text-2);
    line-height: 1.5;
  }

  .profile-col li::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--g500);
    flex-shrink: 0;
  }

  .profile-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .coach-tag {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--border);
    padding: 3px 10px;
    border-radius: 100px;
    letter-spacing: 0.03em;
  }

  /* Carousel controls */
  .carousel-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 24px;
  }

  .carousel-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg1);
    color: var(--text-3);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
    flex-shrink: 0;
  }

  .carousel-btn:hover {
    border-color: var(--border-strong);
    color: var(--g400);
    background: var(--bg2);
  }

  .carousel-dots {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .carousel-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: var(--border-strong);
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
    padding: 0;
  }

  .carousel-dot.active {
    background: var(--g400);
    transform: scale(1.3);
  }

  @media (max-width: 900px) {
    .section-header { grid-template-columns: 1fr; }
    .team-photo { height: 280px; }
    .coach-profile { grid-template-columns: 1fr; gap: 32px; padding: 32px; }
    .profile-avatar { flex-direction: row; gap: 20px; align-items: center; }
    .profile-columns { grid-template-columns: 1fr; gap: 24px; }
  }

  @media (max-width: 560px) {
    .team-photo { height: 220px; }
    .coach-profile { padding: 24px; }
    .profile-head { flex-direction: column; }
  }
</style>

<script>
  const carousel = document.getElementById('team-carousel')!;
  const dots = document.querySelectorAll<HTMLButtonElement>('.carousel-dot');
  const total = dots.length;
  let current = 0;

  function goTo(index: number) {
    current = (index + total) % total;
    carousel.style.transform = `translateX(-${current * 100}%)`;
    dots.forEach((d, i) => d.classList.toggle('active', i === current));
  }

  document.getElementById('carousel-prev')!.addEventListener('click', () => goTo(current - 1));
  document.getElementById('carousel-next')!.addEventListener('click', () => goTo(current + 1));
  dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
</script>
