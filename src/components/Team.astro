---
import { Image } from 'astro:assets';
import teamPhoto from '../assets/img/team/equipe2026.webp';
import TrialCta from './TrialCta.astro';

const coaches = [
  {
    name: 'Thomas',
    role: 'Coach MMA & Pieds/Poings',
    bio: 'Ancien compétiteur de Muay Thaï en classe B. Spécialiste du striking et du combat debout.',
    bioFull: [
      "Il débute le full contact début 2005, puis se tourne vers le Muay Thaï en 2007, discipline qu'il approfondit notamment lors de séjours d'entraînement en Thaïlande.",
      "Ancien compétiteur de Muay Thaï en classe B, il co-fonde en 2023 SLAMM, premier club de la Côte d'Émeraude dédié au MMA comme discipline principale, ainsi que le premier de Bretagne à proposer officiellement de la luta livre. Coach de MMA, il y encadre plus spécifiquement les phases de striking, de clinch et de combat debout.",
    ],
    grades: [
      'Grade vert MMA (FMMAF)',
    ],
    diplomes: [
      'Brevet Fédéral BF2 MMA',
      'Brevet Fédéral BF1 MMA',
      'PSC1',
    ],
    disciplines: ['MMA', 'Muay Thaï'],
    photo: null,
  },
  {
    name: 'Kévin',
    role: 'Coach MMA & Luta Livre',
    bio: 'Passionné de grappling et de MMA. Pédagogie bienveillante et technique millimétrée, du débutant au compétiteur.',
    bioFull: [
      "Il débute le Jiu-Jitsu Brésilien en 2009 et fonde dès 2010 le premier club de JJB de Saint-Malo, qu'il préside jusqu'en 2015 et où il organise plusieurs stages. Il est le premier à faire venir Caio Terra et Samir Chantre en France, et les réinvite à plusieurs reprises.",
      "Après huit ans de pause, il renoue avec les sports de combat en 2023 et co-fonde la même année SLAMM, premier club de la Côte d'Émeraude dédié au MMA comme discipline principale, ainsi que le premier de Bretagne à proposer officiellement de la luta livre. Coach de MMA, il y encadre plus spécifiquement les phases de lutte et de combat au sol, et impulse le développement du club, qui lance son propre cycle de stages dès la saison 2025-2026.",
    ],
    grades: [
      'Grade vert MMA (FMMAF)',
      'Ceinture bleue luta livre',
      'Ceinture bleue JJB (4 stripes)',
      'Grade bleu grappling & grappling fight (FFL)',
    ],
    diplomes: [
      'Brevet Fédéral BF2 MMA',
      'Brevet Fédéral BF1 MMA',
      'Brevet Fédéral BF1 grappling (FFL)',
      'PSC1',
    ],
    disciplines: ['MMA', 'Luta Livre'],
    photo: null,
  },
  {
    name: 'Malik',
    role: 'Coach MMA',
    bio: 'Co-fondateur de SLAMM en 2023. Biographie complète à venir…',
    grades: [
      'Grade vert MMA (FMMAF)',
    ],
    diplomes: [
      'Brevet Fédéral BF2 MMA',
      'Brevet Fédéral BF1 MMA',
      'PSC1',
    ],
    disciplines: ['MMA'],
    photo: null,
  },
  {
    name: 'Miguel',
    role: 'Coach MMA',
    bio: 'Biographie à venir…',
    grades: [
      'Grade vert MMA (FMMAF)',
    ],
    diplomes: [
      'Brevet Fédéral BF2 MMA',
      'Brevet Fédéral BF1 MMA',
      'PSE1',
      'PSE2',
    ],
    disciplines: ['MMA'],
    photo: null,
  },
];
---

<section class="team" id="equipe">
  <div class="container">
    <div class="section-header">
      <h1 class="section-title">
        <span class="title-slot"><span class="title-slot-text">L'équipe</span></span>{' '}
        <span class="title-slot title-accent"><span class="title-slot-text">encadrante.</span></span>
      </h1>
      <p class="section-sub reveal reveal-delay-2">
        Une équipe de bénévoles diplômés FMMAF, passionnés par la transmission et le développement du MMA sur la Côte d'Émeraude.
      </p>
    </div>

    <div class="team-photo-wrap reveal reveal-photo">
      <Image
        src={teamPhoto}
        alt="L'équipe SLAMM réunie sur le tatami"
        class="team-photo"
        loading="eager"
        fetchpriority="low"
      />
    </div>

    <!-- Les 4 coachs visibles : une section par coach, filet entre chaque -->
    <div class="coach-list">
      {coaches.map((coach) => {
        const paragraphs = coach.bioFull ?? [coach.bio];
        return (
          <article class="coach">
            <div class="coach-head reveal">
              <h2 class="coach-name">{coach.name}</h2>
              <p class="coach-role">{coach.role}</p>
              <div class="coach-tags">
                {coach.disciplines.map(d => <span class="coach-tag">{d}</span>)}
              </div>
            </div>
            <div class="coach-body reveal reveal-delay-1">
              <div class="coach-bio">
                {paragraphs.map(p => <p>{p}</p>)}
              </div>
              {(coach.grades?.length > 0 || coach.diplomes?.length > 0) && (
                <div class="coach-columns">
                  {coach.grades && coach.grades.length > 0 && (
                    <div class="coach-col">
                      <h3 class="coach-col-title">Grades et ceintures</h3>
                      <ul>
                        {coach.grades.map(g => <li><svg class="check" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8l3.5 3.5L13 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{g}</li>)}
                      </ul>
                    </div>
                  )}
                  {coach.diplomes && coach.diplomes.length > 0 && (
                    <div class="coach-col">
                      <h3 class="coach-col-title">Diplômes fédéraux</h3>
                      <ul>
                        {coach.diplomes.map(d => <li><svg class="check" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8l3.5 3.5L13 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{d}</li>)}
                      </ul>
                    </div>
                  )}
                </div>
              )}
            </div>
          </article>
        );
      })}
    </div>

    <TrialCta />
  </div>
</section>

<style>
  /* Première section de la page : dégage la nav fixe */
  .team {
    padding: 152px 0 112px;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 720px;
    margin-bottom: 56px;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .section-title .title-accent { color: var(--g400); }

  .section-sub {
    font-size: 17px;
    color: var(--text-3);
    line-height: 1.7;
    max-width: 56ch;
  }

  .team-photo-wrap {
    border-radius: var(--r-lg);
    overflow: hidden;
    margin-bottom: 96px;
  }

  .team-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 830 / 340;
    object-fit: cover;
    object-position: 50% 62%;
  }

  /* Coach : identité (4/12) + contenu (8/12) */
  .coach-list {
    border-top: 1px solid var(--border-strong);
    margin-bottom: 96px;
  }

  .coach {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 48px;
    padding: 48px 0;
    border-bottom: 1px solid var(--border);
  }

  .coach-name {
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .coach-role {
    margin-top: 10px;
    font-size: 15px;
    font-weight: 500;
    color: var(--g400);
  }

  .coach-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .coach-tag {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-2);
    border: 1px solid var(--border-strong);
    padding: 4px 12px;
    border-radius: 100px;
  }

  .coach-bio p {
    font-size: 16px;
    color: var(--text-3);
    line-height: 1.75;
    max-width: 68ch;
  }

  .coach-bio p + p { margin-top: 14px; }

  .coach-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    margin-top: 32px;
  }

  .coach-col-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
    margin-bottom: 12px;
  }

  .coach-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .coach-col li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 15px;
    color: var(--text-3);
    line-height: 1.5;
  }

  .coach-col .check {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--g400);
  }

  @media (max-width: 900px) {
    .team { padding: 128px 0 80px; }
    .team-photo-wrap { margin: 0 -24px 64px; border-radius: 0; }
    .team-photo { aspect-ratio: 830 / 459; object-position: 50% 70%; }
    .coach { grid-template-columns: minmax(0, 1fr); gap: 24px; padding: 40px 0; }
    .coach-list { margin-bottom: 64px; }
  }

  @media (max-width: 768px) {
    .team-photo-wrap { margin-inline: -16px; }
  }

  @media (max-width: 580px) {
    .coach-name { font-size: 32px; }
    .coach-columns { grid-template-columns: minmax(0, 1fr); gap: 24px; }
  }
</style>
