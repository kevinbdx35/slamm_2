---
import { PRICING, SEASON, SEASON_END, FINANCIAL_AID, getActivePeriodIndex } from '../config/schedule.js';
import { ASSOCONNECT_URLS } from '../config/urls.js';

const activeIdx = getActivePeriodIndex();
const isOffSeason = activeIdx === -1;

// Hors-saison : on affiche les tarifs sept→déc (prochaine saison)
const displayIdx = isOffSeason ? 0 : activeIdx;

const periods = PRICING.adult.periods.map((p: any, i: number) => ({
  label: p.fromLabel,
  price: `${p.price} €`,
  current: i === displayIdx,
}));

const activeAdultPrice = PRICING.adult.periods[displayIdx].price;
const activePeriodLabel = PRICING.adult.periods[displayIdx].label;

// Plein tarif = 1er palier ; au-delà, on n'affiche que les mois restants.
const fullPrice = PRICING.adult.periods[0].price;
const isReduced = displayIdx > 0;

// Fin de la période tarifaire en cours (≠ fin de l'adhésion, qui court jusqu'en juin)
const monthMap: Record<string, string> = { 'Déc': 'décembre', 'Mars': 'mars', 'Juin': 'juin' };
const endAbbr = activePeriodLabel.split('→')[1]?.trim() ?? '';
const tarifValidUntil = monthMap[endAbbr] ?? endAbbr;

const seasonEnd = `${SEASON_END.month} ${SEASON_END.year}`;

const features = [
  'Licence fédérale incluse',
  'Assurance comprise',
  'Accès à tous les cours',
];

const steps = [
  {
    num: '1',
    title: 'Observe un cours',
    desc: 'Aucune pression, juste pour découvrir.',
  },
  {
    num: '2',
    title: 'Essaye jusqu\'à 2 séances',
    desc: 'Gratuit pendant le premier mois suivant la reprise. Au-delà : 5 € par séance, déductible de l\'adhésion.',
  },
  {
    num: '3',
    title: 'Inscription',
    desc: 'Bienvenue dans l\'équipe !',
  },
];
---

<section class="pricing" id="tarifs">
  <div class="container">

    <div class="section-header">
      <h1 class="section-title">
        <span class="title-slot"><span class="title-slot-text">Transparent,</span></span>{' '}
        <span class="title-slot title-accent"><span class="title-slot-text">sans surprise.</span></span>
      </h1>
    </div>

    <div class="pricing-grid">

      <!-- Tarif cards -->
      <div class="tarif-col reveal">
        <div class="tarif-cards">
          <div class="tarif-card tarif-card-accent">
            <p class="tarif-age">Adhésion saison {SEASON} <span>+16 ans</span></p>
            <p class="tarif-price">{activeAdultPrice} <em>€</em></p>
            <p class="tarif-season">De la rentrée à fin {seasonEnd}.</p>
            {isReduced && (
              <p class="tarif-note">Tarif réduit : tu ne paies que les mois restants (plein tarif {fullPrice} € en début de saison).</p>
            )}
          </div>
        </div>

        <ul class="features">
          {features.map(f => (
            <li class="feature">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8l3.5 3.5L13 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {f}
            </li>
          ))}
        </ul>

        <p class="cb3x">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <rect x="1" y="3" width="12" height="9" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
            <path d="M1 6h12" stroke="currentColor" stroke-width="1.2"/>
          </svg>
          CB en 3 fois possible
        </p>

        <div class="aides">
          <p class="aides-title">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M7 12.5S1.5 9.3 1.5 5.4A2.9 2.9 0 0 1 7 4a2.9 2.9 0 0 1 5.5 1.4c0 3.9-5.5 7.1-5.5 7.1z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
            </svg>
            {FINANCIAL_AID.short}
          </p>
          <ul class="aides-list">
            {FINANCIAL_AID.schemes.map(s => (
              <li><strong>{s.name}</strong> : {s.detail}</li>
            ))}
          </ul>
          <p class="aides-note">Signale-le nous avant de finaliser ton inscription : le montant est déduit de l'adhésion.</p>
        </div>

        <a href={ASSOCONNECT_URLS.ANNUAL_MEMBERSHIP} target="_blank" rel="noopener noreferrer" class="btn-inscription">
          S'inscrire au club
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2.5 7h9M8 3.5l3.5 3.5L8 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <!-- Période dégressive -->
      <div class="degressif reveal reveal-delay-1">
        <p class="degressif-title">Tu nous rejoins en cours de saison ?</p>
        <p class="degressif-sub">
          Tu ne paies que les mois restants. La fin de l'adhésion, elle, est la même
          pour tout le monde : fin {seasonEnd}.
        </p>

        <div class="periods-legend" aria-hidden="true">
          <span>Tu commences…</span>
          <span>Tu paies</span>
        </div>

        <div class="periods reveal">
          {periods.map((p, i) => (
            <div class={`period${p.current ? ' period-current' : ''}`} style={`--stagger: ${i * 40}ms`}>
              <div class="period-label">
                {p.label}
                {p.current && <span class="period-badge">En cours</span>}
              </div>
              <span class="period-price">{p.price}</span>
            </div>
          ))}
        </div>

        <p class="validity-note">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.2"/>
            <path d="M7 4.5V7l1.5 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
          {isOffSeason ? 'Inscriptions ouvertes pour la prochaine saison, reprise en septembre' : `Tarif en vigueur jusqu'à fin ${tarifValidUntil} · CB en 3 fois possible`}
        </p>
      </div>
    </div>

    <!-- Pack découverte -->
    <div class="discovery reveal">
      <div class="discovery-header">
        <p class="discovery-label">Pack Découverte MMA</p>
        <p class="discovery-sub">Comment ça se passe avant de s'inscrire</p>
      </div>

      <div class="steps reveal rule-cascade">
        {steps.map(s => (
          <div class="step rule-item">
            <div class="step-body">
              <p class="step-title">{s.title}</p>
              <p class="step-desc">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <a href={ASSOCONNECT_URLS.TRIAL_BOOKING} target="_blank" rel="noopener noreferrer" class="btn-essai">
        Réserver un cours d'essai
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2.5 7h9M8 3.5l3.5 3.5L8 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <div class="astuce">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 2a4 4 0 0 1 1.5 7.7V11h-3V9.7A4 4 0 0 1 8 2z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
          <path d="M6.5 13h3M7 15h2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
        <p><strong>Astuce :</strong> Profite de tes séances d'essai pour découvrir les techniques, rencontrer les coachs et t'imprégner de l'ambiance du club.</p>
      </div>
    </div>

  </div>
</section>

<style>
  /* Première section de la page : dégage la nav fixe */
  .pricing {
    padding: 152px 0 112px;
    position: relative;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 64px;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .section-title .title-accent { color: var(--g400); }

  /* ── Grid ── */
  .pricing-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 64px;
    align-items: start;
    margin-bottom: 112px;
  }

  /* ── Tarif cards ── */
  .tarif-col {
    background: var(--bg1);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .tarif-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  /* Bloc prix à plat dans la carte (plus de carte dans la carte) */
  .tarif-card {
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }


  .tarif-age {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-3);
    letter-spacing: 0.02em;
    margin-bottom: 4px;
  }

  .tarif-age span {
    font-weight: 400;
    color: var(--text-muted);
    font-size: 12px;
  }

  /* Prix : police des titres, chiffres tabulaires (comme l'accueil) */
  .tarif-price {
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    margin: 8px 0 6px;
  }

  .tarif-price em {
    font-style: normal;
    font-size: 26px;
    font-weight: 600;
    color: var(--g400);
    letter-spacing: 0;
  }

  .tarif-note {
    font-size: 12px;
    color: var(--text-muted);
  }

  .tarif-season {
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-3);
    font-weight: 600;
    margin-top: 6px;
  }

  /* Features */
  .features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .feature {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--text-3);
  }

  .feature svg { color: var(--g500); flex-shrink: 0; }

  .cb3x {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .cb3x svg { flex-shrink: 0; }

  /* ── Aides financières ── */
  .aides {
    border-top: 1px solid var(--border);
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .aides-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-3);
  }

  .aides-title svg { color: var(--g500); flex-shrink: 0; }

  .aides-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .aides-list strong { color: var(--text-3); font-weight: 600; }

  .aides-note {
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  /* ── Tableau dégressif : à plat, à côté de la carte prix ── */
  .degressif {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 40px;
  }

  .degressif-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .degressif-sub {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-3);
    margin-bottom: 12px;
  }

  .periods-legend {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0 24px;
    align-items: baseline;
    padding: 0 0 10px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .periods-legend span:last-child {
    min-width: 60px;
    text-align: right;
  }

  .periods {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-strong);
  }

  .period {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0 24px;
    align-items: center;
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
  }

  .period-label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
  }

  /* Lignes du tableau en cascade (40ms), puis le badge « En cours » se pose */
  :global(.js) .periods.reveal { opacity: 1; transform: none; transition: none; }
  :global(.js) .period {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 400ms var(--ease-out) var(--stagger, 0ms),
      transform 400ms var(--ease-out) var(--stagger, 0ms);
  }
  :global(.js) .period .period-badge {
    opacity: 0;
    transform: scale(0.9);
    transition:
      opacity 200ms var(--ease-out) calc(var(--stagger, 0ms) + 400ms),
      transform 200ms var(--ease-out) calc(var(--stagger, 0ms) + 400ms);
  }
  :global(.js) .periods.visible .period,
  :global(.js) .periods.visible .period-badge { opacity: 1; transform: none; }

  .period-badge {
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
    color: var(--bg);
    background: var(--g500);
    padding: 3px 8px;
    border-radius: 4px;
  }

  .period-price {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    min-width: 60px;
    text-align: right;
    color: var(--g400);
  }

  .validity-note {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 4px;
  }

  .validity-note svg { flex-shrink: 0; }

  /* ── Pack découverte ── */
  /* ── Pack découverte : à plat ── */
  .discovery {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .discovery-header {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .discovery-label {
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .discovery-sub {
    font-size: 15px;
    color: var(--text-3);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
  }

  /* Filet dessiné en cascade : utilitaires globaux .rule-cascade / .rule-item */
  .step {
    padding-top: 24px;
  }

  .step-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .step-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .step-desc {
    font-size: 14px;
    color: var(--text-3);
    line-height: 1.7;
  }

  .astuce {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: var(--g500);
    max-width: 72ch;
  }

  .btn-inscription {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--bg);
    background: var(--g500);
    padding: 12px 24px;
    border-radius: 100px;
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease, transform 160ms var(--ease-out);
    width: 100%;
    text-align: center;
  }
  .btn-inscription:active {
    transform: scale(0.97);
  }

  .btn-essai {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--bg);
    background: var(--g500);
    padding: 14px 28px;
    border-radius: 100px;
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease, transform 160ms var(--ease-out);
    align-self: flex-start;
  }
  .btn-essai:active {
    transform: scale(0.97);
  }

  /* Flèche qui glisse au survol, survols réservés aux pointeurs fins */
  .btn-inscription svg,
  .btn-essai svg { transition: transform 200ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .btn-inscription:hover,
    .btn-essai:hover { background: var(--g400); }
    .btn-inscription:hover svg,
    .btn-essai:hover svg { transform: translateX(3px); }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .period {
      transform: none;
      transition: opacity 300ms ease var(--stagger, 0ms);
    }
    :global(.js) .period .period-badge {
      transform: none;
      transition: opacity 200ms ease calc(var(--stagger, 0ms) + 300ms);
    }
    .btn-inscription svg, .btn-essai svg { transition: none; }
    .btn-inscription:hover svg, .btn-essai:hover svg,
    .btn-inscription:active, .btn-essai:active { transform: none; }
  }

  .astuce svg { flex-shrink: 0; margin-top: 2px; }

  .astuce p {
    font-size: 14px;
    color: var(--text-3);
    line-height: 1.7;
  }

  .astuce strong { color: var(--g400); font-weight: 600; }

  @media (max-width: 960px) {
    .pricing { padding: 128px 0 80px; }
    .pricing-grid { grid-template-columns: minmax(0, 1fr); gap: 48px; margin-bottom: 80px; }
    .degressif { padding-top: 0; }
  }

  @media (max-width: 700px) {
    .tarif-col { padding: 28px 22px; }
    .steps { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    /* Badge « En cours » sous le libellé : 2 lignes au lieu de 4 */
    .period-label { flex-direction: column; align-items: flex-start; gap: 6px; }
    .btn-essai { align-self: stretch; }
  }
</style>
