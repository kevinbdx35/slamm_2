---
import { PRICING, SEASON, getActivePeriodIndex } from '../config/schedule.js';
import { ASSOCONNECT_URLS } from '../config/urls.js';

const activeIdx = getActivePeriodIndex();
const isOffSeason = activeIdx === -1;

// Hors-saison : on affiche les tarifs sept→déc (prochaine saison)
const displayIdx = isOffSeason ? 0 : activeIdx;

const periods = PRICING.adult.periods.map((p: any, i: number) => ({
  label: p.label,
  adult: `${p.price} €`,
  young: `${PRICING.young.periods[i].price} €`,
  current: i === displayIdx,
}));

const activeAdultPrice = PRICING.adult.periods[displayIdx].price;
const activeYoungPrice = PRICING.young.periods[displayIdx].price;
const activePeriodLabel = PRICING.adult.periods[displayIdx].label;

const monthMap: Record<string, string> = { 'Déc': 'décembre', 'Mars': 'mars', 'Juin': 'juin' };
const endAbbr = activePeriodLabel.split('→')[1]?.trim() ?? '';
const validUntil = monthMap[endAbbr] ?? endAbbr;

const features = [
  'Licence fédérale incluse',
  'Assurance comprise',
  'Accès à tous les cours',
];

const steps = [
  {
    num: '1',
    title: 'Observe un cours',
    desc: 'Aucune pression, juste pour découvrir.',
  },
  {
    num: '2',
    title: 'Essaye jusqu\'à 2 séances',
    desc: 'Gratuit pendant le premier mois suivant la reprise. Au-delà : 5 € par séance, déductible de l\'adhésion.',
  },
  {
    num: '3',
    title: 'Inscription',
    desc: 'Bienvenue dans l\'équipe !',
  },
];
---

<section class="pricing" id="tarifs">
  <div class="container">

    <div class="section-header reveal">
      <p class="section-label">Tarifs {SEASON}</p>
      <h2 class="section-title">
        Transparent,<br/>
        <span>sans surprise.</span>
      </h2>
    </div>

    <div class="pricing-grid">

      <!-- Tarif cards -->
      <div class="tarif-col reveal">
        <div class="tarif-cards">
          <div class="tarif-card">
            <p class="tarif-age">Adulte <span>+25 ans</span></p>
            <p class="tarif-price">{activeAdultPrice} <em>€</em></p>
            <p class="tarif-note">{isOffSeason ? 'prochaine saison · sept → déc' : `tarif actuel · ${activePeriodLabel.toLowerCase()}`}</p>
          </div>
          <div class="tarif-card tarif-card-accent">
            <p class="tarif-age">Jeune <span>+16 ans</span></p>
            <p class="tarif-price">{activeYoungPrice} <em>€</em></p>
            <p class="tarif-note">{isOffSeason ? 'prochaine saison · sept → déc' : `tarif actuel · ${activePeriodLabel.toLowerCase()}`}</p>
          </div>
        </div>

        <ul class="features">
          {features.map(f => (
            <li class="feature">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8l3.5 3.5L13 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {f}
            </li>
          ))}
        </ul>

        <p class="cb3x">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <rect x="1" y="3" width="12" height="9" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
            <path d="M1 6h12" stroke="currentColor" stroke-width="1.2"/>
          </svg>
          CB en 3 fois possible
        </p>

        <a href={ASSOCONNECT_URLS.ANNUAL_MEMBERSHIP} target="_blank" rel="noopener noreferrer" class="btn-inscription">
          S'inscrire maintenant
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2.5 7h9M8 3.5l3.5 3.5L8 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <!-- Période dégressive -->
      <div class="degressif reveal reveal-delay-2">
        <p class="degressif-title">Tarif dégressif selon la période</p>

        <div class="periods-header">
          <span></span>
          <span class="ph-adult">Adulte</span>
          <span class="ph-young">Jeune</span>
        </div>

        <div class="periods">
          {periods.map(p => (
            <div class={`period${p.current ? ' period-current' : ''}`}>
              <div class="period-label">
                {p.label}
                {p.current && <span class="period-badge">En cours</span>}
              </div>
              <span class="period-adult">{p.adult}</span>
              <span class="period-young">{p.young}</span>
            </div>
          ))}
        </div>

        <p class="validity-note">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.2"/>
            <path d="M7 4.5V7l1.5 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
          {isOffSeason ? 'Inscriptions ouvertes pour la prochaine saison — reprise en septembre' : `Valable jusqu'à fin ${validUntil} · CB en 3 fois possible`}
        </p>
      </div>
    </div>

    <!-- Pack découverte -->
    <div class="discovery reveal">
      <div class="discovery-header">
        <p class="discovery-label">Pack Découverte MMA</p>
        <p class="discovery-sub">Comment ça se passe avant de s'inscrire</p>
      </div>

      <div class="steps">
        {steps.map(s => (
          <div class="step">
            <div class="step-num" aria-hidden="true">{s.num}</div>
            <div class="step-body">
              <p class="step-title">{s.title}</p>
              <p class="step-desc">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <a href={ASSOCONNECT_URLS.TRIAL_BOOKING} target="_blank" rel="noopener noreferrer" class="btn-essai">
        Réserver un cours d'essai
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2.5 7h9M8 3.5l3.5 3.5L8 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <div class="astuce">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 2a4 4 0 0 1 1.5 7.7V11h-3V9.7A4 4 0 0 1 8 2z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
          <path d="M6.5 13h3M7 15h2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
        <p><strong>Astuce —</strong> Profite de tes séances d'essai pour découvrir les techniques, rencontrer les coachs et t'imprégner de l'ambiance du club.</p>
      </div>
    </div>

  </div>
</section>

<style>
  .pricing {
    padding: 120px 0;
    position: relative;
  }

  .pricing::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 64px;
  }

  .section-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--g500);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .section-title span { color: var(--g400); }

  /* ── Grid ── */
  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 24px;
  }

  /* ── Tarif cards ── */
  .tarif-col {
    background: var(--bg1);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .tarif-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .tarif-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .tarif-card-accent {
    border-color: rgba(34,197,94,0.25);
    background: rgba(34,197,94,0.04);
  }

  .tarif-age {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-3);
    letter-spacing: 0.02em;
    margin-bottom: 4px;
  }

  .tarif-age span {
    font-weight: 400;
    color: var(--text-muted);
    font-size: 12px;
  }

  /* Prix — Inter au lieu de Syne, letter-spacing neutre */
  .tarif-price {
    font-family: var(--font-body);
    font-size: 52px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    margin: 8px 0 6px;
  }

  .tarif-price em {
    font-style: normal;
    font-size: 26px;
    font-weight: 600;
    color: var(--g400);
    letter-spacing: 0;
  }

  .tarif-note {
    font-size: 12px;
    color: var(--text-muted);
  }

  /* Features */
  .features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .feature {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--text-3);
  }

  .feature svg { color: var(--g500); flex-shrink: 0; }

  .cb3x {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .cb3x svg { flex-shrink: 0; }

  /* ── Tableau dégressif ── */
  .degressif {
    background: var(--bg1);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .degressif-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-3);
    margin-bottom: 4px;
  }

  /* En-têtes colonnes */
  .periods-header {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 0 24px;
    padding: 0 20px 10px;
    border-bottom: 1px solid var(--border);
  }

  .ph-adult,
  .ph-young {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    min-width: 60px;
    text-align: right;
  }

  .ph-adult { color: var(--text-3); }
  .ph-young { color: var(--g500); }

  .periods {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .period {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 0 24px;
    align-items: center;
    padding: 18px 20px;
    border-bottom: 1px solid var(--border);
    transition: background 0.2s;
  }

  .period:last-child { border-bottom: none; }
  .period:hover { background: rgba(255,255,255,0.02); }
  .period-current { background: rgba(34,197,94,0.05); }

  .period-label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
  }

  .period-badge {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--bg);
    background: var(--g500);
    padding: 3px 8px;
    border-radius: 4px;
  }

  /* Montants — Inter, chiffres tabulaires */
  .period-adult,
  .period-young {
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    min-width: 60px;
    text-align: right;
  }

  .period-adult { color: var(--text); }
  .period-young { color: var(--g400); }

  .validity-note {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 4px;
  }

  .validity-note svg { flex-shrink: 0; }

  /* ── Pack découverte ── */
  .discovery {
    background: var(--bg1);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    padding: 48px 56px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .discovery-header {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .discovery-label {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .discovery-sub {
    font-size: 15px;
    color: var(--text-3);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-right: 40px;
    margin-right: 40px;
    border-right: 1px solid var(--border);
  }

  .step:last-child {
    border-right: none;
    padding-right: 0;
    margin-right: 0;
  }

  .step-num {
    width: 36px;
    height: 36px;
    background: rgba(34,197,94,0.1);
    border: 1px solid rgba(34,197,94,0.2);
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 800;
    color: var(--g400);
    flex-shrink: 0;
  }

  .step-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .step-desc {
    font-size: 14px;
    color: var(--text-3);
    line-height: 1.7;
  }

  .astuce {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: rgba(34,197,94,0.05);
    border: 1px solid rgba(34,197,94,0.15);
    border-radius: var(--r-md);
    padding: 16px 20px;
    color: var(--g500);
  }

  .btn-inscription {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--bg);
    background: var(--g500);
    padding: 12px 24px;
    border-radius: 100px;
    transition: background 0.2s, transform 0.2s;
    width: 100%;
    text-align: center;
  }

  .btn-inscription:hover {
    background: var(--g400);
    transform: translateY(-1px);
  }

  .btn-essai {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--g400);
    background: rgba(34,197,94,0.08);
    border: 1px solid rgba(34,197,94,0.25);
    padding: 12px 24px;
    border-radius: 100px;
    transition: background 0.2s, transform 0.2s;
    align-self: flex-start;
  }

  .btn-essai:hover {
    background: rgba(34,197,94,0.14);
    transform: translateY(-1px);
  }

  .astuce svg { flex-shrink: 0; margin-top: 2px; }

  .astuce p {
    font-size: 14px;
    color: var(--text-3);
    line-height: 1.7;
  }

  .astuce strong { color: var(--g400); font-weight: 600; }

  @media (max-width: 960px) {
    .pricing-grid { grid-template-columns: 1fr; }
    .discovery { padding: 40px 36px; }
  }

  @media (max-width: 700px) {
    .tarif-cards { grid-template-columns: 1fr; }
    .steps { grid-template-columns: 1fr; gap: 28px; }
    .step { border-right: none; border-bottom: 1px solid var(--border); padding: 0 0 28px; margin: 0; }
    .step:last-child { border-bottom: none; padding-bottom: 0; }
    .discovery { padding: 28px 20px; }
  }
</style>
