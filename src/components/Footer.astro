---
import { ASSOCONNECT_URLS, SOCIAL_URLS, CONTACT_INFO } from '../config/urls.js';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="SLAMM, Saint-Lunaire MMA, accueil">
          <span class="logo-mark">SL</span>
          <span class="logo-text">SLAMM<small>Saint-Lunaire MMA</small></span>
        </a>
        <p class="footer-tagline">
          L'excellence du combat<br/>sur la Côte d'Émeraude.
        </p>

        <div class="footer-social">
          <p class="footer-col-title">Suivez-nous</p>
          <a href={SOCIAL_URLS.INSTAGRAM} target="_blank" rel="noopener noreferrer" class="social-card" aria-label="Instagram @slamm35800">
            <span class="social-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
              </svg>
            </span>
            <span class="social-label">@slamm35800</span>
          </a>
        </div>
      </div>

      <nav class="footer-nav" aria-label="Navigation pied de page">
        <div class="footer-col">
          <p class="footer-col-title">Club</p>
          <a href="/">Accueil</a>
          <a href="/disciplines">Disciplines</a>
          <a href="/equipe">Équipe</a>
          <a href="/evenements">Événements</a>
        </div>
        <div class="footer-col">
          <p class="footer-col-title">Rejoindre</p>
          <a href={ASSOCONNECT_URLS.TRIAL_BOOKING} target="_blank" rel="noopener noreferrer" class="footer-action">Réserver un cours d'essai</a>
          <a href={ASSOCONNECT_URLS.ANNUAL_MEMBERSHIP} target="_blank" rel="noopener noreferrer" class="footer-action">S'inscrire au club</a>
          <a href="/tarifs">Tarifs</a>
          <a href="/faq">FAQ</a>
          <a href="/contact">Contact</a>
        </div>
        <div class="footer-col">
          <p class="footer-col-title">Ressources</p>
          <a href="/equipements">Équipements</a>
          <a href="/sparring">Sparring & Sécurité</a>
          <a href="/hygiene">Hygiène & Sécurité</a>
          <a href="/reglement">Règlement intérieur</a>
        </div>
        <div class="footer-col">
          <p class="footer-col-title">À proximité</p>
          <a href="/mma-dinard">MMA à Dinard</a>
          <a href="/mma-saint-malo">MMA à Saint-Malo</a>
        </div>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">
        © {year} Saint-Lunaire Arts Martiaux Mixtes · Association loi 1901
      </p>
      <div class="footer-right">
        <p class="footer-location">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M6 1a3.5 3.5 0 0 1 3.5 3.5C9.5 7 6 11 6 11S2.5 7 2.5 4.5A3.5 3.5 0 0 1 6 1z" stroke="currentColor" stroke-width="1.1"/>
            <circle cx="6" cy="4.5" r="1" fill="currentColor"/>
          </svg>
          {CONTACT_INFO.TRAINING_ADDRESS}
        </p>
        <nav class="footer-legal" aria-label="Informations légales">
          <a href="/mentions-legales">Mentions légales</a>
          <a href="/politique-confidentialite">Politique de confidentialité</a>
        </nav>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Marge basse : le bouton flottant (52px + 28px) ne recouvre rien en fin de page */
  .footer {
    border-top: 1px solid var(--border);
    padding: 80px 0 104px;
  }

  .footer-top {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 80px;
    margin-bottom: 64px;
    align-items: start;
  }

  /* Brand */
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }

  .logo-mark {
    width: 44px;
    height: 44px;
    background: var(--g700);
    color: white;
    border-radius: var(--r-sm);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 16px;
    letter-spacing: -0.5px;
    flex-shrink: 0;
  }

  /* Même composition que la nav : acronyme + nom complet en sous-titre */
  .logo-text {
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 800;
    line-height: 1;
    color: var(--text);
    letter-spacing: 0.02em;
  }

  .logo-text small {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--g400);
  }

  .footer-tagline {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.7;
    font-weight: 400;
    max-width: 240px;
    margin-bottom: 28px;
  }

  .footer-social {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .social-card {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--bg1);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: 10px 16px;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
    width: fit-content;
  }

  .social-card:hover {
    border-color: var(--border-strong);
    background: var(--surface);
    color: var(--g400);
  }

  .social-icon {
    color: var(--g400);
    display: grid;
    place-items: center;
  }

  .social-label {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-2);
    transition: color 0.2s;
  }

  .social-card:hover .social-label {
    color: var(--g400);
  }

  /* Nav */
  .footer-nav {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    justify-self: end;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-col-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-2);
    margin-bottom: 4px;
  }

  .footer-col a {
    font-size: 14px;
    color: var(--text-3);
    font-weight: 400;
    transition: color 0.2s;
    line-height: 1.6;
  }

  .footer-col a:hover {
    color: var(--g400);
  }

  /* Les deux actions de conversion ressortent dans la colonne « Rejoindre » */
  .footer-col .footer-action {
    color: var(--g400);
    font-weight: 600;
  }

  .footer-col .footer-action:hover { color: var(--text); }

  /* Bottom */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .footer-copy {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 400;
  }

  .footer-location {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 400;
  }

  .footer-location svg { color: var(--g600); }

  .footer-right {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .footer-legal {
    display: flex;
    gap: 20px;
  }

  .footer-legal a {
    font-size: 12px;
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .footer-legal a:hover { color: var(--g400); }

  @media (max-width: 900px) {
    .footer-top { grid-template-columns: 1fr; gap: 40px; }
    .footer-nav { justify-self: start; }
  }

  @media (max-width: 600px) {
    .footer-nav { grid-template-columns: 1fr 1fr; gap: 24px; }
    .footer { padding-bottom: 96px; }
    .footer-bottom { flex-direction: column; align-items: flex-start; gap: 12px; }
    .footer-right { flex-direction: column; align-items: flex-start; gap: 12px; }
  }
</style>
