---
import { Icon } from 'astro-icon/components';

const navLinks = [
  { href: '/', label: 'Accueil' },
  { href: '/cours', label: 'Cours & Tarifs' },
  { href: '/equipe', label: 'Équipe' },
  { href: '/evenements', label: 'Événements' },
  { href: '/contact', label: 'Contact' },
  { href: '/faq', label: 'FAQ' },
  { href: '/hygiene', label: 'Hygiène' },
];

const year = new Date().getFullYear();
---

<footer class="border-t-2 border-primary dark:border-primary-dark mt-auto py-12 transition-all duration-300 bg-surface-container-lowest dark:bg-surface-container-lowest-dark">
  <div class="max-w-7xl mx-auto px-4 md:px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Club Identity -->
      <div class="mb-6">
        <div class="text-lg font-bold text-primary dark:text-primary-dark mb-1 tracking-tight">
          SLAMM
        </div>
        <p class="text-base tracking-wide leading-relaxed mb-4 opacity-90">
          Saint-Lunaire Arts Martiaux Mixtes
        </p>
        <p class="text-sm tracking-wide leading-relaxed opacity-70">
          Club de MMA fondé en 2023, proposant des cours pour tous niveaux
          dans une ambiance conviviale et sérieuse.
        </p>
      </div>

      <!-- Contact -->
      <div>
        <div class="text-sm font-bold tracking-wide mb-4">
          Contact
        </div>
        <div class="flex flex-col gap-3">
          <div class="flex items-start">
            <Icon name="mdi:map-marker" class="w-5 h-5 mr-2 mt-0.5 text-primary dark:text-primary-dark flex-shrink-0" />
            <div>
              <p class="text-sm opacity-90 font-bold">Entraînements :</p>
              <p class="text-sm opacity-90">361 Rue de la Saudrais<br />35800 Saint-Lunaire</p>
              <p class="text-sm opacity-90 font-bold mt-2">Siège social :</p>
              <p class="text-sm opacity-90">Boulevard Flusson (Mairie)<br />35800 Saint-Lunaire</p>
            </div>
          </div>
          <div class="flex items-center">
            <Icon name="mdi:phone" class="w-5 h-5 mr-2 text-primary dark:text-primary-dark flex-shrink-0" />
            <p class="text-sm opacity-90">07 82 77 92 88</p>
          </div>
          <div class="flex items-center">
            <Icon name="mdi:email" class="w-5 h-5 mr-2 text-primary dark:text-primary-dark flex-shrink-0" />
            <p class="text-sm opacity-90">slamm35800@gmail.com</p>
          </div>
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <div class="text-sm font-bold tracking-wide mb-4">
          Navigation
        </div>
        <div class="flex flex-col gap-2">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm opacity-80 no-underline transition-all duration-200 hover:text-primary dark:hover:text-primary-dark hover:opacity-100 hover:translate-x-1"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Infos -->
      <div>
        <div class="text-sm font-bold tracking-wide mb-4">
          Informations
        </div>
        <div class="flex flex-col gap-2">
          <a
            href="/reglement-interieur"
            class="text-sm opacity-80 no-underline transition-all duration-200 hover:text-primary dark:hover:text-primary-dark hover:opacity-100 hover:translate-x-1"
          >
            Règlement intérieur
          </a>
          <a
            href="/equipements-mma"
            class="text-sm opacity-80 no-underline transition-all duration-200 hover:text-primary dark:hover:text-primary-dark hover:opacity-100 hover:translate-x-1"
          >
            Équipements MMA
          </a>
          <a
            href="/sparring"
            class="text-sm opacity-80 no-underline transition-all duration-200 hover:text-primary dark:hover:text-primary-dark hover:opacity-100 hover:translate-x-1"
          >
            Sparring & Sécurité
          </a>
        </div>
      </div>
    </div>

    <hr class="border-outline dark:border-outline-dark my-8" />

    <!-- Bottom section -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div class="flex flex-col sm:flex-row gap-4 items-center">
        <span class="text-[0.6875rem] font-medium tracking-wide opacity-70">
          © {year} SLAMM – Tous droits réservés
        </span>
        <span class="text-[0.6875rem] font-medium tracking-wide opacity-50 italic">
          • Site créé par Kevin depuis la Bretagne
        </span>
        <a
          href="/mentions-legales"
          class="text-[0.6875rem] font-medium tracking-wide opacity-70 hover:opacity-100 transition-opacity duration-200 hover:underline"
        >
          Mentions légales
        </a>
      </div>

      <a
        href="https://instagram.com/slamm35800"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1 p-2 rounded transition-all duration-200 hover:text-primary dark:hover:text-primary-dark hover:-translate-y-0.5"
        aria-label="Suivez-nous sur Instagram @slamm35800"
      >
        <Icon name="mdi:instagram" class="w-5 h-5" />
        <span class="text-[0.6875rem] font-medium tracking-wide">@slamm35800</span>
      </a>
    </div>
  </div>
</footer>
