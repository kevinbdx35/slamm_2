---
import { Image } from 'astro:assets';
import fmmaf from '../assets/img/partenaires/fmmaf-mono.webp';
import progress from '../assets/img/partenaires/progress-mono.webp';
import rdx from '../assets/img/partenaires/rdx-mono.webp';
import stlunaire from '../assets/img/partenaires/stlunaire-mono.webp';

const partners = [
  { src: stlunaire, alt: 'Ville de Saint-Lunaire' },
  { src: fmmaf, alt: 'FMMAF, Fédération Française de MMA' },
  { src: progress, alt: 'Progress' },
  { src: rdx, alt: 'RDX Sports' },
];
---

<section class="partners" aria-labelledby="partners-title">
  <div class="container partners-inner">
    <div class="partners-header reveal">
      <h2 class="partners-title" id="partners-title">Ils soutiennent <span>le club.</span></h2>
      <p class="partners-sub">Merci aux institutions, partenaires et sponsors qui soutiennent notre projet associatif et sportif.</p>
    </div>
    <ul class="partners-grid reveal">
      {partners.map(p => (
        <li class="partner-tile">
          <Image src={p.src} alt={p.alt} class="partner-logo" widths={[160, 320]} sizes="160px" />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .partners {
    padding: 96px 0;
    border-top: 1px solid var(--border);
  }

  /* En-tête à gauche, logos à droite */
  .partners-inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 64px;
    align-items: center;
  }

  .partners-title {
    font-family: var(--font-display);
    font-size: clamp(28px, 2.6vw, 38px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 16px;
  }

  .partners-title span { display: block; color: var(--g400); }

  .partners-sub {
    font-size: 15px;
    color: var(--text-3);
    line-height: 1.7;
    max-width: 36ch;
  }

  .partners-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    align-items: center;
  }

  .partner-tile {
    display: grid;
    place-items: center;
    height: 72px;
  }

  /* Logos en monochrome clair sur fond transparent (versions *-mono.webp
     générées depuis les originaux) : posés directement sur le fond sombre */
  .partner-logo {
    max-height: 52px;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    opacity: 0.75;
  }

  /* Logos en cascade (40ms) une fois la liste visible : la liste garde
     .reveal pour l'observer, mais ce sont les tuiles qui bougent */
  :global(.js) .partners-grid.reveal { opacity: 1; transform: none; transition: none; }
  :global(.js) .partner-tile {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 400ms var(--ease-out) var(--stagger, 0ms),
      transform 400ms var(--ease-out) var(--stagger, 0ms);
  }
  .partner-tile:nth-child(2) { --stagger: 40ms; }
  .partner-tile:nth-child(3) { --stagger: 80ms; }
  .partner-tile:nth-child(4) { --stagger: 120ms; }
  :global(.js) .partners-grid.visible .partner-tile { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .partner-tile {
      transform: none;
      transition: opacity 300ms ease var(--stagger, 0ms);
    }
  }

  @media (max-width: 900px) {
    .partners { padding: 72px 0; }
    .partners-inner { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .partners-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 32px; }
    .partner-tile { height: 56px; }
    .partner-logo { max-height: 40px; }
  }
</style>
