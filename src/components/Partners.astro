---
import { Image } from 'astro:assets';
import fmmaf from '../assets/img/partenaires/fmmaf.webp';
import progress from '../assets/img/partenaires/progress.webp';
import rdx from '../assets/img/partenaires/rdx.webp';
import stlunaire from '../assets/img/partenaires/stlunaire.webp';

const partners = [
  { src: stlunaire, alt: 'Mairie de Saint-Lunaire', label: 'Ville de Saint-Lunaire' },
  { src: fmmaf, alt: 'FMMAF — Fédération Française de MMA', label: 'Fédération Française de MMA' },
  { src: progress, alt: 'Progress', label: 'Progress' },
  { src: rdx, alt: 'RDX Sports', label: 'RDX Sports' },
];
---

<section class="partners reveal">
  <div class="container">
    <div class="partners-header">
      <p class="section-label">Nos partenaires</p>
      <h2 class="partners-title">Ils soutiennent<br/><span>le club.</span></h2>
      <p class="partners-sub">Notre association remercie chaleureusement les institutions, partenaires techniques, sponsors privés et amis du club pour leur soutien dans le développement de notre projet associatif et sportif.</p>
    </div>
    <div class="partners-grid">
      {partners.map(p => (
        <div class="partner-card">
          <div class="partner-logo-wrap">
            <Image src={p.src} alt={p.alt} class="partner-logo" />
          </div>
          <p class="partner-label">{p.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .partners {
    padding: 80px 0;
    border-top: 1px solid var(--border);
  }

  .partners-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .section-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--g500);
    margin-bottom: 20px;
  }

  .partners-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 20px;
  }

  .partners-title span { color: var(--g400); }

  .partners-sub {
    font-size: 15px;
    color: var(--text-3);
    line-height: 1.75;
    max-width: 560px;
    margin: 0 auto;
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .partner-card {
    background: var(--bg1);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 36px 24px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .partner-card:hover {
    border-color: var(--border-strong);
    box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    transform: translateY(-2px);
  }

  .partner-logo-wrap {
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .partner-logo {
    max-height: 72px;
    max-width: 140px;
    width: auto;
    object-fit: contain;
  }

  .partner-label {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
    text-align: center;
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .partners-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 480px) {
    .partners-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .partner-card { padding: 24px 16px 16px; }
    .partner-logo-wrap { height: 56px; }
    .partner-logo { max-height: 56px; }
  }
</style>
