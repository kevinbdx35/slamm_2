---
import { CONTACT_INFO, SOCIAL_URLS } from '../config/urls.js';
---

<section class="contact" id="contact">
  <div class="container">

    <!-- Header -->
    <div class="contact-header reveal">
      <div>
        <p class="section-label">Nous rejoindre</p>
        <h2 class="contact-title">
          Prêt à franchir<br/>
          <span>le premier pas ?</span>
        </h2>
      </div>
      <p class="contact-body">
        Les essais sont gratuits durant le premier mois suivant la date de reprise.
        En dehors de cette période, un essai est possible pour 5€.
        Contacte-nous et nous t'accueillerons lors de la prochaine session.
      </p>
    </div>

    <!-- Grid: coordonnées + formulaire -->
    <div class="contact-grid">

      <div class="contact-info reveal">
        <div class="contact-details">
          <div class="contact-item">
            <div class="contact-icon">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M9 2a5 5 0 0 1 5 5c0 3-5 9-5 9S4 10 4 7a5 5 0 0 1 5-5z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
                <circle cx="9" cy="7" r="1.5" stroke="currentColor" stroke-width="1.3"/>
              </svg>
            </div>
            <div>
              <p class="contact-detail-label">Adresse</p>
              <a href="https://www.google.com/maps/dir/?api=1&destination=Saint-Lunaire+Arts+Martiaux+Mixtes" target="_blank" rel="noopener noreferrer" class="contact-detail-val contact-link">{CONTACT_INFO.TRAINING_ADDRESS}</a>
              <p class="contact-detail-note">Obtenir l'itinéraire</p>
            </div>
          </div>

          <div class="contact-item">
            <div class="contact-icon">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M3 3h12a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z" stroke="currentColor" stroke-width="1.3"/>
                <path d="M2 4l7 6 7-6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
              </svg>
            </div>
            <div>
              <p class="contact-detail-label">Email</p>
              <a href="#" class="contact-detail-val contact-link" id="mail-link">slamm35800@gmail.com</a>
              <p class="contact-detail-note">Réponse sous 24h</p>
            </div>
          </div>

          <div class="contact-item">
            <div class="contact-icon">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M3.5 2.5h2.8l1.2 3.2-1.7 1a10 10 0 0 0 5.5 5.5l1-1.7 3.2 1.2v2.8a1 1 0 0 1-1.1.9C6.7 15 2.5 10.8 2.6 3.6a1 1 0 0 1 .9-1.1z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
              </svg>
            </div>
            <div>
              <p class="contact-detail-label">WhatsApp</p>
              <a href={`https://api.whatsapp.com/send/?phone=${CONTACT_INFO.PHONE.replace(/[\s+]/g, '')}&text=Bonjour%2C+je+souhaite+des+informations+sur+le+club+de+MMA.&type=phone_number&app_absent=0`} target="_blank" rel="noopener noreferrer" class="contact-detail-val contact-link">{CONTACT_INFO.PHONE}</a>
              <p class="contact-detail-note">Écrire sur WhatsApp</p>
            </div>
          </div>

          <div class="contact-item">
            <div class="contact-icon">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <rect x="2" y="2" width="14" height="14" rx="4" stroke="currentColor" stroke-width="1.3"/>
                <circle cx="9" cy="9" r="3.5" stroke="currentColor" stroke-width="1.3"/>
                <circle cx="13" cy="5" r="0.8" fill="currentColor"/>
              </svg>
            </div>
            <div>
              <p class="contact-detail-label">Instagram</p>
              <a href={SOCIAL_URLS.INSTAGRAM} target="_blank" rel="noopener noreferrer" class="contact-detail-val contact-link">@slamm35800</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="contact-form-wrap reveal reveal-delay-2">
        <form class="contact-form" id="contact-form" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" novalidate>
          <input type="hidden" name="form-name" value="contact" />
          <p style="display:none"><label>Ne pas remplir : <input name="bot-field" /></label></p>
          <div class="form-row">
            <div class="field">
              <label for="prenom">Prénom</label>
              <input type="text" id="prenom" name="prenom" placeholder="Ton prénom" autocomplete="given-name" required />
            </div>
            <div class="field">
              <label for="nom">Nom</label>
              <input type="text" id="nom" name="nom" placeholder="Ton nom" autocomplete="family-name" required />
            </div>
          </div>

          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="ton@email.fr" autocomplete="email" required />
          </div>

          <div class="field">
            <label for="message">Message <span class="optional">(optionnel)</span></label>
            <textarea id="message" name="message" rows="4" placeholder="Questions, niveau, disponibilités…"></textarea>
          </div>

          <button type="submit" class="form-submit">
            <span class="submit-text">Envoyer ma demande</span>
            <span class="submit-icon">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </button>

          <p class="form-consent">
            En envoyant ce formulaire, tu acceptes que tes données soient utilisées
            uniquement pour répondre à ta demande. Consulte notre
            <a href="/politique-confidentialite">politique de confidentialité</a>.
          </p>

          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>

    <!-- Infos pratiques -->
    <div class="practical-info reveal">
      <p class="practical-title">Informations pratiques</p>
      <div class="practical-grid">
        <div class="practical-item">
          <div class="practical-icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <rect x="2" y="4" width="14" height="11" rx="2" stroke="currentColor" stroke-width="1.3"/>
              <path d="M6 4V3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1" stroke="currentColor" stroke-width="1.3"/>
              <path d="M6 9h2.5a1.5 1.5 0 0 1 0 3H6V9z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <p class="practical-label">Parking gratuit</p>
            <p class="practical-val">Stationnement disponible sur place</p>
          </div>
        </div>
        <div class="practical-item">
          <div class="practical-icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <rect x="2" y="2" width="14" height="14" rx="2" stroke="currentColor" stroke-width="1.3"/>
              <path d="M2 8h14" stroke="currentColor" stroke-width="1.3"/>
              <path d="M9 8v8" stroke="currentColor" stroke-width="1.3"/>
            </svg>
          </div>
          <div>
            <p class="practical-label">Dojo à l'étage</p>
            <p class="practical-val">Premier étage du bâtiment</p>
          </div>
        </div>
        <div class="practical-item">
          <div class="practical-icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <circle cx="6.5" cy="6" r="2.5" stroke="currentColor" stroke-width="1.3"/>
              <circle cx="11.5" cy="6" r="2.5" stroke="currentColor" stroke-width="1.3"/>
              <path d="M2 15c0-2.5 2-4 4.5-4s4.5 1.5 4.5 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
              <path d="M11 11.2c2 .2 3.5 1.6 3.5 3.8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <p class="practical-label">Vestiaires séparés</p>
            <p class="practical-val">Homme et femme</p>
          </div>
        </div>
        <div class="practical-item">
          <div class="practical-icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M9 2v4M7 3l2 3 2-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M4 8h10a1 1 0 0 1 1 1v1H3V9a1 1 0 0 1 1-1z" stroke="currentColor" stroke-width="1.3"/>
              <path d="M5 10v5M9 10v5M13 10v5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <p class="practical-label">Douches</p>
            <p class="practical-val">Disponibles dans les vestiaires</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Carte -->
    <div class="map-wrap reveal">
      <div id="leaflet-map" class="map" aria-label="Localisation du dojo Saint-Lunaire MMA"></div>
    </div>

    <p class="map-note reveal">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M7 1a4 4 0 0 1 4 4c0 3-4 8-4 8S3 8 3 5a4 4 0 0 1 4-4z" stroke="currentColor" stroke-width="1.2"/>
        <circle cx="7" cy="5" r="1.2" fill="currentColor"/>
      </svg>
      Accessible depuis Dinard (5 min), Saint-Malo (15 min), Pleurtuit, Saint-Briac et toute la Côte d'Émeraude.
    </p>

  </div>
</section>

<style>
  .contact {
    padding: 120px 0 80px;
    position: relative;
  }

  .contact::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
  }

  /* Header */
  .contact-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: end;
    margin-bottom: 56px;
  }

  .section-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--g500);
    margin-bottom: 20px;
  }

  .contact-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .contact-title span { color: var(--g400); }

  .contact-body {
    font-size: 16px;
    color: var(--text-3);
    line-height: 1.7;
    align-self: end;
  }

  /* Grid coordonnées + formulaire */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: stretch;
    margin-bottom: 48px;
  }

  .contact-info {
    background: var(--bg1);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    padding: 36px;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .contact-icon {
    width: 40px;
    height: 40px;
    background: rgba(34,197,94,0.08);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    display: grid;
    place-items: center;
    color: var(--g400);
    flex-shrink: 0;
  }

  .contact-detail-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 4px;
  }

  .contact-detail-val {
    font-size: 15px;
    color: var(--text-2);
    font-weight: 400;
    line-height: 1.6;
  }

  .contact-detail-note {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .contact-link { transition: color 0.2s; }
  .contact-link:hover { color: var(--g400); }

  /* Form */
  .contact-form-wrap {
    background: var(--bg1);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    padding: 36px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field label {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-2);
    letter-spacing: 0.01em;
  }

  .optional {
    font-weight: 400;
    color: var(--text-muted);
    font-size: 12px;
  }

  .field input,
  .field textarea {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    padding: 12px 16px;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text);
    outline: none;
    transition: border-color 0.2s, background 0.2s;
    width: 100%;
    resize: vertical;
  }

  .field input::placeholder,
  .field textarea::placeholder { color: var(--text-muted); }

  .field input:focus,
  .field textarea:focus {
    border-color: rgba(34,197,94,0.4);
    background: var(--surface);
  }

  .form-submit {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: var(--g500);
    border: none;
    border-radius: var(--r-md);
    padding: 16px 24px;
    cursor: pointer;
    margin-top: 4px;
    transition: background 0.25s, transform 0.25s;
  }

  .form-submit:hover {
    background: var(--g400);
    transform: translateY(-2px);
  }

  .form-submit:disabled {
    cursor: default;
    transform: none;
  }

  .submit-text {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    color: var(--bg);
    letter-spacing: 0.01em;
  }

  .submit-icon {
    width: 32px;
    height: 32px;
    background: rgba(8,15,10,0.18);
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--bg);
    transition: transform 0.2s;
  }

  .form-submit:hover:not(:disabled) .submit-icon { transform: translateX(3px); }

  .form-status {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    min-height: 1.2em;
  }
  .form-status.success { color: var(--g400); }
  .form-status.error { color: #f87171; }

  .form-consent {
    font-size: 12px;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .form-consent a {
    color: var(--g400);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Infos pratiques */
  .practical-info {
    background: var(--bg1);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    padding: 36px;
    margin-bottom: 24px;
  }

  .practical-title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 24px;
  }

  .practical-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .practical-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .practical-icon {
    width: 36px;
    height: 36px;
    background: rgba(34,197,94,0.06);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    display: grid;
    place-items: center;
    color: var(--g400);
    flex-shrink: 0;
  }

  .practical-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-2);
    margin-bottom: 2px;
  }

  .practical-val {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Carte */
  .map-wrap {
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .map {
    display: block;
    width: 100%;
    height: 400px;
  }

  .map-note {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .map-note svg { color: var(--g500); flex-shrink: 0; }

  @media (max-width: 900px) {
    .contact-header { grid-template-columns: 1fr; gap: 24px; }
    .contact-grid { grid-template-columns: 1fr; }
    .practical-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 500px) {
    .form-row { grid-template-columns: 1fr; }
    .practical-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const mailLink = document.getElementById('mail-link') as HTMLAnchorElement;
  if (mailLink) {
    const u = 'slamm35800';
    const d = 'gmail.com';
    mailLink.href = `mailto:${u}@${d}`;
  }

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status') as HTMLElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const submitBtn = form.querySelector('.form-submit') as HTMLButtonElement;
    const btnText = form.querySelector('.submit-text') as HTMLElement;
    submitBtn.disabled = true;
    btnText.textContent = 'Envoi…';
    status.className = 'form-status';
    status.textContent = '';
    try {
      const body = new URLSearchParams(new FormData(form) as any).toString();
      const res = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body,
      });
      if (!res.ok) throw new Error(String(res.status));
      btnText.textContent = 'Message envoyé !';
      status.className = 'form-status success';
      status.textContent = 'Merci, ta demande a bien été envoyée. On te répond sous 24h.';
    } catch {
      btnText.textContent = 'Envoyer ma demande';
      submitBtn.disabled = false;
      status.className = 'form-status error';
      status.textContent = 'Une erreur est survenue. Merci de réessayer ou de nous écrire directement.';
    }
  });
</script>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  const lat = 48.629217, lng = -2.112208, zoom = 16;
  const map = L.map('leaflet-map', { zoomControl: true, scrollWheelZoom: false }).setView([lat, lng], zoom);

  L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/">CARTO</a>',
    subdomains: 'abcd',
    maxZoom: 19,
  }).addTo(map);

  const icon = L.divIcon({
    className: '',
    html: '<div style="width:14px;height:14px;background:#22c55e;border:2px solid #f0fdf4;border-radius:50%;box-shadow:0 0 0 4px rgba(34,197,94,0.3)"></div>',
    iconSize: [14, 14],
    iconAnchor: [7, 7],
  });

  L.marker([48.629217, -2.112208], { icon })
    .addTo(map)
    .bindPopup('<strong style="color:#080f0a">Saint-Lunaire MMA</strong><br><span style="color:#555;font-size:12px">361 Rue de la Saudrais</span>')
    .openPopup();
</script>
