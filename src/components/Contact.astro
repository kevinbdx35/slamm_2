---
import { CONTACT_INFO, SOCIAL_URLS } from '../config/urls.js';
---

<section class="contact" id="contact">
  <div class="container">

    <!-- Header -->
    <div class="contact-header">
      <h1 class="contact-title">
        <span class="title-slot"><span class="title-slot-text">Prêt à franchir</span></span>{' '}
        <span class="title-slot title-accent"><span class="title-slot-text">le premier pas&nbsp;?</span></span>
      </h1>
      <p class="contact-body reveal reveal-delay-2">
        Les essais sont gratuits durant le premier mois suivant la date de reprise.
        En dehors de cette période, un essai est possible pour 5€.
        Contacte-nous et nous t'accueillerons lors de la prochaine session.
      </p>
    </div>

    <!-- Grid: coordonnées + formulaire -->
    <div class="contact-grid">

      <div class="contact-info reveal">
        <div class="contact-details">
          <div class="contact-item">
            <div>
              <p class="contact-detail-label">Adresse</p>
              <a href="https://www.google.com/maps/dir/?api=1&destination=Saint-Lunaire+Arts+Martiaux+Mixtes" target="_blank" rel="noopener noreferrer" class="contact-detail-val contact-link">{CONTACT_INFO.TRAINING_ADDRESS}</a>
              <p class="contact-detail-note">Obtenir l'itinéraire</p>
            </div>
          </div>

          <div class="contact-item">
            <div>
              <p class="contact-detail-label">Email</p>
              <a href="#" class="contact-detail-val contact-link" id="mail-link">slamm35800@gmail.com</a>
              <p class="contact-detail-note">Réponse sous 24h</p>
            </div>
          </div>

          <div class="contact-item">
            <div>
              <p class="contact-detail-label">WhatsApp</p>
              <a href={`https://api.whatsapp.com/send/?phone=${CONTACT_INFO.PHONE.replace(/[\s+]/g, '')}&text=Bonjour%2C+je+souhaite+des+informations+sur+le+club+de+MMA.&type=phone_number&app_absent=0`} target="_blank" rel="noopener noreferrer" class="contact-detail-val contact-link">{CONTACT_INFO.PHONE}</a>
              <p class="contact-detail-note">Écrire sur WhatsApp</p>
            </div>
          </div>

          <div class="contact-item">
            <div>
              <p class="contact-detail-label">Instagram</p>
              <a href={SOCIAL_URLS.INSTAGRAM} target="_blank" rel="noopener noreferrer" class="contact-detail-val contact-link">@slamm35800</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="contact-form-wrap reveal reveal-delay-2">
        <form class="contact-form" id="contact-form" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" novalidate>
          <input type="hidden" name="form-name" value="contact" />
          <p style="display:none"><label>Ne pas remplir : <input name="bot-field" /></label></p>
          <div class="form-row">
            <div class="field">
              <label for="prenom">Prénom</label>
              <input type="text" id="prenom" name="prenom" placeholder="Ton prénom" autocomplete="given-name" required />
            </div>
            <div class="field">
              <label for="nom">Nom</label>
              <input type="text" id="nom" name="nom" placeholder="Ton nom" autocomplete="family-name" required />
            </div>
          </div>

          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="ton@email.fr" autocomplete="email" required />
          </div>

          <div class="field">
            <label for="message">Message <span class="optional">(optionnel)</span></label>
            <textarea id="message" name="message" rows="4" placeholder="Questions, niveau, disponibilités…"></textarea>
          </div>

          <button type="submit" class="form-submit">
            <span class="submit-text">Envoyer ma demande</span>
            <span class="submit-icon">
              <svg class="icon-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <svg class="icon-check" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8.5l3.5 3.5L13 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </button>

          <p class="form-consent">
            En envoyant ce formulaire, tu acceptes que tes données soient utilisées
            uniquement pour répondre à ta demande. Consulte notre
            <a href="/politique-confidentialite/">politique de confidentialité</a>.
          </p>

          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>

    <!-- Infos pratiques -->
    <div class="practical-info">
      <h2 class="practical-title reveal">Informations pratiques</h2>
      <div class="practical-grid reveal rule-cascade">
        <div class="practical-item rule-item">
          <div>
            <p class="practical-label">Parking gratuit</p>
            <p class="practical-val">Stationnement disponible sur place</p>
          </div>
        </div>
        <div class="practical-item rule-item">
          <div>
            <p class="practical-label">Dojo à l'étage</p>
            <p class="practical-val">Premier étage du bâtiment</p>
          </div>
        </div>
        <div class="practical-item rule-item">
          <div>
            <p class="practical-label">Vestiaires séparés</p>
            <p class="practical-val">Homme et femme</p>
          </div>
        </div>
        <div class="practical-item rule-item">
          <div>
            <p class="practical-label">Douches</p>
            <p class="practical-val">Disponibles dans les vestiaires</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Carte -->
    <div class="map-wrap reveal">
      <div id="leaflet-map" class="map" aria-label="Localisation du dojo Saint-Lunaire MMA"></div>
    </div>

    <p class="map-note reveal">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M7 1a4 4 0 0 1 4 4c0 3-4 8-4 8S3 8 3 5a4 4 0 0 1 4-4z" stroke="currentColor" stroke-width="1.2"/>
        <circle cx="7" cy="5" r="1.2" fill="currentColor"/>
      </svg>
      Accessible depuis Dinard (5 min), Saint-Malo (15 min), Pleurtuit, Saint-Briac et toute la Côte d'Émeraude.
    </p>

  </div>
</section>

<style>
  /* Première section de la page : dégage la nav fixe */
  .contact {
    padding: 152px 0 112px;
  }

  /* En-tête empilé : titre puis texte */
  .contact-header {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 720px;
    margin-bottom: 64px;
  }

  .contact-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .contact-title .title-accent { color: var(--g400); }

  .contact-body {
    font-size: 17px;
    color: var(--text-3);
    line-height: 1.7;
    max-width: 56ch;
  }

  /* Coordonnées à plat (5/12) + formulaire en carte (7/12) */
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 64px;
    align-items: start;
    margin-bottom: 96px;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-strong);
  }

  .contact-item {
    padding: 22px 0;
    border-bottom: 1px solid var(--border);
  }

  .contact-detail-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .contact-detail-val {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .contact-detail-note {
    font-size: 13px;
    color: var(--text-3);
    margin-top: 4px;
  }

  .contact-link {
    display: inline-block;
    transform-origin: left center;
    transition: color 200ms ease, transform 160ms var(--ease-out);
  }

  .contact-link:active { transform: scale(0.97); }

  @media (hover: hover) and (pointer: fine) {
    .contact-link:hover { color: var(--g400); }
  }

  /* Form */
  .contact-form-wrap {
    background: var(--bg1);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    padding: 36px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field label {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-2);
    letter-spacing: 0.01em;
  }

  .optional {
    font-weight: 400;
    color: var(--text-muted);
    font-size: 12px;
  }

  .field input,
  .field textarea {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    padding: 12px 16px;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text);
    outline: none;
    transition: border-color 0.2s, background 0.2s;
    width: 100%;
    resize: vertical;
  }

  .field input::placeholder,
  .field textarea::placeholder { color: var(--text-muted); }

  .field input:focus,
  .field textarea:focus {
    border-color: rgba(34,197,94,0.4);
    background: var(--surface);
  }

  .form-submit {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: var(--g500);
    border: none;
    border-radius: var(--r-md);
    padding: 16px 24px;
    cursor: pointer;
    margin-top: 4px;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease,
      opacity 200ms ease,
      transform 160ms var(--ease-out);
  }

  .form-submit:active {
    transform: scale(0.97);
  }

  .form-submit:disabled {
    cursor: default;
    transform: none;
  }

  /* Envoi en cours */
  .form-submit[aria-busy="true"] { opacity: 0.7; }

  .submit-text {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    color: var(--bg);
    letter-spacing: 0.01em;
  }

  .submit-icon {
    width: 32px;
    height: 32px;
    background: rgba(8,15,10,0.18);
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--bg);
    transition: transform 200ms var(--ease-out);
  }

  /* Flèche et coche superposées : la coche remplace la flèche une fois envoyé */
  .submit-icon svg {
    grid-area: 1 / 1;
    transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out);
  }
  .icon-check { opacity: 0; transform: scale(0.8); }
  .form-submit.is-sent .icon-arrow { opacity: 0; transform: scale(0.8); }
  .form-submit.is-sent .icon-check { opacity: 1; transform: none; }

  @media (hover: hover) and (pointer: fine) {
    .form-submit:hover:not(:disabled) { background: var(--g400); }
    .form-submit:hover:not(:disabled) .submit-icon { transform: translateX(3px); }
  }

  /* Hors du bloc « souris » : la hauteur réservée vaut pour tous les appareils */
  .form-status {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    min-height: 1.2em;
  }
  .form-status.success { color: var(--g400); }
  .form-status.error { color: #f87171; }

  .form-consent {
    font-size: 12px;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .form-consent a {
    color: var(--g400);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Infos pratiques */
  /* Infos pratiques : 4 colonnes à plat sous un filet */
  .practical-info {
    margin-bottom: 64px;
  }

  .practical-title {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.4vw, 30px);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 28px;
  }

  .practical-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
  }

  /* Filet dessiné en cascade : utilitaires globaux .rule-cascade / .rule-item */
  .practical-item {
    padding-top: 20px;
  }

  .practical-label {
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 4px;
  }

  .practical-val {
    font-size: 14px;
    color: var(--text-3);
    line-height: 1.6;
  }

  /* Carte */
  .map-wrap {
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  /* Tuiles OSM assombries pour s'accorder au thème (le marqueur et la bulle restent intacts) */
  .map :global(.leaflet-tile-pane) {
    filter: invert(1) hue-rotate(180deg) brightness(0.85) contrast(0.9) saturate(0.35);
  }

  .map :global(.leaflet-container),
  .map:global(.leaflet-container) {
    background: var(--bg1);
  }

  .map {
    display: block;
    width: 100%;
    height: 400px;
  }

  .map-note {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .map-note svg { color: var(--g500); flex-shrink: 0; }

  @media (max-width: 900px) {
    .contact { padding: 128px 0 80px; }
    .contact-grid { grid-template-columns: minmax(0, 1fr); gap: 48px; margin-bottom: 72px; }
    .practical-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  }

  @media (max-width: 500px) {
    .form-row { grid-template-columns: 1fr; }
    .practical-grid { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .practical-item { padding: 16px 0; --rule: var(--border); }
    .practical-item:first-child { --rule: var(--border-strong); }
    .contact-form-wrap { padding: 28px 20px; }
    .map { height: 320px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-link, .submit-icon, .submit-icon svg { transition: opacity 200ms ease, color 200ms ease; }
    .contact-link:active, .form-submit:hover .submit-icon { transform: none; }
    .icon-check, .form-submit.is-sent .icon-arrow { transform: none; }
  }
</style>

<script>
  const mailLink = document.getElementById('mail-link') as HTMLAnchorElement;
  if (mailLink) {
    const u = 'slamm35800';
    const d = 'gmail.com';
    mailLink.href = `mailto:${u}@${d}`;
  }

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status') as HTMLElement;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Changement de libellé en fondu enchaîné, avec un léger flou qui fond
  // l'ancien texte dans le nouveau (sans flou en mouvement réduit)
  const setLabel = async (el: HTMLElement, text: string) => {
    const hidden = reduceMotion ? { opacity: 0 } : { opacity: 0, filter: 'blur(2px)' };
    const shown = reduceMotion ? { opacity: 1 } : { opacity: 1, filter: 'blur(0)' };
    await el.animate([shown, hidden], { duration: 75, easing: 'ease-out', fill: 'forwards' }).finished;
    el.textContent = text;
    el.animate([hidden, shown], { duration: 150, easing: 'ease-out', fill: 'forwards' });
  };

  // Message de statut : se pose en fondu, comme les réponses de la FAQ
  const setStatus = (kind: '' | 'success' | 'error', text: string) => {
    status.className = kind ? `form-status ${kind}` : 'form-status';
    status.textContent = text;
    if (!text) return;
    status.animate(
      reduceMotion
        ? { opacity: [0, 1] }
        : { opacity: [0, 1], transform: ['translateY(-4px)', 'none'] },
      { duration: 200, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
    );
  };
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const submitBtn = form.querySelector('.form-submit') as HTMLButtonElement;
    const btnText = form.querySelector('.submit-text') as HTMLElement;
    submitBtn.disabled = true;
    submitBtn.setAttribute('aria-busy', 'true');
    setLabel(btnText, 'Envoi…');
    setStatus('', '');
    try {
      const body = new URLSearchParams(new FormData(form) as any).toString();
      const res = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body,
      });
      if (!res.ok) throw new Error(String(res.status));
      submitBtn.removeAttribute('aria-busy');
      submitBtn.classList.add('is-sent');
      setLabel(btnText, 'Message envoyé !');
      setStatus('success', 'Merci, ta demande a bien été envoyée. On te répond sous 24h.');
    } catch {
      submitBtn.removeAttribute('aria-busy');
      submitBtn.disabled = false;
      setLabel(btnText, 'Envoyer ma demande');
      setStatus('error', 'Une erreur est survenue. Merci de réessayer ou de nous écrire directement.');
    }
  });
</script>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  const lat = 48.629217, lng = -2.112208, zoom = 16;
  // Leaflet ignore prefers-reduced-motion : on coupe ses zooms et fondus animés
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const map = L.map('leaflet-map', {
    zoomControl: true,
    scrollWheelZoom: false,
    zoomAnimation: !reduce,
    fadeAnimation: !reduce,
    markerZoomAnimation: !reduce,
  }).setView([lat, lng], zoom);

  // Tuiles OpenStreetMap (CARTO exige désormais une clé API) ; domaine unique
  // tile.openstreetmap.org (OSM ne recommande plus les sous-domaines a/b/c),
  // autorisé par la CSP de public/_headers
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    maxZoom: 19,
  }).addTo(map);

  const icon = L.divIcon({
    className: '',
    html: '<div style="width:14px;height:14px;background:#22c55e;border:2px solid #f0fdf4;border-radius:50%;box-shadow:0 0 0 4px rgba(34,197,94,0.3)"></div>',
    iconSize: [14, 14],
    iconAnchor: [7, 7],
  });

  L.marker([48.629217, -2.112208], { icon })
    .addTo(map)
    .bindPopup('<strong style="color:#080f0a">Saint-Lunaire MMA</strong><br><span style="color:#555;font-size:12px">361 Rue de la Saudrais</span>')
    .openPopup();
</script>
