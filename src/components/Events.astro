---
import { Image } from 'astro:assets';
import TrialCta from './TrialCta.astro';
import { EVENTS, getUpcomingEvents, getPastEvents, formatEventDate } from '../config/events.js';

const upcoming = getUpcomingEvents(EVENTS);
const past = getPastEvents(EVENTS, 4);

// Les affiches vivent dans src/assets/img/events/ ; events.js n'en stocke que le chemin.
const eventImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/img/events/*.{webp,jpg,jpeg,png}',
  { eager: true }
);

function getEventImage(path: string | null): ImageMetadata | null {
  if (!path) return null;
  const file = path.split('/').pop();
  const match = Object.entries(eventImages).find(([key]) => key.endsWith(`/${file}`));
  return match ? match[1].default : null;
}

function getEventType(event: any): string {
  const t = event.title.toLowerCase();
  if (t.includes('stage')) return 'Stage';
  if (t.includes('tour') || t.includes('tournoi') || t.includes('daymat') || t.includes('compétition')) return 'Compétition';
  return 'Événement';
}

function getCity(location: string): string {
  if (!location) return '';
  const parts = location.split(',');
  return parts[parts.length - 1].trim().replace(/^\d{5}\s*/, '');
}

const stats = [
  { num: '5',  label: 'stages organisés' },
  { num: '4',  label: 'échanges inter-clubs' },
  { num: '3',  label: 'compétitions' },
  { num: '3',  label: 'médailles No‑Gi' },
  { num: '1',  label: 'victoire MMA interclub' },
];
---

<section class="events" id="evenements">
  <div class="container">
    <!-- En-tête à plat : titre de page + chiffres sous un filet -->
    <div class="events-header">
      <h1 class="events-title">
        <span class="title-slot"><span class="title-slot-text">En mouvement</span></span>{' '}
        <span class="title-slot title-accent"><span class="title-slot-text">depuis 2023.</span></span>
      </h1>
    </div>

    <dl class="events-stats reveal">
      {stats.map((s, i) => (
        <div class="stat-item" style={`--stagger: ${i * 40}ms`}>
          <dt class="stat-label">{s.label}</dt>
          <dd class="stat-num">{s.num}</dd>
        </div>
      ))}
    </dl>

    <div class="upcoming">
      <h2 class="block-title reveal">Prochains événements</h2>
      {upcoming.length > 0 ? (
        <div class="upcoming-list">
          {upcoming.map((e) => {
            const img = getEventImage(e.image);
            return (
            <article class:list={['upcoming-card', { 'has-thumb': img }]}>
              {img && (
                <Image
                  src={img}
                  alt={e.imageAlt ?? `Affiche : ${e.title}`}
                  widths={[400, 600, 900]}
                  sizes="(max-width: 900px) 100vw, 440px"
                  class="upcoming-thumb reveal"
                  loading="lazy"
                />
              )}
              <div class="upcoming-body reveal reveal-delay-1">
                <span class="event-type">{getEventType(e)}</span>
                <h3 class="upcoming-name">{e.title}</h3>
                <p class="upcoming-when">
                  <span>{formatEventDate(e.date)}</span>
                  {e.time && <span class="upcoming-time">{e.time}</span>}
                </p>
                <p class="upcoming-where">
                  {getCity(e.location)}
                  {e.price && <span class="upcoming-price">{e.price}</span>}
                </p>
                <p class="upcoming-desc">{e.description}</p>
                {e.registrationUrl && (
                  <a href={e.registrationUrl} target="_blank" rel="noopener noreferrer" class="upcoming-cta">S'inscrire</a>
                )}
              </div>
            </article>
            );
          })}
        </div>
      ) : (
        <div class="upcoming-empty reveal">
          <p>Aucun événement programmé pour le moment.</p>
          <p>Reviens bientôt ou <a href="/contact/">contacte-nous</a> pour en savoir plus.</p>
        </div>
      )}
    </div>

    {past.length > 0 && (
      <div class="past">
        <h2 class="block-title reveal">Événements passés</h2>
        <ul class="past-list reveal">
          {past.map((e, i) => (
            <li class="past-row" style={`--stagger: ${i * 40}ms`}>
              <span class="past-date">{formatEventDate(e.date)}</span>
              <div class="past-body">
                <span class="event-type">{getEventType(e)}</span>
                <h3 class="past-name">{e.title}</h3>
                <p class="past-desc">{e.description}</p>
              </div>
              <span class="past-lieu">{getCity(e.location)}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <TrialCta />
  </div>
</section>

<style>
  /* Première section de la page : dégage la nav fixe */
  .events {
    padding: 152px 0 112px;
  }

  .events-header { margin-bottom: 56px; }

  .events-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .events-title .title-accent { color: var(--g400); }

  /* Chiffres : rangée à plat sous un filet */
  .events-stats {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 32px;
    padding-top: 28px;
    border-top: 1px solid var(--border-strong);
    margin-bottom: 112px;
  }

  .stat-item {
    display: flex;
    flex-direction: column-reverse;
    gap: 8px;
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--g400);
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 14px;
    color: var(--text-3);
  }

  .block-title {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.4vw, 30px);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 28px;
  }

  .event-type {
    font-size: 13px;
    font-weight: 600;
    color: var(--g400);
  }

  /* Prochain événement : affiche (5/12) + infos (7/12) */
  .upcoming { margin-bottom: 112px; }

  .upcoming-list {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .upcoming-card.has-thumb {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 56px;
    align-items: center;
  }

  .upcoming-thumb {
    width: 100%;
    height: auto;
    border-radius: var(--r-lg);
  }

  .upcoming-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .upcoming-name {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.4vw, 30px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .upcoming-when {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    font-size: 18px;
    font-weight: 600;
    color: var(--text);
  }

  .upcoming-time { color: var(--text-3); font-weight: 500; }

  .upcoming-where {
    display: flex;
    gap: 16px;
    font-size: 15px;
    color: var(--text-3);
  }

  .upcoming-price {
    font-weight: 700;
    color: var(--g400);
    font-variant-numeric: tabular-nums;
  }

  .upcoming-desc {
    font-size: 16px;
    color: var(--text-3);
    line-height: 1.7;
    max-width: 56ch;
  }

  /* Inscription à l'événement : l'action principale du bloc */
  .upcoming-cta {
    margin-top: 12px;
    font-size: 15px;
    font-weight: 600;
    color: var(--bg);
    background: var(--g500);
    padding: 14px 32px;
    border-radius: 100px;
    transition: background-color 200ms ease, transform 160ms var(--ease-out);
  }

  .upcoming-cta:active { transform: scale(0.97); }

  @media (hover: hover) and (pointer: fine) {
    .upcoming-cta:hover { background: var(--g400); }
  }

  .upcoming-empty p {
    font-size: 16px;
    color: var(--text-3);
  }

  .upcoming-empty a { color: var(--g400); font-weight: 600; }

  /* Événements passés : liste à plat, contraste normal */
  .past { margin-bottom: 112px; }

  .past-list {
    list-style: none;
    border-top: 1px solid var(--border-strong);
  }

  .past-row {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr) 140px;
    gap: 32px;
    align-items: baseline;
    padding: 28px 0;
    border-bottom: 1px solid var(--border);
  }

  .past-date {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }

  .past-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .past-name {
    font-size: 17px;
    font-weight: 600;
    color: var(--text);
  }

  .past-desc {
    font-size: 15px;
    color: var(--text-3);
    line-height: 1.7;
    max-width: 68ch;
  }

  .past-lieu {
    justify-self: end;
    font-size: 14px;
    color: var(--text-3);
  }

  /* Chiffres et événements passés en cascade (40ms) : la liste garde .reveal
     pour l'observer, mais ce sont ses éléments qui bougent */
  :global(.js) .events-stats.reveal,
  :global(.js) .past-list.reveal { opacity: 1; transform: none; transition: none; }
  :global(.js) .stat-item,
  :global(.js) .past-row {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 400ms var(--ease-out) var(--stagger, 0ms),
      transform 400ms var(--ease-out) var(--stagger, 0ms);
  }
  :global(.js) .events-stats.visible .stat-item,
  :global(.js) .past-list.visible .past-row { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .stat-item,
    :global(.js) .past-row {
      transform: none;
      transition: opacity 300ms ease var(--stagger, 0ms);
    }
  }

  @media (max-width: 900px) {
    .events { padding: 128px 0 80px; }
    .events-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); margin-bottom: 80px; }
    .upcoming, .past { margin-bottom: 80px; }
    .upcoming-card.has-thumb { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .upcoming-thumb { max-width: 440px; }
    .past-row { grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .past-lieu { justify-self: start; }
  }

  /* Mobile : chiffres en liste compacte (chiffre à gauche, libellé à droite) */
  @media (max-width: 580px) {
    .events-stats { grid-template-columns: minmax(0, 1fr); gap: 0; padding-top: 0; }
    .stat-item {
      flex-direction: row-reverse;
      justify-content: flex-end;
      align-items: baseline;
      gap: 16px;
      padding: 14px 0;
      border-bottom: 1px solid var(--border);
    }
    .stat-num { font-size: 32px; min-width: 32px; }
    /* Mobile : les infos et le bouton d'abord, l'affiche ensuite */
    .upcoming-thumb { max-width: none; order: 2; }
    .upcoming-cta { align-self: stretch; text-align: center; }
  }
</style>
