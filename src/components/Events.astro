---
import { EVENTS, getUpcomingEvents, getPastEvents, formatEventDate } from '../config/events.js';

const upcoming = getUpcomingEvents(EVENTS);
const past = getPastEvents(EVENTS, 4);

function getEventType(event: any): string {
  const t = event.title.toLowerCase();
  if (t.includes('stage')) return 'Stage';
  if (t.includes('tour') || t.includes('tournoi') || t.includes('daymat') || t.includes('compétition')) return 'Compétition';
  return 'Événement';
}

function getCity(location: string): string {
  if (!location) return '';
  const parts = location.split(',');
  return parts[parts.length - 1].trim().replace(/^\d{5}\s*/, '');
}

const stats = [
  { num: '4',  label: 'stages organisés' },
  { num: '2',  label: 'échanges inter-clubs' },
  { num: '3',  label: 'compétitions' },
  { num: '3',  label: 'médailles No-Gi' },
  { num: '1',  label: 'victoire MMA interclub' },
];
---

<section class="events" id="evenements">
  <div class="container">
    <div class="events-inner reveal">
      <div class="events-header">
        <p class="section-label">Nos événements</p>
        <h2 class="events-title">
          En mouvement<br/>
          <span>depuis 2023.</span>
        </h2>
      </div>

      <div class="events-stats">
        {stats.map((s, i) => (
          <div class={`stat-item reveal reveal-delay-${(i % 3) + 1}`}>
            <span class="stat-num">{s.num}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="upcoming reveal">
      <h3 class="upcoming-title">Prochains événements</h3>
      {upcoming.length > 0 ? (
        <div class="upcoming-list">
          {upcoming.map((e) => (
            <div class="upcoming-card">
              <div class="upcoming-date">{formatEventDate(e.date)}</div>
              <div class="upcoming-body">
                <span class="upcoming-type">{getEventType(e)}</span>
                <p class="upcoming-name">{e.title}</p>
                <p class="upcoming-desc">{e.description}</p>
              </div>
              <div class="upcoming-right">
                <div class="upcoming-lieu">{getCity(e.location)}</div>
                {e.registrationUrl && (
                  <a href={e.registrationUrl} target="_blank" rel="noopener noreferrer" class="upcoming-cta">S'inscrire</a>
                )}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="upcoming-empty">
          <p>Aucun événement programmé pour le moment.</p>
          <p>Reviens bientôt ou <a href="/contact">contacte-nous</a> pour en savoir plus.</p>
        </div>
      )}
    </div>

    {past.length > 0 && (
      <div class="past reveal">
        <h3 class="upcoming-title">Événements passés</h3>
        <div class="past-list">
          {past.map((e) => (
            <div class="past-card">
              <div class="past-date">{formatEventDate(e.date)}</div>
              <div class="upcoming-body">
                <span class="upcoming-type">{getEventType(e)}</span>
                <p class="upcoming-name">{e.title}</p>
                <p class="upcoming-desc">{e.description}</p>
              </div>
              <div class="upcoming-lieu">{getCity(e.location)}</div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .events {
    padding: 120px 0;
    position: relative;
  }

  .events::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
  }

  .events-inner {
    background: var(--bg1);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    padding: 64px 72px;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 64px;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .events-inner::before {
    content: '';
    position: absolute;
    top: -80px; right: -80px;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(34,197,94,0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .section-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--g500);
    margin-bottom: 16px;
  }

  .events-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .events-title span { color: var(--g400); }

  /* Stats */
  .events-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 24px 28px;
    border-left: 1px solid var(--border);
    position: relative;
    transition: background 0.3s;
  }

  .stat-item:hover {
    background: rgba(34,197,94,0.04);
  }

  .stat-item:nth-child(4),
  .stat-item:nth-child(5) {
    border-top: 1px solid var(--border);
  }

  .stat-item:nth-child(4) {
    grid-column: 1 / 2;
    border-left: 1px solid var(--border);
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 56px);
    font-weight: 800;
    color: var(--g400);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .stat-label {
    font-size: 14px;
    font-weight: 400;
    color: var(--text-3);
    line-height: 1.4;
  }

  /* Upcoming events */
  .upcoming {
    margin-top: 64px;
  }

  .upcoming-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.02em;
    margin-bottom: 24px;
  }

  .upcoming-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .upcoming-card {
    display: grid;
    grid-template-columns: 140px 1fr auto;
    align-items: center;
    gap: 24px;
    background: var(--bg1);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: 20px 28px;
    transition: border-color 0.2s, background 0.2s;
  }

  .upcoming-card:hover {
    border-color: var(--border-strong);
    background: var(--surface);
  }

  .upcoming-date {
    font-size: 14px;
    font-weight: 600;
    color: var(--g400);
    white-space: nowrap;
  }

  .upcoming-type {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--g500);
    background: rgba(34,197,94,0.08);
    border: 1px solid rgba(34,197,94,0.2);
    border-radius: 100px;
    padding: 2px 10px;
    margin-bottom: 6px;
  }

  .upcoming-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 4px;
  }

  .upcoming-desc {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .upcoming-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
    flex-shrink: 0;
  }

  .upcoming-lieu {
    font-size: 13px;
    color: var(--text-3);
    white-space: nowrap;
    text-align: right;
  }

  .upcoming-cta {
    font-size: 12px;
    font-weight: 600;
    color: var(--g400);
    border: 1px solid rgba(34,197,94,0.3);
    border-radius: 100px;
    padding: 4px 14px;
    transition: background 0.2s, color 0.2s;
    white-space: nowrap;
  }

  .upcoming-cta:hover {
    background: var(--g600);
    color: white;
    border-color: var(--g600);
  }

  .upcoming-empty {
    background: var(--bg1);
    border: 1px dashed var(--border);
    border-radius: var(--r-md);
    padding: 40px;
    text-align: center;
  }

  .upcoming-empty p {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .upcoming-empty a {
    color: var(--g400);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .past {
    margin-top: 48px;
  }

  .past-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .past-card {
    display: grid;
    grid-template-columns: 140px 1fr auto;
    align-items: center;
    gap: 24px;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: 16px 28px;
    opacity: 0.6;
    transition: opacity 0.2s;
  }

  .past-card:hover { opacity: 1; }

  .past-date {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .upcoming-card, .past-card {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .upcoming-lieu { text-align: left; }
  }

  @media (max-width: 1024px) {
    .events-inner {
      grid-template-columns: 1fr;
      gap: 48px;
      padding: 48px;
    }
  }

  @media (max-width: 640px) {
    .events-inner { padding: 32px 24px; }
    .events-stats { grid-template-columns: repeat(2, 1fr); }
    .stat-item:nth-child(4) { border-top: none; }
    .stat-item:nth-child(3),
    .stat-item:nth-child(5) { border-top: 1px solid var(--border); }
  }
</style>
