---
import { SCHEDULE, formatTimeDisplay } from '../config/schedule.js';

const days = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'];

const disciplineColors: Record<string, string> = {
  'MMA':        '#22c55e',
  'Luta Livre': '#86efac',
};

function getDiscipline(slot: any): string {
  if (slot.label === 'Luta Livre') return 'Luta Livre';
  return 'MMA';
}

function getDuration(start: string, end: string): string {
  const [sh, sm] = start.split(':').map(Number);
  const [eh, em] = end.split(':').map(Number);
  const mins = (eh * 60 + em) - (sh * 60 + sm);
  const h = Math.floor(mins / 60);
  const m = mins % 60;
  return h > 0 && m > 0 ? `${h}h${String(m).padStart(2, '0')}` : h > 0 ? `${h}h00` : `${m}min`;
}

const enriched = SCHEDULE.map((s: any) => ({
  ...s,
  discipline: getDiscipline(s),
  time: formatTimeDisplay(s.start),
  duration: getDuration(s.start, s.end),
}));

const byDay = days.map(day => ({
  day,
  slots: enriched.filter((s: any) => s.day === day),
}));
---

<section class="schedule" id="horaires">
  <div class="container">
    <div class="section-header reveal">
      <p class="section-label">Planning</p>
      <h2 class="section-title">
        Vos entraînements<br/>
        <span>cette semaine.</span>
      </h2>
    </div>

    <div class="schedule-grid">
      {byDay.map((col, i) => (
        <div class={`day-col reveal reveal-delay-${(i % 3) + 1}`}>
          <div class="day-header">
            <span class="day-name">{col.day}</span>
            <span class="day-count">{col.slots.length} séance{col.slots.length > 1 ? 's' : ''}</span>
          </div>

          <div class="day-slots">
            {col.slots.length === 0 ? (
              <div class="slot-empty">Repos</div>
            ) : (
              col.slots.map(slot => (
                <div class="slot" style={`--disc-color: ${disciplineColors[slot.discipline] ?? '#22c55e'}`}>
                  <div class="slot-time">{slot.time}</div>
                  <div class="slot-info">
                    <div class="slot-disc-row">
                      <span class="slot-disc">{slot.discipline}</span>
                      {slot.discipline === 'Luta Livre' && <span class="slot-nogi">No-Gi</span>}
                      {slot.label === 'Sparring' && <span class="slot-nogi">Sparring</span>}
                    </div>
                    <div class="slot-meta">
                      <span>{slot.level}</span>
                      <span class="meta-sep">·</span>
                      <span>{slot.duration}</span>
                    </div>
                  </div>
                </div>
              ))
            )}
          </div>
        </div>
      ))}
    </div>

    <div class="schedule-note reveal">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.2"/>
        <path d="M8 7.2v4M8 5.2v.8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      </svg>
      Planning indicatif — susceptible de modification. Nous rejoindre pour recevoir les mises à jour.
    </div>
  </div>
</section>

<style>
  .schedule {
    padding: 120px 0;
    position: relative;
  }

  .schedule::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 64px;
  }

  .section-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--g500);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .section-title span { color: var(--g400); }

  /* Grid */
  .schedule-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
    align-items: start;
  }

  .day-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .day-header {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0 0 12px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 4px;
  }

  .day-name {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .day-count {
    font-size: 13px;
    color: var(--text-muted);
    font-weight: 400;
  }

  .day-slots {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .slot-empty {
    font-size: 12px;
    color: var(--text-muted);
    font-style: italic;
    padding: 12px 0;
    text-align: center;
  }

  .slot {
    background: var(--bg1);
    border: 1px solid var(--border);
    border-left: 3px solid var(--disc-color, var(--g500));
    border-radius: var(--r-sm);
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }

  .slot:hover {
    background: var(--bg2);
    transform: translateX(2px);
  }

  .slot-time {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 800;
    color: var(--disc-color, var(--g500));
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .slot-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .slot-disc {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .slot-meta {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    color: var(--text-muted);
    font-weight: 400;
  }

  .meta-sep { opacity: 0.5; }

  .slot-disc-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .slot-nogi {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--bg);
    background: var(--disc-color, var(--g500));
    padding: 2px 6px;
    border-radius: 4px;
    line-height: 1.4;
  }

  .slot-members {
    border-left-color: var(--disc-color);
    opacity: 0.85;
  }

  .members-badge {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--g500);
    border: 1px solid rgba(34,197,94,0.25);
    padding: 2px 7px;
    border-radius: 4px;
    line-height: 1.4;
  }

  /* Note */
  .schedule-note {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 32px;
    font-size: 13px;
    color: var(--text-muted);
    font-weight: 400;
  }

  .schedule-note svg {
    flex-shrink: 0;
    color: var(--text-muted);
  }

  @media (max-width: 1100px) {
    .schedule-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 700px) {
    .schedule-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 480px) {
    .schedule-grid { grid-template-columns: 1fr; }
  }
</style>
