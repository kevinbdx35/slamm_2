---
import TrialCta from './TrialCta.astro';

interface Props {
  /** 'intro' : h1 + liste des disciplines · 'more' : vidéos, cours type, appel final */
  part: 'intro' | 'more';
}
const { part } = Astro.props;

const disciplines = [
  {
    name: 'MMA',
    full: 'Mixed Martial Arts',
    desc: 'La discipline reine : debout, clinch, sol. Un sport complet qui synthétise les meilleures techniques de combat du monde.',
    level: 'Tous niveaux',
    sessions: 'Lun · Mer · Ven',
  },
  {
    name: 'Sparring',
    full: 'Séance MMA · Mise en pratique',
    desc: 'La mise en pratique libre. Appliquer ses techniques dans des échanges encadrés, en toute sécurité et dans le respect de l\'adversaire.',
    level: 'Tous niveaux',
    sessions: 'Vendredi 20h',
  },
  {
    name: 'Luta Livre',
    full: 'Luta Livre · No-Gi',
    desc: 'Lutte brésilienne sans kimono. Soumissions, contrôles au sol, étranglements et clés articulaires : le grappling dans sa forme la plus pure.',
    level: 'Tous niveaux',
    sessions: 'Mardi 18h15',
  },
];

const steps = [
  { title: 'Échauffement', duration: '18-20 min', desc: 'Debout, clinch, sol, et les transitions entre chaque phase. Des drills spécifiques MMA pour monter le cardio, activer les muscles et préparer le corps à la séance technique.' },
  { title: 'Apprentissage technique', duration: '45-60 min', desc: 'Travail des techniques debout (frappes, déplacements) et au sol (contrôles, soumissions). On pratique par deux avec progressivité et bienveillance.' },
  { title: 'Mise en situation', duration: '15-20 min', desc: 'Sparring thématique autour de la technique travaillée en séance. On remet en contexte ce qu\'on vient d\'apprendre, dans un cadre contrôlé et bienveillant.' },
  { title: 'Retour au calme', duration: '10 min', desc: 'Étirements et récupération active. On termine en douceur pour favoriser la récupération musculaire et prévenir les courbatures.' },
];

const videos = [
  { id: 'M2v4ckiaHTk', title: 'MMA en vidéo', sub: 'Les premiers grades MMA selon la FMMAF.', alt: 'Premiers grades MMA - FMMAF' },
  { id: 'wC9kvJrO9aw', title: 'Luta Livre en vidéo', sub: 'Découvre la discipline en action : grappling No-Gi, soumissions et contrôles au sol.', alt: 'Présentation Luta Livre' },
];
---

{part === 'intro' && (
  <section class="disciplines disciplines-intro" id="disciplines">
    <div class="container">
      <div class="section-header">
        <h1 class="section-title">
          <span class="title-line"><span class="title-text">Deux disciplines,</span></span>{' '}
          <span class="title-line title-accent"><span class="title-text">une philosophie.</span></span>
        </h1>
        <p class="section-sub reveal reveal-delay-2">
          MMA technique, Sparring encadré, Luta Livre No-Gi : un programme cohérent
          pour progresser à tous les niveaux.
        </p>
      </div>

      <!-- Liste éditoriale : une ligne par discipline, un filet entre chaque -->
      <ul class="disc-list">
        {disciplines.map((d, i) => (
          <li class={`disc-row reveal reveal-delay-${i + 1}`}>
            <div class="disc-head">
              <h2 class="disc-name">{d.name}</h2>
              <p class="disc-full">{d.full}</p>
            </div>
            <p class="disc-desc">{d.desc}</p>
            <dl class="disc-meta">
              <div><dt class="sr-only">Niveau</dt><dd>{d.level}</dd></div>
              <div><dt class="sr-only">Créneaux</dt><dd class="disc-sessions">{d.sessions}</dd></div>
            </dl>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

{part === 'more' && (
  <section class="disciplines disciplines-more">
    <div class="container">
      <div class="videos-grid reveal">
        {videos.map(v => (
          <div class="video-item">
            <h2 class="block-title">{v.title}</h2>
            <p class="video-item-sub">{v.sub}</p>
            <div class="video-wrap">
              <div class="video-facade" data-id={v.id}>
                <img
                  src={`https://img.youtube.com/vi/${v.id}/maxresdefault.jpg`}
                  alt={v.alt}
                  class="video-thumb"
                  loading="lazy"
                />
                <button class="play-btn" aria-label="Lire la vidéo">
                  <svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#ff0000"/><path d="M45 24 27 14v20" fill="#fff"/></svg>
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="cours-type">
        <!-- En-tête empilé : titre puis texte -->
        <div class="cours-header reveal">
          <h2 class="cours-title">À quoi ressemble un cours ?</h2>
          <p class="cours-sub">Nos cours durent entre 1h15 et 2h selon le créneau. Voici un aperçu d'une séance type pour te rassurer si c'est ta première fois.</p>
        </div>
        <ol class="cours-steps reveal">
          {steps.map((st, i) => (
            <li class="cours-step" style={`--stagger: ${i * 60}ms`}>
              <span class="cours-duration">{st.duration}</span>
              <h3 class="cours-step-title">{st.title}</h3>
              <p class="cours-step-desc">{st.desc}</p>
            </li>
          ))}
        </ol>
      </div>

      <p class="faq-link reveal">
        Des questions ? Équipements, certificat médical, âge minimum, déroulement des cours…{' '}
        <a href="/faq">Voir la FAQ
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2.5 7h9M8 3.5l3.5 3.5L8 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </p>

      <TrialCta />
    </div>
  </section>
)}

<style>
  .disciplines { position: relative; }

  /* Première section de la page : dégage la nav fixe */
  .disciplines-intro { padding: 152px 0 104px; }
  .disciplines-more { padding: 112px 0; }

  .disciplines-more::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 720px;
    margin-bottom: 64px;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
    text-wrap: initial;
  }

  /* Chaque ligne est une fente, comme le titre du hero : le texte en sort
     par le bas au chargement. Marge de 0.08em (compensée) pour les accents. */
  .title-line {
    display: block;
    overflow: clip;
    padding-block: 0.08em;
    margin-block: -0.08em;
  }
  .title-text {
    display: block;
    animation: discLineReveal 600ms var(--ease-out) both;
  }
  .title-line:first-child .title-text { animation-delay: 60ms; }
  .title-accent .title-text { animation-delay: 120ms; }
  .title-accent { color: var(--g400); }

  @keyframes discLineReveal {
    from { transform: translateY(120%); }
    to   { transform: translateY(0); }
  }
  @keyframes discFade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .section-sub {
    font-size: 17px;
    color: var(--text-3);
    line-height: 1.7;
    max-width: 56ch;
  }

  /* Disciplines : nom (3) · description (5) · infos (3) */
  .disc-list {
    list-style: none;
    border-top: 1px solid var(--border-strong);
  }

  .disc-row {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 3fr);
    gap: 40px;
    align-items: baseline;
    padding: 36px 0;
    border-bottom: 1px solid var(--border);
  }

  .disc-name {
    font-family: var(--font-display);
    font-size: clamp(30px, 3.2vw, 40px);
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .disc-full {
    margin-top: 10px;
    font-size: 14px;
    font-weight: 500;
    color: var(--g400);
  }

  .disc-desc {
    font-size: 16px;
    color: var(--text-3);
    line-height: 1.7;
    max-width: 52ch;
  }

  .disc-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    justify-self: end;
    text-align: right;
    font-size: 14px;
    color: var(--text-muted);
  }

  .disc-sessions {
    font-weight: 600;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }

  /* Vidéos */
  .videos-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .video-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .block-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .video-item-sub {
    font-size: 15px;
    color: var(--text-3);
    line-height: 1.7;
    margin-bottom: 8px;
  }

  .video-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .video-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .video-facade {
    position: absolute;
    inset: 0;
    cursor: pointer;
  }

  .video-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 300ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .video-facade:hover .video-thumb {
      transform: scale(1.03);
    }
  }

  .play-btn {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: none;
    border: none;
    cursor: pointer;
    transition: transform 200ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .play-btn:hover {
      transform: scale(1.06);
    }
  }
  .play-btn:active { transform: scale(0.95); }

  /* Cours type : 4 colonnes à plat sous un filet */
  .cours-type {
    margin-top: 112px;
  }

  .cours-header {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 640px;
    margin-bottom: 48px;
  }

  .cours-title {
    font-family: var(--font-display);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .cours-sub {
    font-size: 16px;
    color: var(--text-3);
    line-height: 1.7;
  }

  .cours-steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
  }

  /* Filet en pseudo-élément (et non border-top) pour pouvoir le dessiner */
  .cours-step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 24px;
  }
  .cours-step::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: var(--border-strong);
    transform-origin: left;
  }

  /* Même geste que les valeurs d'About : filets dessinés, puis texte, en cascade */
  :global(.js) .cours-steps.reveal { opacity: 1; transform: none; transition: none; }
  :global(.js) .cours-step::before {
    transform: scaleX(0);
    transition: transform 500ms var(--ease-out) var(--stagger, 0ms);
  }
  :global(.js) .cours-step > * {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 400ms var(--ease-out) calc(var(--stagger, 0ms) + 150ms),
      transform 400ms var(--ease-out) calc(var(--stagger, 0ms) + 150ms);
  }
  :global(.js) .cours-steps.visible .cours-step::before { transform: scaleX(1); }
  :global(.js) .cours-steps.visible .cours-step > * { opacity: 1; transform: none; }

  .cours-duration {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--g400);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .cours-step-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
  }

  .cours-step-desc {
    font-size: 14px;
    color: var(--text-3);
    line-height: 1.7;
  }

  /* Lien FAQ en texte, puis la bande d'appel */
  .faq-link {
    margin: 96px 0 32px;
    font-size: 15px;
    color: var(--text-3);
  }

  .faq-link a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: 8px;
    font-weight: 600;
    color: var(--g400);
    white-space: nowrap;
    transition: transform 160ms var(--ease-out);
  }
  .faq-link svg { transition: transform 200ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .faq-link a:hover svg { transform: translateX(3px); }
  }
  .faq-link a:active { transform: scale(0.97); }

  /* Mouvement réduit : fondus seuls, filets déjà tracés, pas d'appui.
     Plus spécifique que la règle globale (*), qui sinon coupe le fondu du titre. */
  @media (prefers-reduced-motion: reduce) {
    .title-text { animation: discFade 300ms ease both !important; }
    :global(.js) .cours-step::before { transform: none; transition: none; }
    :global(.js) .cours-step > * {
      transform: none;
      transition: opacity 300ms ease var(--stagger, 0ms);
    }
    .play-btn, .faq-link a, .faq-link svg { transition: none; }
    .play-btn:active, .faq-link a:active, .faq-link a:hover svg { transform: none; }
  }

  @media (max-width: 900px) {
    .disciplines-intro { padding: 128px 0 80px; }
    .disciplines-more { padding: 80px 0; }
    .disc-row { grid-template-columns: minmax(0, 1fr); gap: 14px; padding: 28px 0; }
    .disc-meta { justify-self: start; text-align: left; flex-direction: row; gap: 16px; }
    .videos-grid { grid-template-columns: minmax(0, 1fr); gap: 48px; }
    .cours-type { margin-top: 80px; }
    .cours-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 24px; }
    .faq-link { margin-top: 72px; }
  }

  @media (max-width: 580px) {
    .cours-steps { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .faq-link a { margin-left: 0; margin-top: 8px; display: flex; }
  }
</style>

<script>
  // La miniature reste affichée pendant le chargement : l'iframe se pose
  // par-dessus en fondu, puis la miniature est retirée (pas d'écran noir).
  // Styles en ligne : les éléments créés en JS n'ont pas l'attribut de scope.
  document.querySelectorAll<HTMLElement>('.video-facade').forEach(facade => {
    facade.addEventListener('click', () => {
      if (facade.dataset.loading) return;
      facade.dataset.loading = 'true';
      const id = facade.dataset.id;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1`;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.title = facade.querySelector('img')?.alt ?? 'Vidéo YouTube';
      iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:none;opacity:0;transition:opacity 200ms cubic-bezier(0.23, 1, 0.32, 1)';

      let shown = false;
      const show = () => {
        if (shown) return;
        shown = true;
        iframe.style.opacity = '1';
        iframe.focus();
        setTimeout(() => facade.remove(), 250);
      };
      iframe.addEventListener('load', show, { once: true });
      setTimeout(show, 4000); // filet de sécurité si « load » n'arrive jamais
      facade.after(iframe);
    });
  });
</script>
