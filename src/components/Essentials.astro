---
import { PRICING, SEASON, REGISTRATION_OPENING_SOON, SCHEDULE, formatTimeDisplay } from '../config/schedule.js';
import { getFaqByIds } from '../config/faq.js';
import { ASSOCONNECT_URLS } from '../config/urls.js';

// ── Tarifs : prix de référence stable = adhésion annuelle plein tarif (Sept→Déc).
// On annonce le tarif plein ; le dégressif est présenté comme un avantage, pas un prix d'appel.
const annualPrice = PRICING.adult.periods[0].price;

// ── Horaires : aperçu compact des créneaux ──
const dayOrder = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'];
const dayShort: Record<string, string> = {
  Lundi: 'Lun', Mardi: 'Mar', Mercredi: 'Mer',
  Jeudi: 'Jeu', Vendredi: 'Ven', Samedi: 'Sam',
};
const slots = SCHEDULE.filter((s: any) => !s.inactive)
  .sort((a: any, b: any) =>
    dayOrder.indexOf(a.day) - dayOrder.indexOf(b.day) || a.start.localeCompare(b.start))
  .map((s: any) => ({
    day: dayShort[s.day] ?? s.day,
    time: `${formatTimeDisplay(s.start)}–${formatTimeDisplay(s.end)}`,
    label: s.label ?? 'MMA',
  }));

// ── mini-FAQ : 4 questions clés depuis la source unique ──
const faq = getFaqByIds(['experience', 'age', 'equipement', 'deroule']);
---

<section class="essentials" id="essentiel">
  <div class="container">

    <div class="section-header reveal">
      {REGISTRATION_OPENING_SOON && (
        <p class="notice">
          <span class="notice-dot" aria-hidden="true"></span>
          Inscriptions saison {SEASON} <strong>ouvertes très bientôt</strong> — tu peux déjà réserver ton cours d'essai.
        </p>
      )}
      <p class="section-label">L'essentiel</p>
      <h2 class="section-title">
        Tout ce qu'il faut savoir,<br/>
        <span>en un coup d'œil.</span>
      </h2>
      <p class="section-sub">Tarifs, créneaux et réponses aux questions les plus fréquentes — sans avoir à chercher.</p>
    </div>

    <div class="essentials-grid">

      <!-- Tarifs (aperçu) -->
      <div class="info-card reveal">
        <div class="info-head">
          <p class="info-label">Adhésion · saison {SEASON}</p>
          <h3 class="info-title info-price"><span>{annualPrice} €</span> <em>/ an</em></h3>
          <p class="info-note">Adhésion annuelle (+16 ans) · dégressif si tu rejoins en cours de saison</p>
        </div>
        <ul class="info-list">
          <li>Licence fédérale &amp; assurance incluses</li>
          <li>Accès à tous les cours</li>
          <li>Paiement en 3 fois par CB possible</li>
        </ul>
        <a href="/tarifs" class="info-link">
          Voir tous les tarifs
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2.5 7h9M8 3.5l3.5 3.5L8 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <!-- Horaires (aperçu) -->
      <div class="info-card reveal reveal-delay-2">
        <div class="info-head">
          <p class="info-label">Créneaux</p>
          <h3 class="info-title">Vos <span>entraînements</span></h3>
          <p class="info-note">Tous niveaux · à Saint-Lunaire</p>
        </div>
        <ul class="slot-list">
          {slots.map(s => (
            <li class="slot-row">
              <span class="slot-day">{s.day}</span>
              <span class="slot-time">{s.time}</span>
              <span class="slot-label">{s.label}</span>
            </li>
          ))}
        </ul>
        <a href="/disciplines#horaires" class="info-link">
          Détail des créneaux
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2.5 7h9M8 3.5l3.5 3.5L8 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

    </div>

    <!-- mini-FAQ -->
    <div class="mini-faq reveal">
      <div class="mini-faq-head">
        <h3 class="mini-faq-title">Les questions qu'on nous pose le plus</h3>
        <a href="/faq" class="info-link">
          Voir toute la FAQ
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2.5 7h9M8 3.5l3.5 3.5L8 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
      <div class="accordion">
        {faq.map((item, i) => (
          <details class="accordion-item" name="home-faq">
            <summary class="accordion-summary">
              <span>{item.q}</span>
              <svg class="accordion-icon" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M4 7l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <div class="accordion-body">
              <p>{item.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="essentials-cta reveal">
      <div class="cta-body">
        <p class="cta-title">Prêt à essayer ?</p>
        <p class="cta-desc">2 cours d'essai pour te lancer — gratuits en début de saison, sans engagement.</p>
      </div>
      <a href={ASSOCONNECT_URLS.TRIAL_BOOKING} target="_blank" rel="noopener noreferrer" class="cta-btn">
        Réserver un cours d'essai
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
  .essentials {
    padding: 120px 0;
    position: relative;
  }

  .essentials::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
  }

  /* En-tête (même patron que les autres sections) */
  .section-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 48px;
  }

  .notice {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--text-2);
    background: rgba(34,197,94,0.06);
    border: 1px solid rgba(34,197,94,0.2);
    border-radius: 100px;
    padding: 9px 18px;
  }

  .notice strong { color: var(--g400); font-weight: 700; }

  .notice-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--g500);
    flex-shrink: 0;
    animation: notice-pulse 2s ease-out infinite;
  }

  @keyframes notice-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(34,197,94,0.45); }
    70%  { box-shadow: 0 0 0 8px rgba(34,197,94,0); }
    100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .notice-dot { animation: none; }
  }

  .section-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--g500);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .section-title span { color: var(--g400); }

  .section-sub {
    font-size: 16px;
    color: var(--text-3);
    line-height: 1.7;
    max-width: 560px;
  }

  /* Grille tarifs + horaires */
  .essentials-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 24px;
  }

  .info-card {
    background: var(--bg1);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .info-head {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .info-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .info-title {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text);
    line-height: 1.1;
  }

  .info-title span { color: var(--g400); }

  /* Prix — Inter (lisible) + chiffres tabulaires, comme la page Tarifs */
  .info-price {
    font-family: var(--font-body);
    font-size: 40px;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .info-title em {
    font-style: normal;
    font-size: 16px;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0;
  }

  .info-note {
    font-size: 13px;
    color: var(--text-muted);
  }

  .info-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .info-list li {
    position: relative;
    padding-left: 22px;
    font-size: 14px;
    color: var(--text-3);
    line-height: 1.5;
  }

  .info-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 7px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--g500);
  }

  /* Liste horaires */
  .slot-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .slot-row {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    font-size: 14px;
  }

  .slot-row:last-child { border-bottom: none; }

  .slot-day {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--text);
  }

  .slot-time {
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }

  .slot-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--g400);
    letter-spacing: 0.02em;
  }

  /* Lien "voir le détail" */
  .info-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--g400);
    transition: gap 0.2s var(--ease-out);
    margin-top: auto;
    align-self: flex-start;
  }

  .info-link:hover { gap: 12px; }
  .info-link svg { flex-shrink: 0; }

  /* mini-FAQ */
  .mini-faq {
    background: var(--bg1);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    padding: 36px;
    margin-bottom: 24px;
  }

  .mini-faq-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .mini-faq-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .mini-faq .info-link { margin-top: 0; }

  .accordion {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .accordion-item { border-bottom: 1px solid var(--border); }
  .accordion-item:last-child { border-bottom: none; }

  .accordion-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 22px;
    cursor: pointer;
    list-style: none;
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
    background: var(--bg1);
    transition: background 0.2s, color 0.2s;
    user-select: none;
  }

  .accordion-summary::-webkit-details-marker { display: none; }

  .accordion-summary:hover {
    background: var(--surface);
    color: var(--g400);
  }

  .accordion-item[open] .accordion-summary {
    color: var(--g400);
    background: var(--surface);
  }

  .accordion-icon {
    flex-shrink: 0;
    color: var(--text-muted);
    transition: transform 0.3s var(--ease-out);
  }

  .accordion-item[open] .accordion-icon {
    transform: rotate(180deg);
    color: var(--g400);
  }

  .accordion-body {
    padding: 0 22px 18px;
    background: var(--surface);
  }

  .accordion-body p {
    font-size: 14px;
    color: var(--text-3);
    line-height: 1.8;
    border-top: 1px solid var(--border);
    padding-top: 16px;
  }

  /* CTA */
  .essentials-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    background: rgba(34,197,94,0.05);
    border: 1px solid rgba(34,197,94,0.18);
    border-radius: var(--r-xl);
    padding: 28px 36px;
  }

  .cta-title {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.02em;
    margin-bottom: 4px;
  }

  .cta-desc {
    font-size: 14px;
    color: var(--text-3);
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--bg);
    background: var(--g500);
    padding: 12px 24px;
    border-radius: 100px;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.2s, transform 0.2s;
  }

  .cta-btn:hover {
    background: var(--g400);
    transform: translateY(-1px);
  }

  .cta-btn svg { flex-shrink: 0; }

  @media (max-width: 860px) {
    .essentials-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .info-card, .mini-faq { padding: 28px 22px; }
    .essentials-cta { flex-direction: column; align-items: flex-start; padding: 24px 22px; }
    .accordion-summary { padding: 16px 18px; font-size: 14px; }
    .accordion-body { padding: 0 18px 16px; }
  }
</style>
