---
import { PRICING, SEASON, REGISTRATION_OPENING_SOON, SCHEDULE, FINANCIAL_AID, formatTimeDisplay } from '../config/schedule.js';
import { getFaqByIds } from '../config/faq.js';
import TrialCta from './TrialCta.astro';

// ── Tarifs : prix de référence stable = adhésion annuelle plein tarif (Sept→Déc).
// On annonce le tarif plein ; le dégressif est présenté comme un avantage, pas un prix d'appel.
const annualPrice = PRICING.adult.periods[0].price;

// ── Horaires : aperçu compact des créneaux ──
const dayOrder = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'];
const dayShort: Record<string, string> = {
  Lundi: 'Lun', Mardi: 'Mar', Mercredi: 'Mer',
  Jeudi: 'Jeu', Vendredi: 'Ven', Samedi: 'Sam',
};
const slots = SCHEDULE.filter((s: any) => !s.inactive)
  .sort((a: any, b: any) =>
    dayOrder.indexOf(a.day) - dayOrder.indexOf(b.day) || a.start.localeCompare(b.start))
  .map((s: any) => ({
    day: dayShort[s.day] ?? s.day,
    time: `${formatTimeDisplay(s.start)}-${formatTimeDisplay(s.end)}`,
    label: s.label ?? 'MMA',
  }));

// ── mini-FAQ : 4 questions clés depuis la source unique ──
const faq = getFaqByIds(['experience', 'age', 'equipement', 'deroule']);
---

<section class="essentials" id="essentiel">
  <div class="container">

    <div class="section-header reveal">
      {REGISTRATION_OPENING_SOON && (
        <p class="notice">
          <span class="notice-dot" aria-hidden="true"></span>
          Inscriptions saison {SEASON} <strong>ouvertes très bientôt</strong>. Tu peux déjà réserver ton cours d'essai.
        </p>
      )}
      <h2 class="section-title">
        Tout ce qu'il faut savoir,<br/>
        <span>en un coup d'œil.</span>
      </h2>
    </div>

    <div class="essentials-grid">

      <!-- Tarifs (aperçu) -->
      <div class="info-col reveal">
        <div class="info-head">
          <p class="info-label">Adhésion · saison {SEASON}</p>
          <h3 class="info-title info-price"><span>{annualPrice} €</span> <em>/ an</em></h3>
          <p class="info-note">Adhésion (+16 ans) de la rentrée à fin juin · tu ne paies que les mois restants si tu rejoins en cours de saison</p>
        </div>
        <ul class="info-list">
          <li><svg class="check" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8l3.5 3.5L13 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>Licence fédérale &amp; assurance incluses</li>
          <li><svg class="check" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8l3.5 3.5L13 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>Accès à tous les cours</li>
          <li><svg class="check" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8l3.5 3.5L13 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>Paiement en 3 fois par CB possible</li>
          <li><svg class="check" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8l3.5 3.5L13 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{FINANCIAL_AID.short}</li>
        </ul>
        <a href="/tarifs/" class="info-link">
          Voir tous les tarifs
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2.5 7h9M8 3.5l3.5 3.5L8 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <!-- Horaires (aperçu) -->
      <div class="info-col reveal reveal-delay-1">
        <div class="info-head">
          <p class="info-label">Créneaux</p>
          <h3 class="info-title">Tes entraînements</h3>
          <p class="info-note">Tous niveaux · à Saint-Lunaire</p>
        </div>
        <ul class="slot-list">
          {slots.map(s => (
            <li class="slot-row">
              <span class="slot-day">{s.day}</span>
              <span class="slot-time">{s.time}</span>
              <span class="slot-label">{s.label}</span>
            </li>
          ))}
        </ul>
        <a href="/disciplines/#horaires" class="info-link">
          Détail des créneaux
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2.5 7h9M8 3.5l3.5 3.5L8 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

    </div>

    <!-- mini-FAQ -->
    <div class="mini-faq reveal">
      <div class="mini-faq-head">
        <h3 class="mini-faq-title">Les questions qu'on nous pose le plus</h3>
        <a href="/faq/" class="info-link">
          Voir toute la FAQ
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2.5 7h9M8 3.5l3.5 3.5L8 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
      <div class="accordion">
        {faq.map((item, i) => (
          <details class="accordion-item" name="home-faq">
            <summary class="accordion-summary">
              <span>{item.q}</span>
              <svg class="accordion-icon" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M4 7l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <div class="accordion-body">
              <p>{item.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>

    <!-- CTA (composant partagé) -->
    <TrialCta />

  </div>
</section>

<style>
  .essentials {
    padding: 112px 0;
    position: relative;
  }

  .essentials::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
  }

  /* En-tête (même patron que les autres sections) */
  .section-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 48px;
  }

  .notice {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--text-2);
    background: rgba(34,197,94,0.06);
    border: 1px solid rgba(34,197,94,0.2);
    border-radius: 100px;
    padding: 9px 18px;
  }

  .notice strong { color: var(--g400); font-weight: 700; }

  .notice-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--g500);
    flex-shrink: 0;
  }

  /* Halo en scale + opacity (composité) plutôt qu'en box-shadow (repeint à
     chaque image), puisque l'animation tourne en continu */
  .notice-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--g500);
    animation: notice-pulse 2s ease-out infinite;
  }

  @keyframes notice-pulse {
    0%        { transform: scale(1); opacity: 0.45; }
    70%, 100% { transform: scale(3); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .notice-dot::after { animation: none; opacity: 0; }
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .section-title span { color: var(--g400); }


  /* Tarifs + horaires : deux colonnes à plat, séparées par un filet vertical */
  .essentials-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--border-strong);
  }

  .info-col {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 36px 48px 8px 0;
  }

  .info-col + .info-col {
    padding: 36px 0 8px 48px;
    border-left: 1px solid var(--border);
  }

  .info-head {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .info-label {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .info-title {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text);
    line-height: 1.1;
  }

  .info-title span { color: var(--g400); }

  /* Prix : police des titres, chiffres tabulaires */
  .info-price {
    font-size: 56px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .info-title em {
    font-style: normal;
    font-size: 16px;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0;
  }

  .info-note {
    font-size: 13px;
    color: var(--text-muted);
  }

  .info-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .info-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 15px;
    color: var(--text-3);
    line-height: 1.5;
  }

  .info-list .check {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--g400);
  }

  /* Liste horaires */
  /* Tableau à plat : filets entre les lignes, pas de cadre */
  .slot-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .slot-row {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 13px 0;
    border-bottom: 1px solid var(--border);
    font-size: 15px;
  }

  .slot-row:last-child { border-bottom: none; }

  .slot-day {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--text);
  }

  .slot-time {
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }

  .slot-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--g400);
    letter-spacing: 0.02em;
  }

  /* Lien "voir le détail" */
  .info-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--g400);
    transition: transform 160ms var(--ease-out);
    margin-top: auto;
    align-self: flex-start;
  }

  /* La flèche glisse (transform) au lieu d'élargir le gap (relayout) */
  .info-link svg {
    flex-shrink: 0;
    transition: transform 200ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .info-link:hover svg { transform: translateX(3px); }
  }
  .info-link:active { transform: scale(0.97); }

  /* mini-FAQ */
  /* mini-FAQ sans conteneur : l'accordéon suffit à grouper */
  /* Deux colonnes : titre + lien à gauche (4/12), accordéon à droite (8/12) */
  .mini-faq {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 48px;
    align-items: start;
    margin: 96px 0;
  }

  .mini-faq-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .mini-faq-title {
    font-family: var(--font-display);
    line-height: 1.2;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .mini-faq .info-link { margin-top: 0; }

  .accordion {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-strong);
  }

  .accordion-item { border-bottom: 1px solid var(--border); }

  .accordion-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
    font-size: 16px;
    font-weight: 500;
    color: var(--text);
    user-select: none;
  }

  .accordion-summary::-webkit-details-marker { display: none; }

  .accordion-item[open] .accordion-summary {
    color: var(--g400);
  }

  .accordion-icon {
    flex-shrink: 0;
    color: var(--text-muted);
  }

  /* Rotation, survol, appui et fondu de la réponse : dans Layout.astro
     (comportement partagé avec /faq) */
  .accordion-item[open] .accordion-icon { color: var(--g400); }

  .accordion-body {
    padding: 0 40px 22px 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .info-link, .info-link svg { transition: none; }
    .info-link:hover svg, .info-link:active { transform: none; }
  }

  .accordion-body p {
    font-size: 15px;
    color: var(--text-3);
    line-height: 1.8;
    max-width: 62ch;
  }

  /* CTA */
  @media (max-width: 860px) {
    .essentials-grid { grid-template-columns: minmax(0, 1fr); }
    .info-col,
    .info-col + .info-col { padding: 32px 0; border-left: none; }
    .info-col + .info-col { border-top: 1px solid var(--border); }
    .mini-faq { grid-template-columns: minmax(0, 1fr); gap: 24px; margin: 64px 0; }
  }

  @media (max-width: 600px) {
    .info-title:not(.info-price) { font-size: 22px; }
    .info-price { font-size: 48px; }
    .accordion-summary { padding: 18px 0; font-size: 15px; }
    .accordion-body { padding: 0 0 18px; }
  }
</style>
