---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { FAQ_CATEGORIES as categories } from '../config/faq.js';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: "Faut-il avoir de l'expérience pour commencer le MMA ?", acceptedAnswer: { '@type': 'Answer', text: "Non, aucune expérience n'est nécessaire. Nos cours sont ouverts à tous les niveaux." } },
    { '@type': 'Question', name: "À partir de quel âge peut-on pratiquer le MMA ?", acceptedAnswer: { '@type': 'Answer', text: "L'âge minimum pour adhérer à notre association est de 16 ans." } },
    { '@type': 'Question', name: "Y a-t-il des femmes au club ?", acceptedAnswer: { '@type': 'Answer', text: "Oui ! Nous accueillons des femmes et des hommes de tous niveaux." } },
    { '@type': 'Question', name: "Quel équipement est nécessaire pour débuter ?", acceptedAnswer: { '@type': 'Answer', text: "Pour venir essayer : une tenue de sport, une bouteille d'eau. Ensuite : gants, protège-tibias, protège-dents et coquille." } },
    { '@type': 'Question', name: "Peut-on venir observer un cours sans s'inscrire ?", acceptedAnswer: { '@type': 'Answer', text: "Oui, tu peux venir observer un cours gratuitement sans engagement." } },
    { '@type': 'Question', name: "Comment s'inscrire aux cours d'essai ?", acceptedAnswer: { '@type': 'Answer', text: "2 cours d'essai gratuits en début de saison (septembre-octobre), ou 5€ par séance en cours d'année, déductibles si inscription." } },
    { '@type': 'Question', name: "Faut-il un certificat médical ?", acceptedAnswer: { '@type': 'Answer', text: "Oui, un certificat médical de non contre-indication à la pratique du MMA datant de moins d'un an est obligatoire à l'inscription." } },
    { '@type': 'Question', name: "Le MMA est-il dangereux ?", acceptedAnswer: { '@type': 'Answer', text: "Encadré par nos coachs diplômés, avec équipement adapté et règles de sécurité strictes, la pratique reste maîtrisée." } },
  ],
};

import TrialCta from '../components/TrialCta.astro';
---

<Layout
  title="FAQ — Saint-Lunaire MMA"
  description="Toutes tes questions sur le MMA à Saint-Lunaire : âge minimum, équipement, certificat médical, cours d'essai. Club accessible depuis Dinard, Saint-Malo, Côte d'Émeraude."
  pageSchema={faqSchema}
>
  <Nav />
  <main id="main">
    <section class="faq">
      <div class="container">

        <div class="faq-header reveal">
          <h1 class="faq-title">
            Toutes les réponses<br/>
            <span>avant de te lancer.</span>
          </h1>
        </div>

        <div class="faq-body">
          {categories.map((cat, ci) => (
            <div class={`faq-category reveal reveal-delay-${ci + 1}`}>
              <div class="cat-head">
                <h2 class="cat-title">{cat.title}</h2>
              </div>
              <div class="accordion">
                {cat.questions.map((item, qi) => (
                  <details class="accordion-item" name={`cat-${ci}`}>
                    <summary class="accordion-summary">
                      <span>{item.q}</span>
                      <svg class="accordion-icon" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                        <path d="M4 7l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </summary>
                    <div class="accordion-body">
                      <p>{item.a}</p>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          ))}
        </div>

        <p class="faq-contact reveal">
          Question non répondue ? Contacte-nous, on te répond sous 24h.{' '}
          <a href="/contact">Nous contacter
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2.5 7h9M8 3.5l3.5 3.5L8 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </p>

        <TrialCta />

      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* Première section de la page : dégage la nav fixe */
  .faq {
    padding: 152px 0 112px;
  }

  /* En-tête empilé : titre puis texte */
  .faq-header {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 720px;
    margin-bottom: 72px;
  }

  .faq-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .faq-title span { color: var(--g400); }


  .faq-body {
    display: flex;
    flex-direction: column;
    gap: 80px;
    margin-bottom: 96px;
  }

  /* Catégorie : titre (4/12, reste visible au défilement) + questions (8/12) */
  .faq-category {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 48px;
    align-items: start;
  }

  .cat-head {
    position: sticky;
    top: 104px;
  }

  .cat-title {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 800;
    line-height: 1.2;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  /* Accordéon à plat, identique à l'accueil */
  .accordion {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-strong);
  }

  .accordion-item {
    border-bottom: 1px solid var(--border);
  }

  .accordion-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
    font-size: 16px;
    font-weight: 500;
    color: var(--text);
    transition: background 0.2s, color 0.2s;
    user-select: none;
  }

  .accordion-summary::-webkit-details-marker { display: none; }

  .accordion-summary:hover {
    color: var(--g400);
  }

  .accordion-item[open] .accordion-summary {
    color: var(--g400);
  }

  .accordion-icon {
    flex-shrink: 0;
    color: var(--text-muted);
    transition: transform 250ms var(--ease-out), color 200ms ease;
  }

  .accordion-item[open] .accordion-icon {
    transform: rotate(180deg);
    color: var(--g400);
  }

  .accordion-body {
    padding: 0 40px 22px 0;
  }

  .accordion-body p {
    font-size: 15px;
    color: var(--text-3);
    line-height: 1.8;
    max-width: 62ch;
  }

  /* Contact en ligne de texte, puis la bande d'appel */
  .faq-contact {
    margin-bottom: 32px;
    font-size: 15px;
    color: var(--text-3);
  }

  .faq-contact a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: 8px;
    font-weight: 600;
    color: var(--g400);
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .faq { padding: 128px 0 80px; }
    .faq-category { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .cat-head { position: static; }
    .faq-body { gap: 56px; margin-bottom: 72px; }
  }

  @media (max-width: 600px) {
    .accordion-summary { padding: 18px 0; font-size: 15px; }
    .accordion-body { padding: 0 0 18px; }
    .faq-contact a { display: flex; margin: 8px 0 0; }
  }
</style>
