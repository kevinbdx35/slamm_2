---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { FAQ_CATEGORIES as categories } from '../config/faq.js';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: "Faut-il avoir de l'expérience pour commencer le MMA ?", acceptedAnswer: { '@type': 'Answer', text: "Non, aucune expérience n'est nécessaire. Nos cours sont ouverts à tous les niveaux." } },
    { '@type': 'Question', name: "À partir de quel âge peut-on pratiquer le MMA ?", acceptedAnswer: { '@type': 'Answer', text: "L'âge minimum pour adhérer à notre association est de 16 ans." } },
    { '@type': 'Question', name: "Y a-t-il des femmes au club ?", acceptedAnswer: { '@type': 'Answer', text: "Oui ! Nous accueillons des femmes et des hommes de tous niveaux." } },
    { '@type': 'Question', name: "Quel équipement est nécessaire pour débuter ?", acceptedAnswer: { '@type': 'Answer', text: "Pour venir essayer : une tenue de sport, une bouteille d'eau. Ensuite : gants, protège-tibias, protège-dents et coquille." } },
    { '@type': 'Question', name: "Peut-on venir observer un cours sans s'inscrire ?", acceptedAnswer: { '@type': 'Answer', text: "Oui, tu peux venir observer un cours gratuitement sans engagement." } },
    { '@type': 'Question', name: "Comment s'inscrire aux cours d'essai ?", acceptedAnswer: { '@type': 'Answer', text: "2 cours d'essai gratuits en début de saison (septembre–octobre), ou 5€ par séance en cours d'année, déductibles si inscription." } },
    { '@type': 'Question', name: "Faut-il un certificat médical ?", acceptedAnswer: { '@type': 'Answer', text: "Oui, un certificat médical de non contre-indication à la pratique du MMA datant de moins d'un an est obligatoire à l'inscription." } },
    { '@type': 'Question', name: "Le MMA est-il dangereux ?", acceptedAnswer: { '@type': 'Answer', text: "Encadré par nos coachs diplômés, avec équipement adapté et règles de sécurité strictes, la pratique reste maîtrisée." } },
  ],
};

---

<Layout
  title="FAQ — Saint-Lunaire MMA"
  description="Toutes tes questions sur le MMA à Saint-Lunaire : âge minimum, équipement, certificat médical, cours d'essai. Club accessible depuis Dinard, Saint-Malo, Côte d'Émeraude."
  pageSchema={faqSchema}
>
  <Nav />
  <main id="main">
    <section class="faq">
      <div class="container">

        <div class="faq-header reveal">
          <p class="section-label">Questions fréquentes</p>
          <h1 class="faq-title">
            Toutes les réponses<br/>
            <span>avant de te lancer.</span>
          </h1>
          <p class="faq-sub">Toutes les réponses à tes questions sur la pratique du MMA au sein de notre association.</p>
        </div>

        <div class="faq-body">
          {categories.map((cat, ci) => (
            <div class={`faq-category reveal reveal-delay-${ci + 1}`}>
              <h2 class="cat-title">{cat.title}</h2>
              <div class="accordion">
                {cat.questions.map((item, qi) => (
                  <details class="accordion-item" name={`cat-${ci}`}>
                    <summary class="accordion-summary">
                      <span>{item.q}</span>
                      <svg class="accordion-icon" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                        <path d="M4 7l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </summary>
                    <div class="accordion-body">
                      <p>{item.a}</p>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          ))}
        </div>

        <div class="faq-cta reveal">
          <div class="faq-cta-body">
            <p class="faq-cta-title">Question non répondue ?</p>
            <p class="faq-cta-desc">Contacte-nous, on te répond sous 24h.</p>
          </div>
          <a href="/contact" class="faq-cta-btn">
            Nous contacter
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .faq {
    padding: 120px 0 80px;
    position: relative;
  }

  .faq::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
  }

  .faq-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: end;
    margin-bottom: 72px;
  }

  .section-label {
    grid-column: 1 / -1;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--g500);
  }

  .faq-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .faq-title span { color: var(--g400); }

  .faq-sub {
    font-size: 16px;
    color: var(--text-3);
    line-height: 1.7;
    align-self: end;
  }

  .faq-body {
    display: flex;
    flex-direction: column;
    gap: 56px;
    margin-bottom: 56px;
  }

  .cat-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.02em;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }

  /* Accordion */
  .accordion {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .accordion-item {
    border-bottom: 1px solid var(--border);
  }

  .accordion-item:last-child { border-bottom: none; }

  .accordion-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    cursor: pointer;
    list-style: none;
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
    background: var(--bg1);
    transition: background 0.2s, color 0.2s;
    user-select: none;
  }

  .accordion-summary::-webkit-details-marker { display: none; }

  .accordion-summary:hover {
    background: var(--surface);
    color: var(--g400);
  }

  .accordion-item[open] .accordion-summary {
    color: var(--g400);
    background: var(--surface);
  }

  .accordion-icon {
    flex-shrink: 0;
    color: var(--text-muted);
    transition: transform 0.3s var(--ease-out);
  }

  .accordion-item[open] .accordion-icon {
    transform: rotate(180deg);
    color: var(--g400);
  }

  .accordion-body {
    padding: 0 24px 20px;
    background: var(--surface);
  }

  .accordion-body p {
    font-size: 14px;
    color: var(--text-3);
    line-height: 1.8;
    border-top: 1px solid var(--border);
    padding-top: 16px;
  }

  /* CTA */
  .faq-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    background: var(--bg1);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 28px 36px;
  }

  .faq-cta-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 4px;
  }

  .faq-cta-desc {
    font-size: 14px;
    color: var(--text-muted);
  }

  .faq-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--bg);
    background: var(--g500);
    padding: 10px 22px;
    border-radius: 100px;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.2s, transform 0.2s;
  }

  .faq-cta-btn:hover {
    background: var(--g400);
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    .faq-header { grid-template-columns: 1fr; gap: 20px; }
    .faq-cta { flex-direction: column; align-items: flex-start; }
    .accordion-summary { padding: 16px 18px; font-size: 14px; }
    .accordion-body { padding: 0 18px 16px; }
  }
</style>
