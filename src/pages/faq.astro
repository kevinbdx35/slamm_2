---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import TrialCta from '../components/TrialCta.astro';
import { FAQ_CATEGORIES as categories } from '../config/faq.js';

// JSON-LD construit depuis la source unique (config/faq.js) : le balisage
// reprend exactement les questions et réponses affichées sur la page
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: categories.flatMap((cat) =>
    cat.questions.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    }))
  ),
};
---

<Layout
  title="FAQ — Saint-Lunaire MMA"
  description="Toutes tes questions sur le MMA à Saint-Lunaire : âge minimum, équipement, certificat médical, cours d'essai. Club accessible depuis Dinard, Saint-Malo, Côte d'Émeraude."
  pageSchema={faqSchema}
>
  <Nav />
  <main id="main">
    <section class="faq">
      <div class="container">

        <div class="faq-header">
          <h1 class="faq-title">
            <span class="title-slot"><span class="title-slot-text">Toutes les réponses</span></span>{' '}
            <span class="title-slot title-accent"><span class="title-slot-text">avant de te lancer.</span></span>
          </h1>
        </div>

        <div class="faq-body">
          {categories.map((cat, ci) => (
            <div class={`faq-category reveal reveal-delay-${ci + 1}`}>
              <div class="cat-head">
                <h2 class="cat-title">{cat.title}</h2>
              </div>
              <div class="accordion">
                {cat.questions.map((item, qi) => (
                  <details class="accordion-item" name={`cat-${ci}`}>
                    <summary class="accordion-summary">
                      <span>{item.q}</span>
                      <svg class="accordion-icon" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                        <path d="M4 7l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </summary>
                    <div class="accordion-body">
                      <p>{item.a}</p>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          ))}
        </div>

        <p class="faq-contact reveal">
          Question non répondue ? Contacte-nous, on te répond sous 24h.{' '}
          <a href="/contact/">Nous contacter
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2.5 7h9M8 3.5l3.5 3.5L8 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </p>

        <TrialCta />

      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* Première section de la page : dégage la nav fixe */
  .faq {
    padding: 152px 0 112px;
  }

  /* En-tête empilé : titre puis texte */
  .faq-header {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 720px;
    margin-bottom: 72px;
  }

  .faq-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .faq-title .title-accent { color: var(--g400); }


  .faq-body {
    display: flex;
    flex-direction: column;
    gap: 80px;
    margin-bottom: 96px;
  }

  /* Catégorie : titre (4/12, reste visible au défilement) + questions (8/12) */
  .faq-category {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 48px;
    align-items: start;
  }

  .cat-head {
    position: sticky;
    top: 104px;
  }

  .cat-title {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 800;
    line-height: 1.2;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  /* Accordéon à plat, identique à l'accueil */
  .accordion {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-strong);
  }

  .accordion-item {
    border-bottom: 1px solid var(--border);
  }

  .accordion-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
    font-size: 16px;
    font-weight: 500;
    color: var(--text);
    user-select: none;
  }

  .accordion-summary::-webkit-details-marker { display: none; }

  .accordion-item[open] .accordion-summary {
    color: var(--g400);
  }

  .accordion-icon {
    flex-shrink: 0;
    color: var(--text-muted);
  }

  /* Rotation, survol, appui et fondu de la réponse : dans Layout.astro */
  .accordion-item[open] .accordion-icon { color: var(--g400); }

  .accordion-body {
    padding: 0 40px 22px 0;
  }

  .accordion-body p {
    font-size: 15px;
    color: var(--text-3);
    line-height: 1.8;
    max-width: 62ch;
  }

  /* Contact en ligne de texte, puis la bande d'appel */
  .faq-contact {
    margin-bottom: 32px;
    font-size: 15px;
    color: var(--text-3);
  }

  .faq-contact a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: 8px;
    font-weight: 600;
    color: var(--g400);
    white-space: nowrap;
    transition: transform 160ms var(--ease-out);
  }

  /* Même geste que les liens « Voir tous les tarifs » de l'accueil */
  .faq-contact svg { transition: transform 200ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .faq-contact a:hover svg { transform: translateX(3px); }
  }
  .faq-contact a:active { transform: scale(0.97); }

  @media (prefers-reduced-motion: reduce) {
    .faq-contact a, .faq-contact svg { transition: none; }
    .faq-contact a:hover svg, .faq-contact a:active { transform: none; }
  }

  @media (max-width: 900px) {
    .faq { padding: 128px 0 80px; }
    .faq-category { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .cat-head { position: static; }
    .faq-body { gap: 56px; margin-bottom: 72px; }
  }

  @media (max-width: 600px) {
    .accordion-summary { padding: 18px 0; font-size: 15px; }
    .accordion-body { padding: 0 0 18px; }
    .faq-contact a { display: flex; margin: 8px 0 0; }
  }
</style>
