---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Events from '../components/Events.astro';
import Footer from '../components/Footer.astro';
import { EVENTS, getUpcomingEvents } from '../config/events.js';

const upcomingEvents = getUpcomingEvents(EVENTS);
const eventsSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: upcomingEvents.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SportsEvent',
      name: e.title,
      startDate: e.date,
      location: {
        '@type': 'Place',
        name: e.location,
      },
      description: e.description,
      organizer: {
        '@type': 'SportsClub',
        name: 'Saint-Lunaire Arts Martiaux Mixtes',
        url: 'https://mma-saint-lunaire.fr',
      },
      ...(e.performer ? { performer: { '@type': 'Person', name: e.performer } } : {}),
    },
  })),
};
---

<Layout
  title="Événements — Saint-Lunaire MMA"
  description="Retrouvez tous les événements, compétitions et stages du club Saint-Lunaire MMA."
  pageSchema={eventsSchema}
>
  <Nav />
  <main>
    <Events />
  </main>
  <Footer />
</Layout>
