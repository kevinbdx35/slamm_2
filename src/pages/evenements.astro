---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SOCIAL_URLS } from '../config/urls.js';
import { EVENTS, getUpcomingEvents, getPastEvents, sortEventsByDate, formatEventDate } from '../config/events.js';
import { generateEventListSchema } from '../utils/schemaGenerator.js';

const upcomingEvents = sortEventsByDate(getUpcomingEvents(EVENTS));
const eventsSchema = upcomingEvents.length > 0 ? generateEventListSchema(upcomingEvents) : null;
const pastEvents = getPastEvents(EVENTS);

function getStatusColor(status) {
  switch (status) {
    case 'upcoming': return 'text-success dark:text-success-dark border-success dark:border-success-dark';
    case 'full': return 'text-warning dark:text-warning-dark border-warning dark:border-warning-dark';
    case 'cancelled': return 'text-error dark:text-error-dark border-error dark:border-error-dark';
    default: return 'text-text-secondary dark:text-text-secondary-dark border-text-secondary dark:border-text-secondary-dark';
  }
}

function getStatusLabel(status) {
  switch (status) {
    case 'upcoming': return 'Places disponibles';
    case 'full': return 'Complet';
    case 'cancelled': return 'Annulé';
    default: return '';
  }
}

const stats = [
  { value: 5, label: 'stages organisés' },
  { value: 2, label: 'participations en compétition' },
  { value: 3, label: 'médailles NoGi' },
  { value: 1, label: 'victoire MMA interclub' },
];
---

<BaseLayout
  title="Événements MMA | Stages et compétitions Côte d'Émeraude"
  description="Stages MMA, compétitions et événements à Saint-Lunaire. Ouvert aux pratiquants de Dinard, Saint-Malo, Pleurtuit, Dinan, Cancale et toute la région."
  url="https://mma-saint-lunaire.fr/evenements"
  keywords="stage MMA Saint-Lunaire, stage MMA Dinard, compétition MMA Saint-Malo, événements MMA Bretagne, stage grappling Côte d'Émeraude, compétition arts martiaux Dinan"
  schemas={eventsSchema}
>
  <div class="py-12 mb-20 max-w-[1200px] mx-auto w-full px-6">
    <header class="section-border pb-4">
      <h1 class="text-[clamp(2.25rem,4vw,3.5rem)] font-normal tracking-tight leading-tight mb-6">
        Événements
      </h1>
      <p class="text-base tracking-wide leading-relaxed max-w-[1000px]">
        Participe à nos stages, compétitions et événements pour progresser et partager ta passion du MMA.
      </p>
      <div class="flex flex-wrap gap-4 md:gap-8 mt-4 items-baseline">
        <span class="text-sm font-medium text-primary dark:text-primary-dark">Depuis 2023</span>
        {stats.map((stat) => (
          <div class="text-center">
            <span class="text-primary dark:text-primary-dark font-bold text-xl mr-1">{stat.value}</span>
            <span class="text-sm text-text-secondary dark:text-text-secondary-dark">{stat.label}</span>
          </div>
        ))}
      </div>
    </header>

    <!-- Upcoming events -->
    <section class="mt-12 mb-12">
      <h2 class="heading-border text-[clamp(1.75rem,3vw,2rem)] font-normal leading-tight mb-6">
        Prochains événements
      </h2>

      {upcomingEvents.length === 0 ? (
        <div class="border-[3px] border-primary dark:border-primary-dark p-8 text-center bg-gradient-to-br from-brand-neonGreen/[0.03] to-brand-neonGreen/[0.01]">
          <h3 class="text-[1.75rem] font-bold mb-4 text-text-secondary dark:text-text-secondary-dark">
            Aucun événement programmé
          </h3>
          <p class="text-base mb-6">
            Nous préparons de nouveaux événements pour vous. Restez connectés sur nos réseaux sociaux pour être informés en priorité !
          </p>
          <a
            href={SOCIAL_URLS.INSTAGRAM}
            target="_blank"
            rel="noopener noreferrer"
            class="btn bg-primary dark:bg-primary-dark text-white dark:text-brand-darkBg px-8 py-3 hover:-translate-y-0.5"
          >
            Suivre sur Instagram
          </a>
        </div>
      ) : (
        <div class="flex flex-col gap-8">
          {upcomingEvents.map((event) => (
            <div class="border-[3px] border-primary dark:border-primary-dark overflow-hidden bg-gradient-to-br from-brand-neonGreen/[0.03] to-brand-neonGreen/[0.01]">
              <div class="flex flex-col md:flex-row">
                {event.image && (
                  <div class="p-4 md:p-6 flex items-center justify-center">
                    <img
                      src={event.image}
                      alt={event.title}
                      class="w-full md:w-[220px] h-auto object-cover card-border"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="flex-grow p-6">
                  <div class="flex justify-between items-start mb-4">
                    <h3 class="text-[1.75rem] font-normal leading-snug">{event.title}</h3>
                    {event.status && (
                      <span class={`text-xs font-medium px-2 py-1 border rounded ml-2 ${getStatusColor(event.status)}`}>
                        {getStatusLabel(event.status)}
                      </span>
                    )}
                  </div>

                  <div class="flex items-start mb-3 gap-3">
                    <svg class="w-5 h-5 mt-0.5 text-primary dark:text-primary-dark flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM9 10H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z"/></svg>
                    <span class="text-sm">{formatEventDate(event.date)}</span>
                  </div>
                  {event.time && (
                    <div class="flex items-start mb-3 gap-3">
                      <svg class="w-5 h-5 mt-0.5 text-primary dark:text-primary-dark flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
                      <span class="text-sm">{event.time}</span>
                    </div>
                  )}
                  {event.location && (
                    <div class="flex items-start mb-3 gap-3">
                      <svg class="w-5 h-5 mt-0.5 text-primary dark:text-primary-dark flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                      <span class="text-sm">{event.location}</span>
                    </div>
                  )}
                  {event.price && (
                    <div class="flex items-start mb-3 gap-3">
                      <svg class="w-5 h-5 mt-0.5 text-primary dark:text-primary-dark flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M15 18.5c-2.51 0-4.68-1.42-5.76-3.5h5.76l1-2h-7.36c-.06-.33-.1-.66-.1-1s.04-.67.1-1h7.36l1-2H9.24A6.492 6.492 0 0 1 15 5.5c1.61 0 3.09.59 4.23 1.57L21 5.3A8.955 8.955 0 0 0 15 3.5c-3.92 0-7.24 2.51-8.48 6H3l-1 2h4.06c-.06.33-.06.66-.06 1s0 .67.06 1H3l-1 2h4.52c1.24 3.49 4.56 6 8.48 6 2.31 0 4.41-.87 6-2.3l-1.78-1.77c-1.13.98-2.6 1.57-4.22 1.57z"/></svg>
                      <span class="text-sm">{event.price}</span>
                    </div>
                  )}
                  {event.maxParticipants && (
                    <div class="flex items-start mb-4 gap-3">
                      <svg class="w-5 h-5 mt-0.5 text-primary dark:text-primary-dark flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
                      <span class="text-sm">Limité à {event.maxParticipants} participants</span>
                    </div>
                  )}

                  <p class="text-sm mb-6">{event.description}</p>

                  {event.registrationUrl && event.status === 'upcoming' && (
                    <a
                      href={event.registrationUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn bg-primary dark:bg-primary-dark text-white dark:text-brand-darkBg px-8 py-3 hover:-translate-y-0.5 hover:bg-secondary"
                    >
                      S'inscrire
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </section>

    <!-- Past events -->
    {pastEvents.length > 0 && (
      <section class="mb-12">
        <h2 class="border-b-2 border-text-secondary/70 dark:border-text-secondary-dark/70 inline-block text-[clamp(1.75rem,3vw,2rem)] font-normal leading-tight mb-6 opacity-70">
          Derniers événements
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {pastEvents.map((event) => (
            <div class="border-2 border-outline/40 dark:border-outline-dark/40 p-6 opacity-70">
              <h3 class="text-[1.375rem] font-normal leading-snug mb-2 text-text-secondary dark:text-text-secondary-dark">{event.title}</h3>
              <div class="flex items-start mb-3 gap-3">
                <svg class="w-[18px] h-[18px] mt-0.5 opacity-50 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z"/></svg>
                <span class="text-sm text-text-secondary dark:text-text-secondary-dark">{formatEventDate(event.date)}</span>
              </div>
              {event.time && (
                <div class="flex items-start mb-3 gap-3">
                  <svg class="w-[18px] h-[18px] mt-0.5 opacity-50 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z"/></svg>
                  <span class="text-sm text-text-secondary dark:text-text-secondary-dark">{event.time}</span>
                </div>
              )}
              {event.location && (
                <div class="flex items-start mb-3 gap-3">
                  <svg class="w-[18px] h-[18px] mt-0.5 opacity-50 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/></svg>
                  <span class="text-sm text-text-secondary dark:text-text-secondary-dark">{event.location}</span>
                </div>
              )}
              <p class="text-sm text-text-secondary dark:text-text-secondary-dark">{event.description}</p>
            </div>
          ))}
        </div>

        <p class="text-sm text-text-secondary dark:text-text-secondary-dark mt-6">
          Suivez-nous sur{' '}
          <a href={SOCIAL_URLS.INSTAGRAM} target="_blank" rel="noopener noreferrer" class="text-primary dark:text-primary-dark no-underline hover:underline">
            Instagram
          </a>
          {' '}pour ne rien manquer.
        </p>
      </section>
    )}
  </div>
</BaseLayout>
