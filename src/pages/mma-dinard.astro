---
import GeoPage from '../components/GeoPage.astro';

const AREA_SERVED = ["Dinard", "Saint-Briac-sur-Mer", "Lancieux"];

// Même entité que le SportsClub global du Layout (même @id) : on ne fait
// qu'ajouter la zone desservie, sans déclarer un second établissement
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SportsClub',
  '@id': 'https://mma-saint-lunaire.fr/#club',
  areaServed: AREA_SERVED,
};
---

<GeoPage
  title="Club MMA Dinard – À 5 min de Dinard | SLAMM Saint-Lunaire"
  description="Tu cherches un club de MMA proche de Dinard ? SLAMM est à 5 min à Saint-Lunaire. Grappling, No-Gi, boxe, kickboxing, lutte. Tous niveaux, coachs FMMAF."
  canonical="/mma-dinard/"
  city="Dinard"
  distance="5 min"
  areaServed={AREA_SERVED}
  {schema}
/>
