---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { ASSOCONNECT_URLS } from '../config/urls.js';
import { generateCourseSchema } from '../utils/schemaGenerator.js';
import { SCHEDULE, SEASON, PRICING, getActivePeriodIndex, formatTimeDisplay } from '../config/schedule.js';

const activePeriod = getActivePeriodIndex();

const courseSchema = generateCourseSchema();

const steps = [
  { label: 'OBSERVE UN COURS', description: 'Aucune pression, juste pour découvrir.' },
  {
    label: "ESSAYE JUSQU'À 2 SÉANCES D'ESSAI",
    descriptionHtml: '<p class="text-sm font-bold text-success dark:text-success-dark">Gratuit en début de saison (sept-oct)</p><p class="text-sm">En cours d\'année : 5 € par séance, déductible de l\'adhésion.</p>',
  },
  { label: 'INSCRIPTION', description: "Bienvenue dans l'équipe!" },
];

const coursePhases = [
  {
    icon: 'mdi:sword-cross',
    title: '1. Échauffement',
    duration: '15 minutes',
    text: "Préparation physique progressive : mobilité articulaire, cardio léger et exercices de coordination. On démarre en douceur pour préparer le corps à l'effort.",
  },
  {
    icon: 'mdi:school',
    title: '2. Apprentissage technique',
    duration: '45 à 60 minutes',
    text: 'Travail des techniques debout (frappes, déplacements) et au sol (contrôles, soumissions). On pratique par deux avec progressivité et bienveillance.',
  },
  {
    icon: 'mdi:flash',
    title: '3. Mise en situation (optionnel)',
    duration: '15 à 20 minutes',
    text: "Sparring léger et contrôlé pour ceux qui le souhaitent. Aucune obligation, tu restes spectateur si tu préfères observer ou si tu débutes. Chacun va à son rythme.",
  },
  {
    icon: 'mdi:check-circle',
    title: '4. Retour au calme',
    duration: '10 minutes',
    text: 'Étirements et récupération active. On termine en douceur pour favoriser la récupération musculaire et prévenir les courbatures.',
  },
];

// Séparer cours, sparring et luta livre
const coursSlots = SCHEDULE.filter(s => !s.label);
const sparringSlots = SCHEDULE.filter(s => s.label === 'Sparring');
const lutaLivreSlots = SCHEDULE.filter(s => s.label === 'Luta Livre');

const coursText = coursSlots.map(s =>
  `<strong>${s.day}</strong> ${formatTimeDisplay(s.start)} → ${formatTimeDisplay(s.end)}`
).join('<br />');

const sparringText = sparringSlots.map(s =>
  `<strong>${s.day}</strong> ${formatTimeDisplay(s.start)} → ${formatTimeDisplay(s.end)}`
).join('<br />');

const lutaLivreText = lutaLivreSlots.map(s =>
  `<strong>${s.day}</strong> ${formatTimeDisplay(s.start)} → ${formatTimeDisplay(s.end)}`
).join('<br />');
---

<BaseLayout
  title="Cours MMA Saint-Lunaire, Dinard, Saint-Malo | Horaires et Tarifs SLAMM"
  description="Cours de MMA à Saint-Lunaire : grappling, No-Gi, boxe, kickboxing, lutte et jiu-jitsu. Lundi, mercredi, vendredi. À 5 min de Dinard. Essai 5€ déductible ! Coachs FMMAF."
  url="https://mma-saint-lunaire.fr/cours"
  keywords="cours MMA Saint-Lunaire, cours MMA Dinard, cours MMA Saint-Malo, cours grappling Dinard, cours grappling Saint-Malo, cours No-Gi Saint-Lunaire, cours No-Gi Dinard, cours boxe Dinard, cours boxe Saint-Malo, cours kickboxing Dinan, cours kickboxing Dinard, cours jiu-jitsu Saint-Lunaire, cours BJJ Dinard, cours lutte Saint-Malo, tarif MMA Bretagne, essai MMA, self-défense Côte d'Émeraude"
  schemas={courseSchema}
>
  <header class="section-border pb-4">
    <h1 class="text-[clamp(2.25rem,4vw,3.5rem)] font-normal tracking-tight leading-tight mb-6">
      Nos Cours de MMA
    </h1>
    <p class="text-base tracking-wide leading-relaxed max-w-[1000px] mt-2">
      Que tu sois débutant ou confirmé, découvre nos créneaux, notre système d'essai, et les modalités d'inscription.
    </p>
  </header>

  <!-- Layout responsive unifié -->
  <div class="mt-12 grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-6">
    <!-- Pack Découverte -->
    <div class="border-[3px] border-primary dark:border-primary-dark rounded-md3 p-8 flex flex-col lg:min-h-[400px] bg-gradient-to-br from-brand-neonGreen/[0.03] to-brand-neonGreen/[0.01]">
      <div class="flex items-center mb-6">
        <Icon name="mdi:label" class="w-8 h-8 mr-3 text-primary dark:text-primary-dark" />
        <h2 class="text-[clamp(1.75rem,3vw,2rem)] font-bold tracking-tight">Pack Découverte MMA</h2>
      </div>

      <div class="flex-1 flex flex-col gap-6 mb-6">
        {steps.map((step, i) => (
          <div class="flex gap-4">
            <div class="flex flex-col items-center">
              <div class="w-8 h-8 rounded-full bg-primary/10 dark:bg-primary-dark/10 flex items-center justify-center text-primary dark:text-primary-dark font-bold text-sm">{i + 1}</div>
              {i < steps.length - 1 && <div class="w-px flex-1 bg-primary/20 dark:bg-primary-dark/20 mt-2" />}
            </div>
            <div class="pb-4">
              <p class="font-bold text-lg mb-1">{step.label}</p>
              {step.descriptionHtml ? (
                <div set:html={step.descriptionHtml} />
              ) : (
                <p class="text-base">{step.description}</p>
              )}
            </div>
          </div>
        ))}
      </div>

      <div class="flex gap-3 p-4 mb-6 rounded-md3 bg-primary/5 dark:bg-primary-dark/5 border border-primary/15 dark:border-primary-dark/15">
        <Icon name="mdi:lightbulb-outline" class="w-5 h-5 flex-shrink-0 mt-0.5 text-primary dark:text-primary-dark" />
        <div>
          <p class="text-sm font-bold mb-1 text-primary dark:text-primary-dark">Astuce découverte</p>
          <p class="text-sm text-text-secondary dark:text-text-secondary-dark leading-relaxed">Profite de tes 2 séances d'essai pour découvrir les techniques, rencontrer les coachs et t'imprégner de l'ambiance du club.</p>
        </div>
      </div>

      <a
        href={ASSOCONNECT_URLS.TRIAL_BOOKING}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary w-full py-3 text-lg text-center gap-2"
      >
        Réserver ton cours d'essai
        <Icon name="mdi:open-in-new" class="w-5 h-5 opacity-70" />
      </a>
    </div>

    <!-- Sidebar (Créneaux + Tarifs) -->
    <div class="flex flex-col gap-6">
      <!-- Créneaux -->
      <div class="card-border rounded-md3 p-6 flex flex-col">
        <div class="flex items-center mb-4">
          <Icon name="mdi:calendar" class="w-6 h-6 mr-2 text-primary dark:text-primary-dark" />
          <h3 class="text-[1.75rem] font-bold">Créneaux {SEASON}</h3>
        </div>

        <!-- Cours -->
        <div class="flex items-center gap-2 mb-1">
          <Icon name="mdi:school" class="w-5 h-5 text-primary dark:text-primary-dark" />
          <p class="text-sm font-bold tracking-wide text-primary dark:text-primary-dark">Cours MMA</p>
        </div>
        <p class="text-base leading-[1.8]" set:html={coursText} />
        <p class="text-sm text-text-secondary dark:text-text-secondary-dark italic mb-4">Tous niveaux</p>

        <hr class="border-border dark:border-border-dark mb-4" />

        <!-- Sparring -->
        <div class="flex items-center gap-2 mb-1">
          <Icon name="mdi:sword-cross" class="w-5 h-5 text-amber-600 dark:text-amber-400" />
          <p class="text-sm font-bold tracking-wide text-amber-600 dark:text-amber-400">Sparring MMA</p>
        </div>
        <p class="text-base leading-[1.8]" set:html={sparringText} />

        <hr class="border-border dark:border-border-dark mb-4 mt-4" />

        <!-- Luta Livre -->
        <div class="flex items-center gap-2 mb-1">
          <Icon name="mdi:arm-flex" class="w-5 h-5 text-sky-600 dark:text-sky-400" />
          <p class="text-sm font-bold tracking-wide text-sky-600 dark:text-sky-400">Cours Luta Livre · No-Gi</p>
        </div>
        <p class="text-base leading-[1.8]" set:html={lutaLivreText} />
        <p class="text-sm text-text-secondary dark:text-text-secondary-dark italic">Membres uniquement</p>
      </div>

      <!-- Tarifs -->
      <div class="card-border rounded-md3 p-6 lg:min-h-[180px] flex flex-col justify-between">
        <div>
          <div class="flex items-center mb-4">
            <Icon name="mdi:currency-eur" class="w-6 h-6 mr-2 text-primary dark:text-primary-dark" />
            <h3 class="text-[1.75rem] font-bold">Tarifs {SEASON}</h3>
          </div>
          <div class="grid grid-cols-2 gap-3 mb-4">
            <div class="rounded-md3 px-4 py-3 bg-primary/5 dark:bg-primary-dark/5 border border-primary/10 dark:border-primary-dark/10">
              <p class="text-xs uppercase tracking-wide mb-1 text-text-secondary dark:text-text-secondary-dark">{PRICING.adult.label}</p>
              <p class="text-2xl font-bold text-primary dark:text-primary-dark">
                {activePeriod >= 0 ? PRICING.adult.periods[activePeriod].price : '—'} €
              </p>
            </div>
            <div class="rounded-md3 px-4 py-3 bg-primary/5 dark:bg-primary-dark/5 border border-primary/10 dark:border-primary-dark/10">
              <p class="text-xs uppercase tracking-wide mb-1 text-text-secondary dark:text-text-secondary-dark">{PRICING.young.label}</p>
              <p class="text-2xl font-bold text-primary dark:text-primary-dark">
                {activePeriod >= 0 ? PRICING.young.periods[activePeriod].price : '—'} €
              </p>
            </div>
          </div>
          <details class="mb-4 group">
            <summary class="text-xs text-primary dark:text-primary-dark cursor-pointer list-none flex items-center gap-1 w-fit hover:underline">
              <Icon name="mdi:chevron-right" class="w-3.5 h-3.5 transition-transform group-open:rotate-90" />
              Tarif dégressif · voir toutes les périodes
            </summary>
            <div class="mt-2 flex flex-col gap-1">
              {PRICING.adult.periods.map((period, i) => (
                <div class="flex items-center justify-between text-xs py-1 border-b border-black/5 dark:border-white/5 last:border-0">
                  <span class={i === activePeriod ? 'font-bold text-primary dark:text-primary-dark' : 'text-text-secondary dark:text-text-secondary-dark'}>
                    {period.label}{i === activePeriod ? ' ✓' : ''}
                  </span>
                  <span class={i === activePeriod ? 'font-bold text-primary dark:text-primary-dark' : 'text-text-secondary dark:text-text-secondary-dark'}>
                    {period.price} € · {PRICING.young.periods[i].price} €
                  </span>
                </div>
              ))}
              <p class="text-xs mt-1 text-text-secondary dark:text-text-secondary-dark">Valable jusqu'à fin juin · CB en 3 fois possible</p>
            </div>
          </details>
          <ul class="space-y-1 text-sm">
            {['Licence fédérale incluse', 'Assurance comprise', 'Accès à tous les cours'].map((item) => (
              <li class="flex items-center gap-2">
                <Icon name="mdi:check-circle" class="w-4 h-4 text-primary dark:text-primary-dark flex-shrink-0" />
                {item}
              </li>
            ))}
          </ul>
        </div>
        <a
          href={ASSOCONNECT_URLS.ANNUAL_MEMBERSHIP}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary w-full py-2 text-center mt-4 gap-2"
        >
          S'inscrire
          <Icon name="mdi:open-in-new" class="w-4 h-4 opacity-70" />
        </a>
      </div>
    </div>
  </div>

  <!-- Course phases section -->
  <section class="mt-16">
    <h2 class="heading-border text-[clamp(1.75rem,3vw,2rem)] font-normal leading-tight mb-6">
      À quoi ressemble un cours ?
    </h2>
    <p class="text-base tracking-wide leading-relaxed max-w-[800px] mb-8">
      Nos cours durent entre 1h15 et 2h selon le créneau. Voici un aperçu d'une séance type pour te rassurer si c'est ta première fois :
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {coursePhases.map((phase) => (
        <div class="card-border rounded-md3 p-6 h-full">
          <div class="flex items-center mb-4">
            <Icon name={phase.icon} class="w-10 h-10 text-primary dark:text-primary-dark mr-4" />
            <div>
              <h3 class="text-lg font-bold">{phase.title}</h3>
              <span class="text-[0.6875rem] font-medium tracking-wide text-text-secondary dark:text-text-secondary-dark">{phase.duration}</span>
            </div>
          </div>
          <p class="text-sm leading-relaxed tracking-wide">{phase.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Lien FAQ -->
  <section class="mt-16 mb-8">
    <div class="card-border rounded-md3 p-6 flex flex-col sm:flex-row items-center justify-between gap-4 bg-surface-variant/30 dark:bg-surface-variant-dark/30">
      <div class="flex items-center gap-4">
        <Icon name="mdi:help-circle" class="w-10 h-10 text-primary dark:text-primary-dark flex-shrink-0" />
        <div>
          <h3 class="text-lg font-bold">Des questions ?</h3>
          <p class="text-sm text-text-secondary dark:text-text-secondary-dark">Consulte notre <a href="/equipements-mma" class="text-primary dark:text-primary-dark underline underline-offset-2">page équipements</a>, certificat médical, âge minimum, déroulement des cours...</p>
        </div>
      </div>
      <a
        href="/faq"
        class="btn-primary py-2 px-6 text-center whitespace-nowrap w-full sm:w-auto"
      >
        Voir la FAQ
      </a>
    </div>
  </section>
</BaseLayout>
