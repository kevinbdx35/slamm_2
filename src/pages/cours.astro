---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ASSOCONNECT_URLS } from '../config/urls.js';
import { generateCourseSchema } from '../utils/schemaGenerator.js';

const courseSchema = generateCourseSchema();

const steps = [
  { label: 'OBSERVE UN COURS', description: 'Aucune pression, juste pour découvrir.' },
  {
    label: "ESSAYE JUSQU'À 2 SÉANCES D'ESSAI",
    descriptionHtml: '<p class="text-sm font-bold text-success dark:text-success-dark">Gratuit en début de saison (sept-oct)</p><p class="text-sm">En cours d\'année : 5 € par séance, déductible de l\'adhésion.</p>',
  },
  { label: 'INSCRIPTION', description: "Bienvenue dans l'équipe!" },
];

const coursePhases = [
  {
    icon: '<path d="M20.57 14.86L22 13.43 20.57 12 17 15.57 8.43 7 12 3.43 10.57 2 9.14 3.43 7.71 2 5.57 4.14 4.14 2.71 2.71 4.14l1.43 1.43L2 7.71l1.43 1.43L2 10.57 3.43 12 7 8.43 15.57 17 12 20.57 13.43 22l1.43-1.43L16.29 22l2.14-2.14 1.43 1.43 1.43-1.43-1.43-1.43L22 16.29z"/>',
    title: '1. Échauffement',
    duration: '15 minutes',
    text: "Préparation physique progressive : mobilité articulaire, cardio léger et exercices de coordination. On démarre en douceur pour préparer le corps à l'effort.",
  },
  {
    icon: '<path d="M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6 9-4.91V17h2V9L12 3z"/>',
    title: '2. Apprentissage technique',
    duration: '45 à 60 minutes',
    text: 'Travail des techniques debout (frappes, déplacements) et au sol (contrôles, soumissions). On pratique par deux avec progressivité et bienveillance.',
  },
  {
    icon: '<path d="M7 2v11h3v9l7-12h-4l4-8z"/>',
    title: '3. Mise en situation (optionnel)',
    duration: '15 à 20 minutes',
    text: "Sparring léger et contrôlé pour ceux qui le souhaitent. Aucune obligation, tu restes spectateur si tu préfères observer ou si tu débutes. Chacun va à son rythme.",
  },
  {
    icon: '<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>',
    title: '4. Retour au calme',
    duration: '10 minutes',
    text: 'Étirements et récupération active. On termine en douceur pour favoriser la récupération musculaire et prévenir les courbatures.',
  },
];
---

<BaseLayout
  title="Cours MMA Saint-Lunaire, Dinard, Saint-Malo | Horaires et Tarifs SLAMM"
  description="Cours de MMA à Saint-Lunaire pour tous niveaux. À 5 min de Dinard, 15 min de Saint-Malo. Horaires : lundi, mercredi, vendredi. Essai gratuit en septembre ! Coachs diplômés FMMAF."
  url="https://mma-saint-lunaire.fr/cours"
  keywords="cours MMA Saint-Lunaire, cours MMA Dinard, cours MMA Saint-Malo, horaires MMA Côte d'Émeraude, tarif MMA Bretagne, inscription MMA, essai MMA gratuit, cours arts martiaux mixtes"
  schemas={courseSchema}
>
  <header class="section-border pb-4">
    <h1 class="text-[clamp(2.25rem,4vw,3.5rem)] font-normal tracking-tight leading-tight mb-6">
      Nos Cours de MMA
    </h1>
    <p class="text-base tracking-wide leading-relaxed max-w-[1000px] mt-2">
      Que tu sois débutant ou confirmé, découvre nos créneaux, notre système d'essai, et les modalités d'inscription.
    </p>
  </header>

  <div class="mt-12">
    <!-- Mobile layout -->
    <div class="lg:hidden flex flex-col gap-6">
      <!-- Pack Découverte -->
      <div class="border-[3px] border-primary dark:border-primary-dark p-8 flex flex-col bg-gradient-to-br from-brand-neonGreen/[0.03] to-brand-neonGreen/[0.01]">
        <div class="flex items-center mb-6">
          <svg class="w-8 h-8 mr-3 text-primary dark:text-primary-dark" fill="currentColor" viewBox="0 0 24 24"><path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/></svg>
          <h2 class="text-[clamp(1.75rem,3vw,2rem)] font-bold tracking-tight">Pack Découverte MMA</h2>
        </div>

        <div class="flex-1 flex flex-col gap-6 mb-6">
          {steps.map((step, i) => (
            <div class="flex gap-4">
              <div class="flex flex-col items-center">
                <div class="w-8 h-8 rounded-full bg-primary/10 dark:bg-primary-dark/10 flex items-center justify-center text-primary dark:text-primary-dark font-bold text-sm">{i + 1}</div>
                {i < steps.length - 1 && <div class="w-px flex-1 bg-primary/20 dark:bg-primary-dark/20 mt-2" />}
              </div>
              <div class="pb-4">
                <p class="font-bold text-lg mb-1">{step.label}</p>
                {step.descriptionHtml ? (
                  <div set:html={step.descriptionHtml} />
                ) : (
                  <p class="text-base">{step.description}</p>
                )}
              </div>
            </div>
          ))}
        </div>

        <a
          href={ASSOCONNECT_URLS.TRIAL_BOOKING}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary w-full py-3 text-lg text-center"
        >
          Réserver ton cours d'essai
        </a>
      </div>

      <!-- Créneaux -->
      <div class="card-border p-6 flex flex-col">
        <div class="flex items-center mb-4">
          <svg class="w-6 h-6 mr-2 text-primary dark:text-primary-dark" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM9 10H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z"/></svg>
          <h3 class="text-[1.75rem] font-bold">Créneaux 2025–2026</h3>
        </div>
        <p class="text-base leading-[1.8] flex-1">
          <strong>Lundi</strong> 18h00 → 19h15<br />
          <strong>Mercredi</strong> 19h15 → 21h15<br />
          <strong>Vendredi</strong> 19h30 → 21h00
        </p>
        <p class="text-sm text-text-secondary dark:text-text-secondary-dark mt-2 italic">Tous niveaux</p>
      </div>

      <!-- Tarifs -->
      <div class="card-border p-6 flex flex-col justify-between">
        <div>
          <div class="flex items-center mb-4">
            <svg class="w-6 h-6 mr-2 text-primary dark:text-primary-dark" fill="currentColor" viewBox="0 0 24 24"><path d="M15 18.5c-2.51 0-4.68-1.42-5.76-3.5h5.76l1-2h-7.36c-.06-.33-.1-.66-.1-1s.04-.67.1-1h7.36l1-2H9.24A6.492 6.492 0 0 1 15 5.5c1.61 0 3.09.59 4.23 1.57L21 5.3A8.955 8.955 0 0 0 15 3.5c-3.92 0-7.24 2.51-8.48 6H3l-1 2h4.06c-.06.33-.06.66-.06 1s0 .67.06 1H3l-1 2h4.52c1.24 3.49 4.56 6 8.48 6 2.31 0 4.41-.87 6-2.3l-1.78-1.77c-1.13.98-2.6 1.57-4.22 1.57z"/></svg>
            <h3 class="text-[1.75rem] font-bold">Tarifs 2025–2026</h3>
          </div>
          <p class="text-base leading-[1.8]">
            <strong>+25 ans</strong> : 210 €<br />
            <strong>+16 ans</strong> : 180 €
          </p>
          <p class="text-sm text-text-secondary dark:text-text-secondary-dark mt-2">Paiement par CB (possibilité en 3 fois)</p>
        </div>
        <a
          href={ASSOCONNECT_URLS.ANNUAL_MEMBERSHIP}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary w-full py-2 text-center mt-4"
        >
          S'inscrire
        </a>
      </div>
    </div>

    <!-- Desktop layout -->
    <div class="hidden lg:grid lg:grid-cols-[2fr_1fr] gap-6">
      <!-- Pack Découverte -->
      <div class="border-[3px] border-primary dark:border-primary-dark p-8 flex flex-col min-h-[400px] bg-gradient-to-br from-brand-neonGreen/[0.03] to-brand-neonGreen/[0.01]">
        <div class="flex items-center mb-6">
          <svg class="w-8 h-8 mr-3 text-primary dark:text-primary-dark" fill="currentColor" viewBox="0 0 24 24"><path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/></svg>
          <h2 class="text-[clamp(1.75rem,3vw,2rem)] font-bold tracking-tight">Pack Découverte MMA</h2>
        </div>

        <div class="flex-1 flex flex-col gap-6 mb-6">
          {steps.map((step, i) => (
            <div class="flex gap-4">
              <div class="flex flex-col items-center">
                <div class="w-8 h-8 rounded-full bg-primary/10 dark:bg-primary-dark/10 flex items-center justify-center text-primary dark:text-primary-dark font-bold text-sm">{i + 1}</div>
                {i < steps.length - 1 && <div class="w-px flex-1 bg-primary/20 dark:bg-primary-dark/20 mt-2" />}
              </div>
              <div class="pb-4">
                <p class="font-bold text-lg mb-1">{step.label}</p>
                {step.descriptionHtml ? (
                  <div set:html={step.descriptionHtml} />
                ) : (
                  <p class="text-base">{step.description}</p>
                )}
              </div>
            </div>
          ))}
        </div>

        <a
          href={ASSOCONNECT_URLS.TRIAL_BOOKING}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary w-full py-3 text-lg text-center"
        >
          Réserver ton cours d'essai
        </a>
      </div>

      <!-- Sidebar -->
      <div class="flex flex-col gap-6">
        <div class="card-border p-6 min-h-[180px] flex flex-col">
          <div class="flex items-center mb-4">
            <svg class="w-6 h-6 mr-2 text-primary dark:text-primary-dark" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z"/></svg>
            <h3 class="text-[1.75rem] font-bold">Créneaux 2025–2026</h3>
          </div>
          <p class="text-base leading-[1.8] flex-1">
            <strong>Lundi</strong> 18h00 → 19h15<br />
            <strong>Mercredi</strong> 19h15 → 21h15<br />
            <strong>Vendredi</strong> 19h30 → 21h00
          </p>
          <p class="text-sm text-text-secondary dark:text-text-secondary-dark mt-2 italic">Tous niveaux</p>
        </div>

        <div class="card-border p-6 min-h-[180px] flex flex-col justify-between">
          <div>
            <div class="flex items-center mb-4">
              <svg class="w-6 h-6 mr-2 text-primary dark:text-primary-dark" fill="currentColor" viewBox="0 0 24 24"><path d="M15 18.5c-2.51 0-4.68-1.42-5.76-3.5h5.76l1-2h-7.36c-.06-.33-.1-.66-.1-1s.04-.67.1-1h7.36l1-2H9.24A6.492 6.492 0 0 1 15 5.5c1.61 0 3.09.59 4.23 1.57L21 5.3A8.955 8.955 0 0 0 15 3.5c-3.92 0-7.24 2.51-8.48 6H3l-1 2h4.06c-.06.33-.06.66-.06 1s0 .67.06 1H3l-1 2h4.52c1.24 3.49 4.56 6 8.48 6 2.31 0 4.41-.87 6-2.3l-1.78-1.77c-1.13.98-2.6 1.57-4.22 1.57z"/></svg>
              <h3 class="text-[1.75rem] font-bold">Tarifs 2025–2026</h3>
            </div>
            <p class="text-base leading-[1.8]">
              <strong>+25 ans</strong> : 210 €<br />
              <strong>+16 ans</strong> : 180 €
            </p>
            <p class="text-sm text-text-secondary dark:text-text-secondary-dark mt-2">Paiement par CB (possibilité en 3 fois)</p>
          </div>
          <a
            href={ASSOCONNECT_URLS.ANNUAL_MEMBERSHIP}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary w-full py-2 text-center mt-4"
          >
            S'inscrire
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Course phases section -->
  <section class="mt-16">
    <h2 class="heading-border text-[clamp(1.75rem,3vw,2rem)] font-normal leading-tight mb-6">
      À quoi ressemble un cours ?
    </h2>
    <p class="text-base tracking-wide leading-relaxed max-w-[800px] mb-8">
      Nos cours durent entre 1h15 et 2h selon le créneau. Voici un aperçu d'une séance type pour te rassurer si c'est ta première fois :
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {coursePhases.map((phase) => (
        <div class="card-border p-6 h-full">
          <div class="flex items-center mb-4">
            <svg class="w-10 h-10 text-primary dark:text-primary-dark mr-4" fill="currentColor" viewBox="0 0 24 24">
              <Fragment set:html={phase.icon} />
            </svg>
            <div>
              <h3 class="text-lg font-bold">{phase.title}</h3>
              <span class="text-[0.6875rem] font-medium tracking-wide text-text-secondary dark:text-text-secondary-dark">{phase.duration}</span>
            </div>
          </div>
          <p class="text-sm leading-relaxed tracking-wide">{phase.text}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
