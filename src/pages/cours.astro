---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { ASSOCONNECT_URLS } from '../config/urls.js';
import { generateCourseSchema } from '../utils/schemaGenerator.js';
import { SCHEDULE, SEASON, PRICING, formatTimeDisplay } from '../config/schedule.js';

const courseSchema = generateCourseSchema();

const steps = [
  { label: 'OBSERVE UN COURS', description: 'Aucune pression, juste pour découvrir.' },
  {
    label: "ESSAYE JUSQU'À 2 SÉANCES D'ESSAI",
    descriptionHtml: '<p class="text-sm font-bold text-success dark:text-success-dark">Gratuit en début de saison (sept-oct)</p><p class="text-sm">En cours d\'année : 5 € par séance, déductible de l\'adhésion.</p>',
  },
  { label: 'INSCRIPTION', description: "Bienvenue dans l'équipe!" },
];

const coursePhases = [
  {
    icon: 'mdi:sword-cross',
    title: '1. Échauffement',
    duration: '15 minutes',
    text: "Préparation physique progressive : mobilité articulaire, cardio léger et exercices de coordination. On démarre en douceur pour préparer le corps à l'effort.",
  },
  {
    icon: 'mdi:school',
    title: '2. Apprentissage technique',
    duration: '45 à 60 minutes',
    text: 'Travail des techniques debout (frappes, déplacements) et au sol (contrôles, soumissions). On pratique par deux avec progressivité et bienveillance.',
  },
  {
    icon: 'mdi:flash',
    title: '3. Mise en situation (optionnel)',
    duration: '15 à 20 minutes',
    text: "Sparring léger et contrôlé pour ceux qui le souhaitent. Aucune obligation, tu restes spectateur si tu préfères observer ou si tu débutes. Chacun va à son rythme.",
  },
  {
    icon: 'mdi:check-circle',
    title: '4. Retour au calme',
    duration: '10 minutes',
    text: 'Étirements et récupération active. On termine en douceur pour favoriser la récupération musculaire et prévenir les courbatures.',
  },
];

// Composants réutilisables (évite la duplication mobile/desktop)
const scheduleText = SCHEDULE.map((s, i) =>
  `<strong>${s.day}</strong> ${formatTimeDisplay(s.start)} → ${formatTimeDisplay(s.end)}${s.label ? ` <em>(${s.label})</em>` : ''}`
).join('<br />');
---

<BaseLayout
  title="Cours MMA Saint-Lunaire, Dinard, Saint-Malo | Horaires et Tarifs SLAMM"
  description="Cours de MMA à Saint-Lunaire : grappling, No-Gi, boxe, kickboxing, lutte et jiu-jitsu. Lundi, mercredi, vendredi. À 5 min de Dinard. Essai 5€ déductible ! Coachs FMMAF."
  url="https://mma-saint-lunaire.fr/cours"
  keywords="cours MMA Saint-Lunaire, cours MMA Dinard, cours MMA Saint-Malo, cours grappling Dinard, cours grappling Saint-Malo, cours No-Gi Saint-Lunaire, cours No-Gi Dinard, cours boxe Dinard, cours boxe Saint-Malo, cours kickboxing Dinan, cours kickboxing Dinard, cours jiu-jitsu Saint-Lunaire, cours BJJ Dinard, cours lutte Saint-Malo, tarif MMA Bretagne, essai MMA, self-défense Côte d'Émeraude"
  schemas={courseSchema}
>
  <header class="section-border pb-4">
    <h1 class="text-[clamp(2.25rem,4vw,3.5rem)] font-normal tracking-tight leading-tight mb-6">
      Nos Cours de MMA
    </h1>
    <p class="text-base tracking-wide leading-relaxed max-w-[1000px] mt-2">
      Que tu sois débutant ou confirmé, découvre nos créneaux, notre système d'essai, et les modalités d'inscription.
    </p>
  </header>

  <!-- Layout responsive unifié -->
  <div class="mt-12 grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-6">
    <!-- Pack Découverte -->
    <div class="border-[3px] border-primary dark:border-primary-dark p-8 flex flex-col lg:min-h-[400px] bg-gradient-to-br from-brand-neonGreen/[0.03] to-brand-neonGreen/[0.01]">
      <div class="flex items-center mb-6">
        <Icon name="mdi:label" class="w-8 h-8 mr-3 text-primary dark:text-primary-dark" />
        <h2 class="text-[clamp(1.75rem,3vw,2rem)] font-bold tracking-tight">Pack Découverte MMA</h2>
      </div>

      <div class="flex-1 flex flex-col gap-6 mb-6">
        {steps.map((step, i) => (
          <div class="flex gap-4">
            <div class="flex flex-col items-center">
              <div class="w-8 h-8 rounded-full bg-primary/10 dark:bg-primary-dark/10 flex items-center justify-center text-primary dark:text-primary-dark font-bold text-sm">{i + 1}</div>
              {i < steps.length - 1 && <div class="w-px flex-1 bg-primary/20 dark:bg-primary-dark/20 mt-2" />}
            </div>
            <div class="pb-4">
              <p class="font-bold text-lg mb-1">{step.label}</p>
              {step.descriptionHtml ? (
                <div set:html={step.descriptionHtml} />
              ) : (
                <p class="text-base">{step.description}</p>
              )}
            </div>
          </div>
        ))}
      </div>

      <a
        href={ASSOCONNECT_URLS.TRIAL_BOOKING}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary w-full py-3 text-lg text-center gap-2"
      >
        Réserver ton cours d'essai
        <Icon name="mdi:open-in-new" class="w-5 h-5 opacity-70" />
      </a>
    </div>

    <!-- Sidebar (Créneaux + Tarifs) -->
    <div class="flex flex-col gap-6">
      <!-- Créneaux -->
      <div class="card-border p-6 lg:min-h-[180px] flex flex-col">
        <div class="flex items-center mb-4">
          <Icon name="mdi:calendar" class="w-6 h-6 mr-2 text-primary dark:text-primary-dark" />
          <h3 class="text-[1.75rem] font-bold">Créneaux {SEASON}</h3>
        </div>
        <p class="text-base leading-[1.8] flex-1" set:html={scheduleText} />
        <p class="text-sm text-text-secondary dark:text-text-secondary-dark mt-2 italic">Tous niveaux</p>
      </div>

      <!-- Tarifs -->
      <div class="card-border p-6 lg:min-h-[180px] flex flex-col justify-between">
        <div>
          <div class="flex items-center mb-4">
            <Icon name="mdi:currency-eur" class="w-6 h-6 mr-2 text-primary dark:text-primary-dark" />
            <h3 class="text-[1.75rem] font-bold">Tarifs {SEASON}</h3>
          </div>
          <p class="text-base leading-[1.8]">
            <strong>{PRICING.adult.label}</strong> : {PRICING.adult.price} €<br />
            <strong>{PRICING.young.label}</strong> : {PRICING.young.price} €
          </p>
          <p class="text-sm text-text-secondary dark:text-text-secondary-dark mt-2">Paiement par CB (possibilité en 3 fois)</p>
          <ul class="mt-3 space-y-1 text-sm">
            <li class="flex items-center gap-2">
              <Icon name="mdi:check-circle" class="w-4 h-4 text-primary dark:text-primary-dark flex-shrink-0" />
              Licence fédérale incluse
            </li>
            <li class="flex items-center gap-2">
              <Icon name="mdi:check-circle" class="w-4 h-4 text-primary dark:text-primary-dark flex-shrink-0" />
              Assurance comprise
            </li>
            <li class="flex items-center gap-2">
              <Icon name="mdi:check-circle" class="w-4 h-4 text-primary dark:text-primary-dark flex-shrink-0" />
              Accès à tous les cours
            </li>
          </ul>
        </div>
        <a
          href={ASSOCONNECT_URLS.ANNUAL_MEMBERSHIP}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary w-full py-2 text-center mt-4 gap-2"
        >
          S'inscrire
          <Icon name="mdi:open-in-new" class="w-4 h-4 opacity-70" />
        </a>
      </div>
    </div>
  </div>

  <!-- Course phases section -->
  <section class="mt-16">
    <h2 class="heading-border text-[clamp(1.75rem,3vw,2rem)] font-normal leading-tight mb-6">
      À quoi ressemble un cours ?
    </h2>
    <p class="text-base tracking-wide leading-relaxed max-w-[800px] mb-8">
      Nos cours durent entre 1h15 et 2h selon le créneau. Voici un aperçu d'une séance type pour te rassurer si c'est ta première fois :
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {coursePhases.map((phase) => (
        <div class="card-border p-6 h-full">
          <div class="flex items-center mb-4">
            <Icon name={phase.icon} class="w-10 h-10 text-primary dark:text-primary-dark mr-4" />
            <div>
              <h3 class="text-lg font-bold">{phase.title}</h3>
              <span class="text-[0.6875rem] font-medium tracking-wide text-text-secondary dark:text-text-secondary-dark">{phase.duration}</span>
            </div>
          </div>
          <p class="text-sm leading-relaxed tracking-wide">{phase.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Lien FAQ -->
  <section class="mt-16 mb-8">
    <div class="card-border p-6 flex flex-col sm:flex-row items-center justify-between gap-4 bg-surface-variant/30 dark:bg-surface-variant-dark/30">
      <div class="flex items-center gap-4">
        <Icon name="mdi:help-circle" class="w-10 h-10 text-primary dark:text-primary-dark flex-shrink-0" />
        <div>
          <h3 class="text-lg font-bold">Des questions ?</h3>
          <p class="text-sm text-text-secondary dark:text-text-secondary-dark">Équipement, certificat médical, âge minimum, déroulement des cours...</p>
        </div>
      </div>
      <a
        href="/faq"
        class="btn-primary py-2 px-6 text-center whitespace-nowrap w-full sm:w-auto"
      >
        Voir la FAQ
      </a>
    </div>
  </section>
</BaseLayout>
