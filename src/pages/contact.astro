---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeafletMap from '../components/LeafletMap.jsx';
import { Icon } from 'astro-icon/components';
---

<BaseLayout
  title="Contact Club MMA Saint-Lunaire, Dinard, Saint-Malo | SLAMM Côte d'Émeraude"
  description="Contactez SLAMM, club de MMA à Saint-Lunaire. À 5 min de Dinard, 15 min de Saint-Malo. Adresse, téléphone, plan d'accès. Parking gratuit. Réservez votre essai !"
  url="https://mma-saint-lunaire.fr/contact"
  keywords="contact MMA Saint-Lunaire, adresse club MMA Dinard, adresse club MMA Saint-Malo, inscription MMA Dinan, inscription grappling Dinard, inscription No-Gi Saint-Malo, club boxe Saint-Lunaire, club kickboxing Dinard, club jiu-jitsu Saint-Malo, dojo MMA Côte d'Émeraude, dojo grappling Bretagne, téléphone SLAMM, essai MMA Dinard"
>
  <div class="py-12 mb-20 max-w-[1200px] mx-auto w-full px-6">
    <header class="section-border pb-4">
      <h1 class="text-[clamp(2.25rem,4vw,3.5rem)] font-normal tracking-tight leading-tight mb-6">
        Nous contacter
      </h1>
      <p class="text-base tracking-wide leading-relaxed max-w-[1000px]">
        Une question sur les cours, les inscriptions ou le club ? Voici comment nous contacter.
      </p>
    </header>

    <!-- Contact cards -->
    <section class="mt-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- WhatsApp -->
        <div class="card-border flex flex-col overflow-hidden">
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center mb-6">
              <Icon name="mdi:whatsapp" class="w-7 h-7 mr-2 text-primary dark:text-primary-dark" />
              <span class="text-lg font-bold tracking-wide">Contact Rapide</span>
            </div>
            <div class="flex-1">
              <div class="mb-4">
                <p class="text-xs font-medium tracking-wide text-text-secondary dark:text-text-secondary-dark mb-2">WhatsApp / Téléphone</p>
                <p class="text-lg">07 82 77 92 88</p>
              </div>
            </div>
            <a
              href="https://wa.me/33782779288?text=Bonjour%2C%20je%20souhaite%20des%20informations%20sur%20le%20club%20de%20MMA."
              target="_blank"
              rel="noopener noreferrer"
              class="btn card-border w-full py-2 text-center text-primary dark:text-primary-dark font-bold mt-4 hover:bg-[#25D366] hover:text-white hover:border-[#25D366] gap-2"
            >
              Écrire sur WhatsApp
              <Icon name="mdi:open-in-new" class="w-4 h-4 opacity-70" />
            </a>
          </div>
        </div>

        <!-- Other contacts -->
        <div class="card-border flex flex-col overflow-hidden">
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center mb-6">
              <Icon name="mdi:email" class="w-7 h-7 mr-2 text-primary dark:text-primary-dark" />
              <span class="text-lg font-bold tracking-wide">Autres contacts</span>
            </div>
            <div class="flex-1">
              <div class="mb-4">
                <p class="text-xs font-medium tracking-wide text-text-secondary dark:text-text-secondary-dark mb-2">EMAIL</p>
                <a href="mailto:slamm35800@gmail.com" class="text-lg text-primary dark:text-primary-dark underline decoration-brand-neonGreen/60 underline-offset-[3px] decoration-[1.5px] hover:bg-brand-neonGreen/[0.08] rounded px-1 py-0.5 transition-all">
                  slamm35800@gmail.com
                </a>
              </div>
              <div class="mb-4">
                <p class="text-xs font-medium tracking-wide text-text-secondary dark:text-text-secondary-dark mb-2">INSTAGRAM</p>
                <a href="https://instagram.com/slamm35800" target="_blank" rel="noopener noreferrer" class="text-lg text-primary dark:text-primary-dark underline decoration-brand-neonGreen/60 underline-offset-[3px] decoration-[1.5px] hover:bg-brand-neonGreen/[0.08] rounded px-1 py-0.5 transition-all">
                  @slamm35800
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Location -->
        <div class="card-border flex flex-col overflow-hidden">
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center mb-6">
              <Icon name="mdi:map-marker" class="w-7 h-7 mr-2 text-primary dark:text-primary-dark" />
              <span class="text-lg font-bold tracking-wide">Nous trouver</span>
            </div>
            <div class="flex-1">
              <div class="mb-4">
                <p class="text-xs font-medium tracking-wide text-text-secondary dark:text-text-secondary-dark mb-2">SIÈGE SOCIAL</p>
                <p class="text-lg">Boulevard Flusson (Mairie)<br />35800 Saint-Lunaire</p>
              </div>
              <div class="mb-4">
                <p class="text-xs font-medium tracking-wide text-text-secondary dark:text-text-secondary-dark mb-2">LIEU D'ENTRAÎNEMENT</p>
                <p class="text-lg">361 Rue de la Saudrais<br />35800 Saint-Lunaire</p>
              </div>
            </div>
            <a
              href="https://www.google.com/maps/dir//48.629194657231274,-2.1120771896734203"
              target="_blank"
              rel="noopener noreferrer"
              class="btn card-border w-full py-2 text-center text-primary dark:text-primary-dark font-bold mt-4 hover:bg-[#4285F4] hover:text-white hover:border-[#4285F4] gap-2"
            >
              Itinéraire
              <Icon name="mdi:open-in-new" class="w-4 h-4 opacity-70" />
            </a>
          </div>
        </div>

        <!-- Social -->
        <div class="card-border flex flex-col overflow-hidden">
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center mb-6">
              <Icon name="mdi:instagram" class="w-7 h-7 mr-2 text-primary dark:text-primary-dark" />
              <span class="text-lg font-bold tracking-wide">Suivez-nous</span>
            </div>
            <div class="flex-1">
              <div class="mb-4">
                <p class="text-xs font-medium tracking-wide text-text-secondary dark:text-text-secondary-dark mb-2">INSTAGRAM</p>
                <p class="text-lg">Actualités, photos d'entraînements, évènements du club</p>
              </div>
            </div>
            <a
              href="https://instagram.com/slamm35800"
              target="_blank"
              rel="noopener noreferrer"
              class="btn card-border w-full py-2 text-center text-primary dark:text-primary-dark font-bold mt-4 hover:bg-[#E4405F] hover:text-white hover:border-[#E4405F] gap-2"
            >
              Voir le profil
              <Icon name="mdi:open-in-new" class="w-4 h-4 opacity-70" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Practical info -->
    <section class="mt-12">
      <h2 class="heading-border text-[clamp(1.75rem,3vw,2rem)] font-normal leading-tight mb-6">
        Informations pratiques
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="card-border p-6 flex flex-col items-center text-center h-full">
          <Icon name="mdi:parking" class="w-12 h-12 text-primary dark:text-primary-dark mb-4" />
          <h3 class="text-lg font-bold mb-2">Parking gratuit</h3>
          <p class="text-sm text-text-secondary dark:text-text-secondary-dark">Stationnement gratuit disponible sur place</p>
        </div>
        <div class="card-border p-6 flex flex-col items-center text-center h-full">
          <Icon name="mdi:stairs" class="w-12 h-12 text-primary dark:text-primary-dark mb-4" />
          <h3 class="text-lg font-bold mb-2">Entraînement à l'étage</h3>
          <p class="text-sm text-text-secondary dark:text-text-secondary-dark">Le dojo se situe au premier étage du bâtiment</p>
        </div>
        <div class="card-border p-6 flex flex-col items-center text-center h-full">
          <Icon name="mdi:human-male-female" class="w-12 h-12 text-primary dark:text-primary-dark mb-4" />
          <h3 class="text-lg font-bold mb-2">Vestiaires séparés</h3>
          <p class="text-sm text-text-secondary dark:text-text-secondary-dark">Vestiaires homme et femme disponibles</p>
        </div>
      </div>
    </section>

    <!-- Map -->
    <section class="mt-12">
      <h2 class="heading-border text-[clamp(1.75rem,3vw,2rem)] font-normal leading-tight mb-6">
        Plan d'accès
      </h2>
      <div class="h-[300px] md:h-[400px] card-border overflow-hidden">
        <LeafletMap client:only="react" />
      </div>
    </section>
  </div>
</BaseLayout>
