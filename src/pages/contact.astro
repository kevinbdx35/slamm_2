---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeafletMap from '../components/LeafletMap.jsx';
---

<BaseLayout
  title="Contact SLAMM | Club MMA Saint-Lunaire, Dinard, Saint-Malo"
  description="Contactez le club SLAMM MMA à Saint-Lunaire. À 5 min de Dinard, 15 min de Saint-Malo, accessible depuis Pleurtuit, Dinan, Cancale et la Côte d'Émeraude."
  url="https://mma-saint-lunaire.fr/contact"
  keywords="contact MMA Saint-Lunaire, adresse club MMA Dinard, inscription MMA Saint-Malo, club sport combat Pleurtuit, dojo MMA Côte d'Émeraude, téléphone SLAMM, inscription MMA Dinan"
>
  <div class="py-12 mb-20 max-w-[1200px] mx-auto w-full px-6">
    <header class="section-border pb-4">
      <h1 class="text-[clamp(2.25rem,4vw,3.5rem)] font-normal tracking-tight leading-tight mb-6">
        Nous contacter
      </h1>
      <p class="text-base tracking-wide leading-relaxed max-w-[1000px]">
        Une question sur les cours, les inscriptions ou le club ? Voici comment nous contacter.
      </p>
    </header>

    <!-- Contact cards -->
    <section class="mt-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- WhatsApp -->
        <div class="card-border flex flex-col overflow-hidden">
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center mb-6">
              <svg class="w-7 h-7 mr-2 text-primary dark:text-primary-dark" fill="currentColor" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
              <span class="text-lg font-bold tracking-wide">Contact Rapide</span>
            </div>
            <div class="flex-1">
              <div class="mb-4">
                <p class="text-xs font-medium tracking-wide text-text-secondary dark:text-text-secondary-dark mb-2">WhatsApp / Téléphone</p>
                <p class="text-lg">07 82 77 92 88</p>
              </div>
            </div>
            <a
              href="https://wa.me/33782779288?text=Bonjour%2C%20je%20souhaite%20des%20informations%20sur%20le%20club%20de%20MMA."
              target="_blank"
              rel="noopener noreferrer"
              class="btn card-border w-full py-2 text-center text-primary dark:text-primary-dark font-bold mt-4 hover:bg-[#25D366] hover:text-white hover:border-[#25D366]"
            >
              Écrire sur WhatsApp
            </a>
          </div>
        </div>

        <!-- Other contacts -->
        <div class="card-border flex flex-col overflow-hidden">
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center mb-6">
              <svg class="w-7 h-7 mr-2 text-primary dark:text-primary-dark" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
              </svg>
              <span class="text-lg font-bold tracking-wide">Autres contacts</span>
            </div>
            <div class="flex-1">
              <div class="mb-4">
                <p class="text-xs font-medium tracking-wide text-text-secondary dark:text-text-secondary-dark mb-2">EMAIL</p>
                <a href="mailto:slamm35800@gmail.com" class="text-lg text-primary dark:text-primary-dark underline decoration-brand-neonGreen/60 underline-offset-[3px] decoration-[1.5px] hover:bg-brand-neonGreen/[0.08] rounded px-1 py-0.5 transition-all">
                  slamm35800@gmail.com
                </a>
              </div>
              <div class="mb-4">
                <p class="text-xs font-medium tracking-wide text-text-secondary dark:text-text-secondary-dark mb-2">INSTAGRAM</p>
                <a href="https://instagram.com/slamm35800" target="_blank" rel="noopener noreferrer" class="text-lg text-primary dark:text-primary-dark underline decoration-brand-neonGreen/60 underline-offset-[3px] decoration-[1.5px] hover:bg-brand-neonGreen/[0.08] rounded px-1 py-0.5 transition-all">
                  @slamm35800
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Location -->
        <div class="card-border flex flex-col overflow-hidden">
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center mb-6">
              <svg class="w-7 h-7 mr-2 text-primary dark:text-primary-dark" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
              </svg>
              <span class="text-lg font-bold tracking-wide">Nous trouver</span>
            </div>
            <div class="flex-1">
              <div class="mb-4">
                <p class="text-xs font-medium tracking-wide text-text-secondary dark:text-text-secondary-dark mb-2">SIÈGE SOCIAL</p>
                <p class="text-lg">Boulevard Flusson (Mairie)<br />35800 Saint-Lunaire</p>
              </div>
              <div class="mb-4">
                <p class="text-xs font-medium tracking-wide text-text-secondary dark:text-text-secondary-dark mb-2">LIEU D'ENTRAÎNEMENT</p>
                <p class="text-lg">361 Rue de la Saudrais<br />35800 Saint-Lunaire</p>
              </div>
            </div>
            <a
              href="https://www.google.com/maps/dir//48.629194657231274,-2.1120771896734203"
              target="_blank"
              rel="noopener noreferrer"
              class="btn card-border w-full py-2 text-center text-primary dark:text-primary-dark font-bold mt-4 hover:bg-[#4285F4] hover:text-white hover:border-[#4285F4]"
            >
              Itinéraire
            </a>
          </div>
        </div>

        <!-- Social -->
        <div class="card-border flex flex-col overflow-hidden">
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center mb-6">
              <svg class="w-7 h-7 mr-2 text-primary dark:text-primary-dark" fill="currentColor" viewBox="0 0 24 24">
                <path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z"/>
              </svg>
              <span class="text-lg font-bold tracking-wide">Suivez-nous</span>
            </div>
            <div class="flex-1">
              <div class="mb-4">
                <p class="text-xs font-medium tracking-wide text-text-secondary dark:text-text-secondary-dark mb-2">INSTAGRAM</p>
                <p class="text-lg">Actualités, photos d'entraînements, évènements du club</p>
              </div>
            </div>
            <a
              href="https://instagram.com/slamm35800"
              target="_blank"
              rel="noopener noreferrer"
              class="btn card-border w-full py-2 text-center text-primary dark:text-primary-dark font-bold mt-4 hover:bg-[#E4405F] hover:text-white hover:border-[#E4405F]"
            >
              Voir le profil
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Practical info -->
    <section class="mt-12">
      <h2 class="heading-border text-[clamp(1.75rem,3vw,2rem)] font-normal leading-tight mb-6">
        Informations pratiques
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="card-border p-6 flex flex-col items-center text-center h-full">
          <svg class="w-12 h-12 text-primary dark:text-primary-dark mb-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M13 3H6v18h4v-6h3c3.31 0 6-2.69 6-6s-2.69-6-6-6zm.2 8H10V7h3.2c1.1 0 2 .9 2 2s-.9 2-2 2z"/>
          </svg>
          <h3 class="text-lg font-bold mb-2">Parking gratuit</h3>
          <p class="text-sm text-text-secondary dark:text-text-secondary-dark">Stationnement gratuit disponible sur place</p>
        </div>
        <div class="card-border p-6 flex flex-col items-center text-center h-full">
          <svg class="w-12 h-12 text-primary dark:text-primary-dark mb-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M3 21h6v-6h4v-4h4V7h4V3h-8v4H9v4H3v10z"/>
          </svg>
          <h3 class="text-lg font-bold mb-2">Entraînement à l'étage</h3>
          <p class="text-sm text-text-secondary dark:text-text-secondary-dark">Le dojo se situe au premier étage du bâtiment</p>
        </div>
        <div class="card-border p-6 flex flex-col items-center text-center h-full">
          <svg class="w-12 h-12 text-primary dark:text-primary-dark mb-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M5.5 22v-7.5H4V9c0-1.1.9-2 2-2h3c1.1 0 2 .9 2 2v5.5H9.5V22h-4zM18 22v-6h3l-2.54-7.63A2.01 2.01 0 0 0 16.56 7h-.12a2 2 0 0 0-1.9 1.37L12 16h3v6h3zM7.5 6c1.11 0 2-.89 2-2s-.89-2-2-2-2 .89-2 2 .89 2 2 2zm9 0c1.11 0 2-.89 2-2s-.89-2-2-2-2 .89-2 2 .89 2 2 2z"/>
          </svg>
          <h3 class="text-lg font-bold mb-2">Vestiaires séparés</h3>
          <p class="text-sm text-text-secondary dark:text-text-secondary-dark">Vestiaires homme et femme disponibles</p>
        </div>
      </div>
    </section>

    <!-- Map -->
    <section class="mt-12">
      <h2 class="heading-border text-[clamp(1.75rem,3vw,2rem)] font-normal leading-tight mb-6">
        Plan d'accès
      </h2>
      <div class="h-[300px] md:h-[400px] card-border overflow-hidden">
        <LeafletMap client:only="react" />
      </div>
    </section>
  </div>
</BaseLayout>
