---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { generatePersonSchema } from '../utils/schemaGenerator.js';

// Fonction pour déterminer l'icône selon le type de diplôme
function getDiplomaIcon(diploma: string): string {
  if (diploma.includes('PSC') || diploma.includes('PSE')) return 'mdi:medical-bag';
  if (diploma.includes('Référent')) return 'mdi:star-circle';
  if (diploma.includes('BF')) return 'mdi:certificate';
  return 'mdi:check-circle';
}

const teamMembers = [
  {
    name: 'Malik',
    role: 'Président',
    initials: 'M',
    color: '#1976d2',
    diplomas: ['BF1 et BF2 de MMA - FMMAF', 'PSC1'],
  },
  {
    name: 'Miguel',
    role: 'Vice-Président',
    initials: 'Mi',
    color: '#2e7d32',
    diplomas: ['BF1 et BF2 de MMA - FMMAF', 'PSE1 et PSE2'],
  },
  {
    name: 'Thomas',
    role: 'Trésorier',
    initials: 'T',
    color: '#d32f2f',
    diplomas: ['BF1 et BF2 de MMA - FMMAF', 'Référent pieds / poings', 'PSC1'],
  },
  {
    name: 'Kévin',
    role: 'Secrétaire',
    initials: 'K',
    color: '#512da8',
    diplomas: [
      'BF1 et BF2 de MMA - FMMAF',
      'BF1 de grappling et grappling fight - FFL',
      'Référent lutte / sol',
      'PSC1',
    ],
  },
];

const teamSchemas = teamMembers.map(member => generatePersonSchema(member));
---

<BaseLayout
  title="Coachs MMA Saint-Lunaire, Dinard, Saint-Malo | Équipe SLAMM diplômée FMMAF"
  description="Rencontrez nos coachs MMA diplômés FMMAF à Saint-Lunaire. Encadrement professionnel pour les pratiquants de Dinard, Saint-Malo et toute la Côte d'Émeraude. BF1, BF2, PSC1."
  url="https://mma-saint-lunaire.fr/equipe"
  keywords="coach MMA Saint-Lunaire, entraîneur MMA Dinard, instructeur MMA Saint-Malo, professeur MMA Côte d'Émeraude, équipe SLAMM, diplômé FMMAF Bretagne"
  schemas={teamSchemas}
>
  <div class="py-12 mb-20 max-w-[1200px] mx-auto w-full px-6">
    <header class="section-border pb-4">
      <h1 class="text-[clamp(2.25rem,4vw,3.5rem)] font-normal tracking-tight leading-tight mb-6">
        L'Équipe SLAMM
      </h1>
      <p class="text-base tracking-wide leading-relaxed max-w-[1000px]">
        SLAMM association loi 1901 est née de la vision partagée de trois passionnés de MMA (Kévin, Malik, Thomas), chacun apportant des compétences complémentaires. Seule association de MMA de la Côte d'Émeraude, nous rassemblons plus de 30 membres de 16 à 50 ans. Nous encourageons une pratique loisirs basée sur la bienveillance, le respect et l'écoute mutuelle, afin de permettre à chaque membre de travailler et de progresser dans un environnement adapté à ses envies et à ses capacités physiques.
      </p>
    </header>

    <!-- Chiffres clés -->
    <section class="mt-12 flex flex-col sm:flex-row justify-around text-center gap-6">
      <div>
        <span class="block text-[clamp(2.5rem,6vw,4rem)] font-bold text-primary dark:text-primary-dark leading-none">30+</span>
        <span class="text-sm tracking-wide">adhérents</span>
      </div>
      <div>
        <span class="block text-[clamp(2.5rem,6vw,4rem)] font-bold text-primary dark:text-primary-dark leading-none">16–50</span>
        <span class="text-sm tracking-wide">ans</span>
      </div>
      <div>
        <span class="block text-[clamp(1.5rem,5vw,4rem)] font-bold text-primary dark:text-primary-dark leading-none">Mixte</span>
        <span class="text-sm tracking-wide">tous niveaux</span>
      </div>
    </section>

    <section class="mt-12">
      <h2 class="heading-border text-[clamp(1.75rem,3vw,2rem)] font-normal leading-tight mb-4">
        Membres du bureau
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-8">
        {teamMembers.map(({ name, role, initials, diplomas, color }) => (
          <div class="card-border rounded-md3 p-6 flex flex-col items-center text-center">
            <div
              class="w-16 h-16 rounded-full flex items-center justify-center text-white font-bold text-xl mb-4"
              style={`background-color: ${color}`}
            >
              {initials}
            </div>
            <div class="text-base font-bold tracking-wide">{name}</div>
            <span class="mt-2 inline-block px-4 py-1 text-xs font-bold tracking-wide rounded-full bg-primary dark:bg-primary-dark text-white dark:text-background-dark">
              {role}
            </span>
            <hr class="w-full border-outline dark:border-outline-dark my-4" />
            <ul class="pl-0 m-0 list-none w-full text-left">
              {diplomas.map((d) => (
                <li class="flex items-center gap-2 mb-1">
                  <Icon name={getDiplomaIcon(d)} class="w-4 h-4 text-primary dark:text-primary-dark flex-shrink-0" />
                  <span class="text-sm leading-relaxed tracking-wide">{d}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="mt-16 mb-8">
      <div class="card-border p-6 flex flex-col sm:flex-row items-center justify-between gap-4 bg-surface-variant/30 dark:bg-surface-variant-dark/30">
        <div class="flex items-center gap-4">
          <Icon name="mdi:account-group" class="w-10 h-10 text-primary dark:text-primary-dark flex-shrink-0" />
          <div>
            <h3 class="text-lg font-bold">Envie de rejoindre l'équipe ?</h3>
            <p class="text-sm text-text-secondary dark:text-text-secondary-dark">Découvre nos cours et réserve ta séance d'essai.</p>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
          <a href="/cours" class="btn-primary py-2 px-6 text-center whitespace-nowrap w-full sm:w-auto">
            Voir les cours
          </a>
          <a href="/contact" class="btn-secondary py-2 px-6 text-center whitespace-nowrap w-full sm:w-auto">
            Contact
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
