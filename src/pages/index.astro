---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Essentials from '../components/Essentials.astro';
import Testimonials from '../components/Testimonials.astro';
import Partners from '../components/Partners.astro';
import Footer from '../components/Footer.astro';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Saint-Lunaire MMA',
  url: 'https://mma-saint-lunaire.fr',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://mma-saint-lunaire.fr/?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
---

<Layout
  title="Saint-Lunaire MMA"
  description="Club de MMA à Saint-Lunaire, Bretagne. Association loi 1901. Entraînement, compétition, bien-être."
  pageSchema={websiteSchema}
>
  <Nav />
  <main id="main">
    <Hero />
    <About />
    <Essentials />
    <Testimonials />
    <Partners />
  </main>
  <Footer />
</Layout>
