---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PARTNER_URLS } from '../config/urls.js';
import { generateSportsClubSchema, generateLocalBusinessSchema } from '../utils/schemaGenerator.js';

const schemas = [generateSportsClubSchema(), generateLocalBusinessSchema()];

const partners = [
  { name: 'Saint-lunaire', logo: 'img/partenaires/stlunaire.webp', url: PARTNER_URLS.SAINT_LUNAIRE },
  { name: 'FMMAF', logo: 'img/partenaires/fmmaf.webp', url: PARTNER_URLS.FMMAF },
  { name: 'Progress', logo: 'img/partenaires/progress.webp', url: PARTNER_URLS.PROGRESS },
  { name: 'RDX', logo: 'img/partenaires/rdx.webp', url: PARTNER_URLS.RDX },
];

const images = [
  { id: 'miguel', src: '/img/team/miguel.webp', alt: "Victoire de Miguel en NoGi" },
  { id: 'team', src: '/img/team/team.webp', alt: "Une partie de l'équipe 2025-2026" },
  { id: 'florian', src: '/img/team/photo1_scale,w_1400.webp', alt: 'Victoire de Florian en MMA', srcset: '/img/team/photo1_scale,w_200.webp 200w, /img/team/photo1_scale,w_400.webp 400w, /img/team/photo1_scale,w_525.webp 525w, /img/team/photo1_scale,w_704.webp 704w, /img/team/photo1_scale,w_914.webp 914w, /img/team/photo1_scale,w_1104.webp 1104w, /img/team/photo1_scale,w_1314.webp 1314w, /img/team/photo1_scale,w_1400.webp 1400w' },
  { id: 'cage', src: '/img/team/cage.webp', alt: 'Travail du cage control' },
];
---

<BaseLayout
  title="Club MMA Saint-Lunaire, Dinard, Saint-Malo | SLAMM Arts Martiaux Mixtes"
  description="SLAMM, club de MMA à Saint-Lunaire sur la Côte d'Émeraude. À 5 min de Dinard, 15 min de Saint-Malo. Cours d'arts martiaux mixtes tous niveaux, coachs diplômés FMMAF. Essai gratuit !"
  keywords="club MMA Saint-Lunaire, MMA Dinard, MMA Saint-Malo, arts martiaux mixtes Côte d'Émeraude, cours MMA Bretagne, SLAMM MMA, club combat Saint-Lunaire, MMA Pleurtuit, MMA Dinan"
  schemas={schemas}
>
  <!-- Hero Section -->
  <section
    class="relative min-h-[50vh] sm:min-h-[60vh] md:min-h-[70vh] flex items-center bg-cover bg-center bg-no-repeat section-border -mx-4 md:-mx-6"
    style="background-image: url('https://images.unsplash.com/photo-1611077492881-8d15417d0d38?q=80&w=1470&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D')"
  >
    <div class="absolute inset-0 bg-[rgba(46,125,50,0.7)] z-[1]"></div>
    <div class="max-w-7xl mx-auto px-4 md:px-6 relative z-[2] w-full">
      <div class="text-center text-white">
        <h1 class="text-[1.8rem] sm:text-[2.2rem] md:text-[2.8rem] lg:text-[3.2rem] font-normal tracking-tight leading-tight mb-4 text-white" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.3)">
          Saint-Lunaire Arts Martiaux Mixtes
        </h1>
        <p class="text-base tracking-wide leading-relaxed mb-4 max-w-[800px] mx-auto text-white" style="text-shadow: 1px 1px 2px rgba(0,0,0,0.3)">
          Découvre les arts martiaux mixtes avec nos instructeurs certifiés.
        </p>
        <p class="text-base tracking-wide leading-relaxed mb-8 max-w-[800px] mx-auto text-white" style="text-shadow: 1px 1px 2px rgba(0,0,0,0.3)">
          À partir de 16 ans - Tous niveaux bienvenus.
        </p>
        <div class="flex gap-4 justify-center flex-wrap">
          <a
            href="/cours"
            class="btn border-[3px] border-white text-white py-3 px-8 text-lg bg-white/10 backdrop-blur-[10px] hover:bg-brand-neonGreen hover:text-brand-darkBg hover:border-brand-neonGreen hover:-translate-y-0.5 hover:shadow-[0_8px_16px_rgba(0,255,94,0.3)]"
            aria-label="Découvrir nos cours de MMA et arts martiaux mixtes à Saint-Lunaire"
          >
            Découvrir nos cours
          </a>
          <a
            href="/contact"
            class="btn border-2 border-white text-white py-3 px-8 text-lg bg-white/10 backdrop-blur-[10px] hover:bg-brand-orange hover:text-white hover:border-brand-orange hover:-translate-y-0.5 hover:shadow-[0_4px_8px_rgba(255,107,53,0.3)]"
            aria-label="Contacter le club SLAMM pour une séance d'essai gratuite"
          >
            Nous contacter
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Header section -->
  <header class="section-border pb-4 mt-8">
    <h2 class="text-[clamp(1.75rem,3vw,2rem)] font-normal leading-tight mb-4 tracking-tight">
      Saint-Lunaire Arts Martiaux Mixtes - Académie de MMA
    </h2>
    <p class="text-base tracking-wide leading-relaxed max-w-[1000px] mt-2">
      Association loi 1901 dédiée à l'enseignement et la pratique des Arts Martiaux Mixtes depuis 2023. Basé à Saint-Lunaire, notre club accueille les pratiquants de Dinard, Saint-Malo, Pleurtuit, La Richardais, Dinan, Cancale, Saint-Briac, Lancieux et toute la Côte d'Émeraude. Découvre nos cours, notre ambiance, et rejoins-nous pour pratiquer le MMA.
    </p>
  </header>

  <!-- Image gallery -->
  <div class="flex gap-4 my-8 justify-center flex-wrap md:flex-nowrap">
    {images.map((image) => (
      <div class="flex-[0_0_calc(50%-8px)] md:flex-[0_0_calc(25%-12px)]">
        <img
          src={image.src}
          srcset={image.srcset}
          sizes="(max-width: 900px) 50vw, 25vw"
          alt={image.alt}
          title={image.alt}
          loading={image.id === 'miguel' ? 'eager' : 'lazy'}
          fetchpriority={image.id === 'miguel' ? 'high' : 'auto'}
          class="img-border w-full aspect-square object-cover"
        />
      </div>
    ))}
  </div>

  <!-- MMA section -->
  <section class="mt-12">
    <h3 class="heading-border text-[1.75rem] font-normal leading-snug mb-4">
      Mixed Martial Arts - MMA
    </h3>
    <p class="text-sm tracking-wide leading-relaxed max-w-[1000px]">
      Les arts martiaux mixtes (mixed martial arts) sont un sport de combat complet qui combine plusieurs disciplines de combat différentes, telles que la boxe, la lutte, la luta livre, le kickboxing, le muay thaï, etc. Il y a généralement trois phases dans un combat de MMA : la phase debout, la phase de corps à corps et la phase au sol. Notre académie à Saint-Lunaire propose des cours de MMA accessibles aux habitants de Dinard, Saint-Malo, Pleurtuit, La Richardais, Dinan, Cancale, Saint-Briac, Lancieux, Ploubalay et toute la Côte d'Émeraude.
    </p>
  </section>

  <!-- Benefits section -->
  <section class="mt-12">
    <h3 class="heading-border text-[1.75rem] font-normal leading-snug mb-4">
      Les bénéfices du MMA
    </h3>
    <p class="text-sm tracking-wide leading-relaxed max-w-[1000px]">
      Les arts martiaux mixtes, discipline complète qui combine différentes techniques, offrent de nombreux bénéfices. Le MMA améliore la condition physique, renforce la confiance en soi et développe des compétences en autodéfense. Les entraînements de mixed martial arts permettent de libérer le stress accumulé, favorisent l'esprit de camaraderie et le respect envers les autres pratiquants.
    </p>

    <div class="flex gap-4 my-8 flex-col md:flex-row">
      <div class="flex-1">
        <img
          src="/img/team2/equipe1_scale,w_1400.webp"
          srcset="/img/team2/equipe1_scale,w_200.webp 200w, /img/team2/equipe1_scale,w_637.webp 637w, /img/team2/equipe1_scale,w_955.webp 955w, /img/team2/equipe1_scale,w_1266.webp 1266w, /img/team2/equipe1_scale,w_1400.webp 1400w"
          sizes="(max-width: 900px) 100vw, 50vw"
          alt="Une partie de l'équipe SLAMM de la saison 2024-2025"
          title="Une partie de l'équipe SLAMM de la saison 2024-2025"
          loading="lazy"
          class="img-border w-full"
        />
      </div>
      <div class="flex-1">
        <img
          src="/img/team2/cours_2025-2026_scale,w_1400.webp"
          srcset="/img/team2/cours_2025-2026_scale,w_200.webp 200w, /img/team2/cours_2025-2026_scale,w_637.webp 637w, /img/team2/cours_2025-2026_scale,w_955.webp 955w, /img/team2/cours_2025-2026_scale,w_1266.webp 1266w, /img/team2/cours_2025-2026_scale,w_1400.webp 1400w"
          sizes="(max-width: 900px) 100vw, 50vw"
          alt="Cours saison 2025-2026"
          title="Cours saison 2025-2026"
          loading="lazy"
          class="img-border w-full"
        />
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="mt-12">
    <h3 class="heading-border text-[1.75rem] font-normal leading-snug mb-4">
      Ils témoignent
    </h3>
    <p class="text-sm tracking-wide leading-relaxed max-w-[1000px] mb-8">
      Découvrez ce que nos adhérents pensent de leur expérience au sein du club.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="card-border p-6 flex flex-col h-full">
        <p class="text-base tracking-wide leading-relaxed italic flex-1 mb-4">
          "La pratique du MMA m'a apporté discipline, confiance en moi et une condition physique optimale. C'est bien plus qu'un sport, c'est un mode de vie qui m'a renforcé mentalement et physiquement."
        </p>
        <div>
          <p class="text-xs font-bold tracking-wide text-primary dark:text-primary-dark">Miguel</p>
          <span class="text-[0.6875rem] font-medium tracking-wide text-text-secondary dark:text-text-secondary-dark">Adhérent depuis 2024</span>
        </div>
      </div>

      <div class="card-border p-6 flex flex-col h-full">
        <p class="text-base tracking-wide leading-relaxed italic flex-1 mb-4">
          "Je pratique le MMA depuis septembre 2024 et ça m'a appris beaucoup de choses sur moi que j'ignorais : le dépassement de soi, la condition physique et le mental. Je me sens bien mieux depuis que j'ai découvert cette pratique qui, depuis mon inscription, m'anime jour et nuit."
        </p>
        <div>
          <p class="text-xs font-bold tracking-wide text-primary dark:text-primary-dark">Florian</p>
          <span class="text-[0.6875rem] font-medium tracking-wide text-text-secondary dark:text-text-secondary-dark">Adhérent de 2024 à 2026</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Partners -->
  <section class="mt-12 mb-16">
    <h3 class="heading-border text-[1.75rem] font-normal leading-snug mb-4">
      Nos partenaires
    </h3>
    <p class="text-sm tracking-wide leading-relaxed max-w-[1000px] mb-8">
      Notre association remercie chaleureusement les institutions, partenaires techniques, sponsors privés et amis du club pour leur soutien dans le développement de notre projet associatif et sportif.
    </p>
    <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-4 gap-8 justify-center">
      {partners.map((partner) => (
        <div class="text-center">
          <a
            href={partner.url}
            target="_blank"
            rel="noopener noreferrer"
            class="w-[150px] h-[100px] card-border rounded bg-white flex items-center justify-center mx-auto mb-2 no-underline transition-transform duration-200 hover:scale-105"
          >
            <img
              src={partner.logo}
              alt={`Logo de ${partner.name}`}
              title={partner.name}
              loading="lazy"
              class="max-w-full max-h-full object-contain"
            />
          </a>
          <span class="text-[0.6875rem] font-medium tracking-wide flex items-center justify-center gap-1">
            {partner.name}
            {partner.url.startsWith('http') && (
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/></svg>
            )}
          </span>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
