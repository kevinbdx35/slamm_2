---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const categories = [
  {
    title: 'Hygiène corporelle',
    rules: [
      {
        title: "Avant l'entraînement",
        content: "Bonne hygiène personnelle avant chaque cours. Ongles coupés courts et propres. Cheveux longs attachés. Pas de bijoux (bagues, colliers, boucles d'oreilles).",
        priority: 'high',
      },
      {
        title: "Après l'entraînement",
        content: "Douche recommandée dans les 15 minutes avec un savon antibactérien. Porter des tongs dans les douches et vestiaires. Changement complet de vêtements.",
        priority: 'medium',
      },
      {
        title: 'Tenue vestimentaire',
        content: "Tenue propre lavée après chaque séance. Torse nu interdit. Rashguard manches longues et legging recommandés. Short sans poches ni fermetures. Pas pieds nus en dehors du tatami.",
        priority: 'high',
      },
      {
        title: 'Hydratation',
        content: "S'hydrater avant, pendant et après l'entraînement. Bouteille d'eau individuelle obligatoire.",
        priority: 'medium',
      },
    ],
  },
  {
    title: 'Équipements personnels',
    rules: [
      {
        title: 'Matériel obligatoire',
        content: "Serviette personnelle, bouteille d'eau individuelle, protège-dents personnel. Ne jamais partager ses équipements (gants, protège-tibias, etc.).",
        priority: 'high',
      },
      {
        title: 'Nettoyage du protège-dents',
        content: "Rincer à l'eau claire après chaque utilisation. Nettoyer régulièrement avec du dentifrice ou une solution antiseptique. Laisser sécher à l'air libre avant rangement.",
        priority: 'medium',
      },
      {
        title: 'Gants et protections',
        content: "Nettoyage systématique après usage. Séchage complet avant rangement. Remplacement si usure excessive.",
        priority: 'medium',
      },
      {
        title: 'Sac de sport',
        content: "Compartiment séparé pour les affaires sales. Aération régulière. Nettoyage hebdomadaire.",
        priority: 'low',
      },
    ],
  },
  {
    title: 'Prévention des infections',
    rules: [
      {
        title: 'Infections cutanées',
        content: "Surveiller toute lésion cutanée suspecte. Éviction temporaire si infection active (mycose, impétigo, verrue, teigne). Certificat médical nécessaire pour la reprise.",
        priority: 'high',
      },
      {
        title: 'Blessures ouvertes',
        content: "Désinfection immédiate de toute plaie. Pansement étanche obligatoire. Arrêt de l'entraînement si saignement.",
        priority: 'high',
      },
      {
        title: 'État de santé',
        content: "Ne pas venir en cas de fièvre, gastro-entérite ou infection respiratoire. Respecter les périodes de contagiosité.",
        priority: 'high',
      },
    ],
  },
  {
    title: 'Respect des lieux',
    rules: [
      {
        title: 'Espaces communs',
        content: "Garder les espaces propres : jeter ses déchets, ne pas laisser ses affaires traîner dans les vestiaires ou sur le bord du tatami.",
        priority: 'high',
      },
      {
        title: 'Rangement du matériel',
        content: "Participer au rangement du matériel collectif après chaque séance. À tour de rôle, chacun participe à la désinfection des tatamis.",
        priority: 'high',
      },
      {
        title: 'Protection des tatamis',
        content: "Pas de chaussures, nourriture ou boissons (autres que l'eau) sur les tatamis.",
        priority: 'high',
      },
      {
        title: 'Philosophie du club',
        content: "Le club est comme une deuxième maison : si je salis, je nettoie ; si je casse, je répare.",
        priority: 'high',
      },
    ],
  },
];

const clubMeasures = [
  "Désinfection du matériel partagé entre chaque utilisation",
  "Formation continue des encadrants aux protocoles d'hygiène",
  "Contrôles visuels réguliers de l'état sanitaire des équipements",
  "Collaboration étroite avec la mairie pour l'entretien des locaux",
];

const priorityLabel: Record<string, string> = {
  high: 'Obligatoire',
  medium: 'Recommandé',
  low: 'Conseil',
};

// Statut → style de pastille (palette du site, voir .rule-badge--*)
---

<Layout
  title="Hygiène & Sécurité — Saint-Lunaire MMA"
  description="Règles d'hygiène et protocoles sanitaires pour la pratique du MMA au club Saint-Lunaire. Recommandations pour tous les pratiquants."
>
  <Nav />
  <main id="main">
    <section class="hygiene">
      <div class="container">

        <div class="hygiene-header reveal">
          <h1 class="hygiene-title">
            La santé de tous,<br/>
            <span>la responsabilité de chacun.</span>
          </h1>
          <p class="hygiene-sub">Pour le bien-être de tous les pratiquants, le respect de ces règles d'hygiène est essentiel dans la pratique du MMA.</p>
        </div>

        <div class="alert-warning reveal">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M10 2L2 17h16L10 2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M10 8v4M10 14v1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <p>Le non-respect des règles d'hygiène peut entraîner l'exclusion temporaire ou définitive des entraînements pour préserver la santé de la communauté.</p>
        </div>

        <div class="categories reveal">
          {categories.map((cat, ci) => (
            <div class={`category reveal reveal-delay-${(ci % 3) + 1}`}>
              <h2 class="cat-title">{cat.title}</h2>
              <ul class="rules-list">
                {cat.rules.map(rule => (
                  <li class="rule-row">
                    <div class="rule-header">
                      <h3 class="rule-title">{rule.title}</h3>
                      <span class={`rule-badge rule-badge--${rule.priority}`}>
                        {priorityLabel[rule.priority]}
                      </span>
                    </div>
                    <p class="rule-content">{rule.content}</p>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <div class="club-measures reveal">
          <h2 class="measures-title">Mesures du club</h2>
          <p class="measures-sub">En complément de l'entretien assuré par la mairie de Saint-Lunaire, le club applique ses propres mesures :</p>
          <div class="measures-list">
            {clubMeasures.map(m => (
              <div class="measure-item">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8l3.5 3.5L13 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <p>{m}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="alert-info reveal">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.5"/>
            <path d="M10 9v5M10 7v1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <p><strong>En cas de doute :</strong> n'hésite pas à consulter nos encadrants pour toute question concernant l'hygiène ou les protocoles sanitaires. Ta santé et celle de tes partenaires sont notre priorité.</p>
        </div>

      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* Première section de la page : dégage la nav fixe */
  .hygiene {
    padding: 152px 0 112px;
  }

  /* En-tête empilé : titre puis texte */
  .hygiene-header {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 720px;
    margin-bottom: 40px;
  }

  .hygiene-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .hygiene-title span { color: var(--g400); }

  .hygiene-sub {
    font-size: 17px;
    color: var(--text-3);
    line-height: 1.7;
    max-width: 56ch;
  }

  /* Alerte (seule teinte hors palette) et note neutre : filet à gauche, pas de boîte */
  .alert-warning, .alert-info {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 14px 18px;
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
    max-width: 880px;
  }

  .alert-warning {
    background: var(--warn-bg);
    border-left: 2px solid var(--warn);
    color: var(--warn);
    margin-bottom: 96px;
  }

  .alert-warning p { color: var(--text-2); font-size: 15px; line-height: 1.7; }
  .alert-warning svg { flex-shrink: 0; margin-top: 2px; }

  .alert-info {
    border-left: 2px solid var(--border-strong);
    color: var(--text-3);
  }

  .alert-info p { color: var(--text-3); font-size: 15px; line-height: 1.7; }
  .alert-info strong { color: var(--text-2); }
  .alert-info svg { flex-shrink: 0; margin-top: 2px; }

  /* Catégorie : titre (4/12, visible au défilement) + règles à plat (8/12) */
  .categories {
    display: flex;
    flex-direction: column;
    gap: 80px;
    margin-bottom: 96px;
  }

  .category {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 48px;
    align-items: start;
  }

  .cat-title {
    position: sticky;
    top: 104px;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 800;
    line-height: 1.2;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .rules-list {
    list-style: none;
    border-top: 1px solid var(--border-strong);
  }

  .rule-row {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 0;
    border-bottom: 1px solid var(--border);
  }

  .rule-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .rule-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--text);
  }

  /* Pastilles de statut dans la palette du site */
  .rule-badge {
    font-size: 12px;
    font-weight: 600;
    border: 1px solid;
    border-radius: 100px;
    padding: 3px 12px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .rule-badge--high   { color: var(--g400); border-color: rgba(74,222,128,0.45); background: rgba(34,197,94,0.1); }
  .rule-badge--medium { color: var(--text-2); border-color: var(--border-strong); }
  .rule-badge--low    { color: var(--text-muted); border-color: var(--border); }

  .rule-content {
    font-size: 15px;
    color: var(--text-3);
    line-height: 1.75;
    max-width: 64ch;
  }

  /* Mesures du club : à plat */
  .club-measures {
    padding-top: 40px;
    border-top: 1px solid var(--border-strong);
    margin-bottom: 48px;
    max-width: 880px;
  }

  .measures-title {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.4vw, 30px);
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .measures-sub {
    font-size: 16px;
    color: var(--text-3);
    margin-bottom: 24px;
    line-height: 1.7;
  }

  .measures-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .measure-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 15px;
    color: var(--text-2);
  }

  .measure-item svg {
    color: var(--g500);
    flex-shrink: 0;
    margin-top: 3px;
  }

  @media (max-width: 900px) {
    .hygiene { padding: 128px 0 80px; }
    .category { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .cat-title { position: static; }
    .categories { gap: 56px; margin-bottom: 72px; }
    .alert-warning { margin-bottom: 64px; }
  }

  @media (max-width: 480px) {
    .rule-header { flex-direction: column; align-items: flex-start; gap: 8px; }
  }
</style>
