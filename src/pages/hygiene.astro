---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import Accordion from '../components/Accordion.jsx';

const hygieneRules = [
  {
    category: 'Hygiène corporelle',
    icon: 'mdi:shower',
    rules: [
      { title: "Avant l'entraînement", content: "Je veille à une bonne hygiène personnelle avant chaque cours. Ongles coupés courts et propres. Si j'ai les cheveux longs, je les attache. Pas de bijoux (bagues, colliers, boucles d'oreilles).", priority: 'high' },
      { title: "Après l'entraînement", content: "Douche recommandée dans les 15 minutes après l'entraînement avec un savon antifongique ou antibactérien. Porter des tongs dans les douches et vestiaires pour éviter les mycoses. Changement complet de vêtements. Désinfection des mains.", priority: 'medium' },
      { title: 'Tenue vestimentaire', content: "Tenue propre et adaptée à chaque séance ; lavez-la après chaque entraînement et remplacez les vêtements qui retiennent les odeurs. Torse nu interdit. Rashguard manches longues et legging/spats recommandés pour limiter le contact peau contre peau. Short sans poches ni fermetures. Je ne marche jamais pieds nus en dehors du tatami (prévoir claquettes ou tongs).", priority: 'high' },
      { title: 'Hydratation', content: "Bien s'hydrater avant, pendant et après l'entraînement. Prévoir une bouteille d'eau individuelle et boire régulièrement par petites gorgées tout au long de la séance.", priority: 'medium' },
    ],
  },
  {
    category: 'Équipements personnels',
    icon: 'mdi:bag-personal',
    rules: [
      { title: 'Matériel obligatoire', content: 'Serviette personnelle. Bouteille d\'eau individuelle. Protège-dents personnel. De manière générale, ne jamais partager ses équipements (gants, protège-tibias, etc.).', priority: 'high' },
      { title: 'Nettoyage du protège-dents', content: 'Rincer le protège-dents à l\'eau claire après chaque utilisation. Le nettoyer régulièrement avec du dentifrice ou une solution antiseptique. Le laisser sécher à l\'air libre avant de le ranger dans son boîtier ventilé. Remplacer le protège-dents dès qu\'il présente des signes d\'usure ou de déformation.', priority: 'medium' },
      { title: 'Gants et protections', content: 'Nettoyage systématique des gants et autres protections après usage. Séchage complet avant rangement. Remplacement si usure excessive.', priority: 'medium' },
      { title: 'Sac de sport', content: 'Compartiment séparé pour les affaires sales. Aération régulière du sac. Nettoyage hebdomadaire.', priority: 'low' },
    ],
  },
  {
    category: 'Prévention des infections',
    icon: 'mdi:shield-plus',
    rules: [
      { title: 'Infections cutanées', content: "Surveillance de toute lésion cutanée suspecte. Éviction temporaire si infection active (mycose, impétigo, verrue, teigne). Certificat médical nécessaire pour la reprise.", priority: 'high' },
      { title: 'Blessures ouvertes', content: "Désinfection immédiate de toute plaie. Pansement étanche obligatoire. Arrêt de l'entraînement si saignement.", priority: 'high' },
      { title: 'État de santé', content: 'Ne pas venir en cas de fièvre, gastro-entérite ou infection respiratoire. Respecter les périodes de contagiosité.', priority: 'high' },
    ],
  },
  {
    category: 'Respect des lieux',
    icon: 'mdi:home',
    rules: [
      { title: 'Espaces communs', content: "Je garde les espaces communs propres : je jette mes déchets dans les poubelles, je ne laisse pas mes affaires traîner dans les vestiaires ou sur le bord du tatami.", priority: 'high' },
      { title: 'Rangement du matériel', content: "Je participe au rangement du matériel collectif après chaque séance : paos et pattes d'ours rangés à leur emplacement, zone d'entraînement laissée propre pour le prochain cours. À tour de rôle, chacun participe à la désinfection des tatamis.", priority: 'high' },
      { title: 'Protection des tatamis', content: "Pas de chaussures, nourriture ou boissons (autres que l'eau) sur les tatamis.", priority: 'high' },
      { title: 'Philosophie du club', content: 'Le club est comme une deuxième maison : si je salis, je nettoie ; si je casse, je répare.', priority: 'high' },
    ],
  },
];

const clubMeasures = [
  "Désinfection du matériel partagé entre chaque utilisation",
  "Formation continue des encadrants aux protocoles d'hygiène",
  "Contrôles visuels réguliers de l'état sanitaire des équipements",
  "Collaboration étroite avec la mairie pour l'entretien des locaux",
];

function getPriorityLabel(priority) {
  switch (priority) {
    case 'high': return 'Obligatoire';
    case 'medium': return 'Recommandé';
    case 'low': return 'Conseil';
    default: return '';
  }
}

function getPriorityColor(priority) {
  switch (priority) {
    case 'high': return 'text-error dark:text-error-dark border-error dark:border-error-dark';
    case 'medium': return 'text-warning dark:text-warning-dark border-warning dark:border-warning-dark';
    case 'low': return 'text-info dark:text-info-dark border-info dark:border-info-dark';
    default: return '';
  }
}

// Prepare items with pre-computed priority info for the Accordion
const hygieneRulesWithMeta = hygieneRules.map((category) => ({
  ...category,
  rules: category.rules.map((rule) => ({
    ...rule,
    priorityLabel: getPriorityLabel(rule.priority),
    priorityColor: getPriorityColor(rule.priority),
  })),
}));
---

<BaseLayout
  title="Hygiène MMA Saint-Lunaire, Dinard, Saint-Malo | Règles sanitaires SLAMM"
  description="Règles d'hygiène et protocoles de sécurité pour la pratique du MMA au club SLAMM Saint-Lunaire. Recommandations pour pratiquants de Dinard, Saint-Malo, Côte d'Émeraude."
  url="https://mma-saint-lunaire.fr/hygiene"
  keywords="hygiène MMA Saint-Lunaire, sécurité club MMA Dinard, protocole sanitaire dojo Saint-Malo, règles hygiène arts martiaux Bretagne"
>
  <div class="mt-8 px-6 max-w-[1200px] mx-auto w-full mb-20">
    <header class="section-border pb-4">
      <h1 class="text-[clamp(2.25rem,4vw,3.5rem)] font-normal tracking-tight leading-tight mb-6">
        Hygiène & Sécurité Sanitaire
      </h1>
      <p class="text-base tracking-wide leading-relaxed max-w-[1000px]">
        Pour la santé et le bien-être de tous nos pratiquants, le respect de ces règles d'hygiène est essentiel dans la pratique du MMA.
      </p>
    </header>

    <!-- Warning alert -->
    <div class="mt-8 mb-8 flex items-start gap-3 p-4 rounded-md3 border border-warning dark:border-warning-dark bg-warning/5 dark:bg-warning-dark/5">
      <Icon name="mdi:alert" class="w-6 h-6 text-warning dark:text-warning-dark flex-shrink-0 mt-0.5" />
      <p class="text-sm font-medium">
        Le non-respect des règles d'hygiène peut entraîner l'exclusion temporaire ou définitive des entraînements pour préserver la santé de la communauté.
      </p>
    </div>

    <div class="mt-12">
      <h2 class="heading-border text-[clamp(1.75rem,3vw,2rem)] font-normal leading-tight mb-6">
        Règles d'hygiène par catégorie
      </h2>

      {hygieneRulesWithMeta.map((category) => (
        <div class="mb-8">
          <div class="flex items-center mb-4">
            <Icon name={category.icon} class="w-6 h-6 text-primary dark:text-primary-dark mr-2" />
            <h3 class="text-[1.75rem] font-semibold">{category.category}</h3>
          </div>

          <Accordion
            items={category.rules}
            variant="hygiene"
            client:load
          />
        </div>
      ))}
    </div>

    <hr class="border-primary dark:border-primary-dark border-[1px] my-12" />

    <div>
      <h2 class="heading-border text-[clamp(1.75rem,3vw,2rem)] font-normal leading-tight mb-6">
        Mesures du club SLAMM
      </h2>
      <p class="text-base tracking-wide leading-relaxed mb-6">
        En complément de l'entretien assuré par la mairie de Saint-Lunaire, le club SLAMM applique ses propres mesures d'hygiène :
      </p>

      <div class="grid gap-4">
        {clubMeasures.map((measure) => (
          <div class="flex items-center gap-4">
            <Icon name="mdi:check-circle" class="w-5 h-5 text-primary dark:text-primary-dark flex-shrink-0" />
            <p class="text-base leading-relaxed">{measure}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Info alert -->
    <div class="mt-12 flex items-start gap-3 p-4 rounded-md3 border border-info dark:border-info-dark bg-info/5 dark:bg-info-dark/5">
      <Icon name="mdi:shield-plus" class="w-6 h-6 text-info dark:text-info-dark flex-shrink-0 mt-0.5" />
      <p class="text-sm">
        <strong>En cas de doute :</strong> N'hésite pas à consulter nos encadrants pour toute question concernant l'hygiène ou les protocoles sanitaires. Ta santé et celle de tes partenaires d'entraînement sont notre priorité.
      </p>
    </div>
  </div>
</BaseLayout>
