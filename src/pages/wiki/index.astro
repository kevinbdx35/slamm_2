---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

const allArticles = await getCollection('wiki', ({ data }) => !data.draft);

// Grouper par catégorie
const categories = allArticles.reduce((acc, article) => {
  const cat = article.data.category;
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(article);
  return acc;
}, {} as Record<string, typeof allArticles>);

// Trier les articles par order dans chaque catégorie
for (const cat of Object.keys(categories)) {
  categories[cat].sort((a, b) => a.data.order - b.data.order);
}

// Ordre des catégories
const categoryOrder = ['Administratif', 'Fonctionnement', 'Sécurité', 'FAQ', 'Pédagogie'];
const sortedCategories = categoryOrder.filter((c) => categories[c]);
---

<BaseLayout
  title="Wiki - SLAMM MMA Saint-Lunaire"
  description="Base de connaissances du club SLAMM : règles, disciplines, glossaire et ressources pour les pratiquants de MMA."
  url="https://mma-saint-lunaire.fr/wiki"
  keywords="wiki MMA, règles MMA, disciplines MMA, glossaire MMA, dojo étiquette, SLAMM"
>
  <main class="container-page py-12 md:py-16">
    <!-- Header -->
    <div class="mb-12">
      <h1 class="text-3xl md:text-4xl font-bold mb-4">
        <span class="heading-border">Wiki</span>
      </h1>
      <p class="text-text-secondary dark:text-text-secondary-dark max-w-2xl text-sm md:text-base">
        Base de connaissances du club. Retrouvez ici les règles, les disciplines enseignées, le glossaire et les ressources utiles pour votre pratique.
      </p>
    </div>

    <!-- Categories -->
    {sortedCategories.map((categoryName) => (
      <section class="mb-12">
        <h2 class="text-xl md:text-2xl font-bold mb-6 heading-border">{categoryName}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {categories[categoryName].map((article) => (
            <a
              href={`/wiki/${article.id}`}
              class="group card-border rounded-md3 p-5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg no-underline bg-surface dark:bg-surface-dark"
            >
              <div class="flex items-start gap-3 mb-3">
                <div class="p-2 rounded-lg bg-primary/10 dark:bg-primary-dark/10 text-primary dark:text-primary-dark">
                  <Icon name={article.data.icon} class="w-5 h-5" />
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="text-base font-bold text-text dark:text-text-dark group-hover:text-primary dark:group-hover:text-primary-dark transition-colors">
                    {article.data.title}
                  </h3>
                </div>
              </div>
              <p class="text-sm text-text-secondary dark:text-text-secondary-dark line-clamp-2">
                {article.data.description}
              </p>
              {article.data.lastUpdated && (
                <p class="text-xs text-outline dark:text-outline-dark mt-3">
                  Mis à jour : {article.data.lastUpdated}
                </p>
              )}
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
</BaseLayout>
