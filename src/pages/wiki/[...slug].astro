---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
  const articles = await getCollection('wiki', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);

// Filtrer les headings h2 pour le sommaire
const tocHeadings = headings.filter((h) => h.depth === 2);
---

<BaseLayout
  title={`${article.data.title} - Wiki SLAMM`}
  description={article.data.description}
  url={`https://mma-saint-lunaire.fr/wiki/${article.id}`}
  keywords={`${article.data.title}, wiki MMA, SLAMM, ${article.data.category}`}
>
  <main class="container-page py-12 md:py-16">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-text-secondary dark:text-text-secondary-dark mb-8">
      <a href="/" class="hover:text-primary dark:hover:text-primary-dark transition-colors no-underline">Accueil</a>
      <span class="opacity-50">/</span>
      <a href="/wiki" class="hover:text-primary dark:hover:text-primary-dark transition-colors no-underline">Wiki</a>
      <span class="opacity-50">/</span>
      <span class="text-text dark:text-text-dark font-medium">{article.data.title}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_250px] gap-8 lg:gap-12">
      <!-- Article content -->
      <article>
        <!-- Header -->
        <header class="mb-8">
          <div class="flex items-center gap-3 mb-4">
            <div class="p-2 rounded-lg bg-primary/10 dark:bg-primary-dark/10 text-primary dark:text-primary-dark">
              <Icon name={article.data.icon} class="w-6 h-6" />
            </div>
            <span class="text-xs font-bold uppercase tracking-wider text-primary dark:text-primary-dark bg-primary/10 dark:bg-primary-dark/10 px-3 py-1 rounded-full">
              {article.data.category}
            </span>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold mb-3">
            <span class="heading-border">{article.data.title}</span>
          </h1>
          <p class="text-text-secondary dark:text-text-secondary-dark text-sm md:text-base">
            {article.data.description}
          </p>
          {article.data.lastUpdated && (
            <p class="text-xs text-outline dark:text-outline-dark mt-3">
              Dernière mise à jour : {article.data.lastUpdated}
            </p>
          )}
        </header>

        <!-- MDX Content -->
        <div class="wiki-prose">
          <Content />
        </div>

        <!-- Back link -->
        <div class="mt-12 pt-6 border-t-2 border-outline-variant dark:border-outline-variant-dark">
          <a
            href="/wiki"
            class="btn-secondary px-5 py-2.5 rounded-md3 text-sm"
          >
            Retour au Wiki
          </a>
        </div>
      </article>

      <!-- Sidebar: Table of contents -->
      {tocHeadings.length > 0 && (
        <aside class="hidden lg:block">
          <div class="sticky top-24">
            <h2 class="text-sm font-bold uppercase tracking-wider text-text-secondary dark:text-text-secondary-dark mb-4">
              Sommaire
            </h2>
            <nav class="flex flex-col gap-2">
              {tocHeadings.map((heading) => (
                <a
                  href={`#${heading.slug}`}
                  class="text-sm text-text-secondary dark:text-text-secondary-dark hover:text-primary dark:hover:text-primary-dark transition-colors no-underline pl-3 border-l-2 border-outline-variant dark:border-outline-variant-dark hover:border-primary dark:hover:border-primary-dark"
                >
                  {heading.text}
                </a>
              ))}
            </nav>
          </div>
        </aside>
      )}
    </div>
  </main>
</BaseLayout>
