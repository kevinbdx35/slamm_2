---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const pdfPath = '/SLAMM_reglement_interieur.pdf';
---

<Layout
  title="Règlement intérieur — Saint-Lunaire MMA"
  description="Règlement intérieur officiel de l'association SLAMM (Saint-Lunaire Arts Martiaux Mixtes). Adhésion, hygiène, discipline."
>
  <Nav />
  <main id="main">
    <section class="reglement">
      <div class="container">

        <div class="reglement-header">
          <h1 class="reglement-title"><span class="title-slot"><span class="title-slot-text">Règlement intérieur</span></span></h1>
          <p class="reglement-sub reveal reveal-delay-2">Le règlement intérieur officiel de l'association Saint-Lunaire Arts Martiaux Mixtes. À lire et accepter par tout adhérent.</p>
          <div class="pdf-actions reveal reveal-delay-2">
          <!-- Mobile : les lecteurs PDF intégrés s'affichent mal, on propose l'ouverture directe -->
          <a href={pdfPath} target="_blank" rel="noopener" class="btn-open-pdf">Ouvrir le PDF</a>
          <a href={pdfPath} download class="btn-download">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Télécharger le PDF
          </a>
          </div>
        </div>

        <div class="pdf-wrapper reveal">
          <iframe
            src={pdfPath}
            title="Règlement intérieur SLAMM"
            class="pdf-frame"
            type="application/pdf"
          >
            <p class="pdf-fallback">
              Votre navigateur ne peut pas afficher le PDF.
              <a href={pdfPath} download>Téléchargez-le ici</a>.
            </p>
          </iframe>
        </div>

      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* Première section de la page : dégage la nav fixe */
  .reglement {
    padding: 152px 0 112px;
  }

  /* En-tête empilé : titre, texte, action */
  .reglement-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    max-width: 720px;
    margin-bottom: 48px;
  }

  .reglement-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .reglement-sub {
    font-size: 17px;
    color: var(--text-3);
    line-height: 1.7;
    max-width: 56ch;
  }

  .pdf-actions {
    display: flex;
    gap: 12px;
    margin-top: 8px;
  }

  .btn-download,
  .btn-open-pdf {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 24px;
    background: var(--g500);
    color: var(--bg);
    font-size: 15px;
    font-weight: 600;
    border-radius: 100px;
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease, transform 160ms var(--ease-out);
    text-decoration: none;
  }

  .btn-download:active,
  .btn-open-pdf:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-download:hover,
    .btn-open-pdf:hover {
      background: var(--g400);
    }
  }

  .btn-open-pdf { display: none; }

  .pdf-wrapper {
    width: 100%;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--bg1);
  }

  .pdf-frame {
    display: block;
    width: 100%;
    height: 85vh;
    min-height: 600px;
    border: none;
  }

  .pdf-fallback {
    padding: 40px;
    text-align: center;
    font-size: 14px;
    color: var(--text-3);
  }

  .pdf-fallback a {
    color: var(--g400);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    .reglement { padding: 128px 0 80px; }
  }

  /* Mobile : pas de PDF intégré, deux boutons (ouvrir en plein écran, télécharger) */
  @media (max-width: 768px) {
    .pdf-wrapper { display: none; }
    .reglement-header { align-items: stretch; margin-bottom: 0; }
    .pdf-actions { flex-direction: column; }
    .btn-open-pdf { display: flex; }
    .btn-download { background: transparent; color: var(--text); border: 1px solid rgba(74,222,128,0.45); }
  }
</style>
