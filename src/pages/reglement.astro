---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const pdfPath = '/SLAMM_reglement_interieur.pdf';
---

<Layout
  title="Règlement intérieur — Saint-Lunaire MMA"
  description="Règlement intérieur officiel de l'association SLAMM (Saint-Lunaire Arts Martiaux Mixtes). Adhésion, hygiène, discipline."
>
  <Nav />
  <main>
    <section class="reglement">
      <div class="container">

        <div class="reglement-header reveal">
          <p class="section-label">Association SLAMM</p>
          <h1 class="reglement-title">Règlement intérieur</h1>
          <p class="reglement-sub">Le règlement intérieur officiel de l'association Saint-Lunaire Arts Martiaux Mixtes. À lire et accepter par tout adhérent.</p>
          <a href={pdfPath} download class="btn-download">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Télécharger le PDF
          </a>
        </div>

        <div class="pdf-wrapper reveal">
          <iframe
            src={pdfPath}
            title="Règlement intérieur SLAMM"
            class="pdf-frame"
            type="application/pdf"
          >
            <p class="pdf-fallback">
              Votre navigateur ne peut pas afficher le PDF.
              <a href={pdfPath} download>Téléchargez-le ici</a>.
            </p>
          </iframe>
        </div>

      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .reglement {
    padding: 120px 0 80px;
    position: relative;
  }

  .reglement::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
  }

  .reglement-header {
    margin-bottom: 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 24px;
  }

  .reglement-header > * {
    flex-shrink: 0;
  }

  .reglement-header .section-label,
  .reglement-header h1,
  .reglement-header .reglement-sub {
    width: 100%;
  }

  .section-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--g500);
    margin-bottom: 16px;
  }

  .reglement-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 16px;
  }

  .reglement-sub {
    font-size: 16px;
    color: var(--text-3);
    line-height: 1.7;
    max-width: 600px;
    margin-bottom: 8px;
  }

  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: var(--g600);
    color: #000;
    font-size: 14px;
    font-weight: 700;
    border-radius: var(--r-sm);
    transition: background 0.2s, transform 0.15s;
    text-decoration: none;
  }

  .btn-download:hover {
    background: var(--g400);
    transform: translateY(-1px);
  }

  .pdf-wrapper {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    overflow: hidden;
    background: var(--bg1);
  }

  .pdf-frame {
    display: block;
    width: 100%;
    height: 85vh;
    min-height: 600px;
    border: none;
  }

  .pdf-fallback {
    padding: 40px;
    text-align: center;
    font-size: 14px;
    color: var(--text-3);
  }

  .pdf-fallback a {
    color: var(--g400);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 768px) {
    .pdf-frame {
      height: 75vh;
      min-height: 480px;
    }
  }
</style>
