---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const pdfPath = '/Reglement_Sparrings_MMA_SLAMM.pdf';

const sparringSections = [
  {
    id: 'le-sparring-sert-a-apprendre',
    title: 'Le sparring sert à apprendre',
    content: "L'objectif n'est pas de gagner, mais de tenter, appliquer et enchaîner des techniques travaillées à l'entraînement. Oser essayer fait progresser bien plus que chercher à dominer.",
  },
  {
    id: 'la-progression-prime-sur-lego',
    title: "La progression prime sur l'ego",
    content: 'Vouloir absolument "gagner" un sparring pousse souvent à rester sur ses acquis ou à compenser par le physique (force, vitesse, cardio). Cela freine l\'évolution technique et va à l\'encontre de l\'esprit du club.',
  },
  {
    id: 'le-sparring-nest-pas-une-competition',
    title: "Le sparring n'est pas une compétition",
    content: "La compétition existe pour s'exprimer à pleine intensité et chercher la victoire. Le sparring d'entraînement, lui, est un laboratoire : on teste, on ajuste, on apprend, dans le respect et la sécurité de chacun.",
  },
  {
    id: 'securite-et-respect-avant-tout',
    title: 'Sécurité et respect avant tout',
    content: "Chacun est responsable de l'intégrité de son partenaire. Le contrôle, l'écoute et l'adaptation au niveau de l'autre sont des règles fondamentales.",
  },
  {
    id: 'la-victoire-est-une-consequence',
    title: 'La victoire est une conséquence, pas un objectif',
    content: "En cherchant à mieux comprendre, mieux exécuter et mieux enchaîner, les résultats viennent naturellement avec le temps.",
  },
];

---

<Layout
  title="Sparring & Règles de sécurité — Saint-Lunaire MMA"
  description="Philosophie du sparring et règles de sécurité à respecter pendant les entraînements chez SLAMM. Apprentissage progressif, respect du partenaire."
>
  <Nav />
  <main id="main">
    <section class="sparring">
      <div class="container">

        <div class="sparring-header">
          <h1 class="sparring-title"><span class="title-slot"><span class="title-slot-text">Sparring & Règles de sécurité</span></span></h1>
          <p class="sparring-sub reveal reveal-delay-2">Philosophie du sparring et règles à respecter pour progresser ensemble dans le respect et la sécurité de chacun.</p>
        </div>

        <div class="sparring-layout">

          <article class="sparring-body">

            <div class="chapter">
              <h2 id="philosophie-du-sparring" class="chapter-title">Philosophie du sparring</h2>

              {sparringSections.map(s => (
                <div class="section-block">
                  <h3 id={s.id}>{s.title}</h3>
                  <p>{s.content}</p>
                </div>
              ))}

              <blockquote>
                Chez SLAMM, progresser ensemble vaut toujours plus que gagner seul.
              </blockquote>
            </div>

          </article>

          <aside class="sommaire">
            <div class="sommaire-inner">
              <p class="sommaire-title">Sommaire</p>
              <nav>
                <a href="#philosophie-du-sparring" class="sommaire-link sommaire-link--parent">Philosophie du sparring</a>
                {sparringSections.map(s => (
                  <a href={`#${s.id}`} class="sommaire-link sommaire-link--child">{s.title}</a>
                ))}
                <a href="#regles-de-securite" class="sommaire-link sommaire-link--parent" style="margin-top: 8px;">Règles de sécurité</a>
              </nav>
            </div>
          </aside>

        </div>

        <div class="pdf-section reveal">
          <div class="pdf-section-header">
            <h2 id="regles-de-securite" class="chapter-title">Règles de sécurité</h2>
            <!-- Mobile : les lecteurs PDF intégrés s'affichent mal, on propose l'ouverture directe -->
            <a href={pdfPath} target="_blank" rel="noopener" class="btn-open-pdf">Ouvrir le PDF</a>
            <a href={pdfPath} download class="btn-download">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              Télécharger le PDF
            </a>
          </div>
          <div class="pdf-wrapper">
            <iframe
              src={pdfPath}
              title="Règlement des sparrings MMA — SLAMM"
              class="pdf-frame"
              type="application/pdf"
            >
              <p class="pdf-fallback">
                Ton navigateur ne peut pas afficher le PDF.
                <a href={pdfPath} download>Télécharge-le ici</a>.
              </p>
            </iframe>
          </div>
        </div>

      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* Première section de la page : dégage la nav fixe */
  .sparring {
    padding: 152px 0 112px;
  }

  .sparring-header {
    margin-bottom: 64px;
    max-width: 720px;
  }

  .sparring-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 16px;
  }

  .sparring-sub {
    font-size: 17px;
    color: var(--text-3);
    line-height: 1.7;
    max-width: 600px;
  }

  /* Layout */
  /* Colonne de lecture à plat + sommaire à droite */
  .sparring-layout {
    display: grid;
    grid-template-columns: minmax(0, 760px) 240px;
    justify-content: space-between;
    gap: 64px;
    align-items: start;
  }

  .sparring-body {
    display: flex;
    flex-direction: column;
  }

  .divider {
    height: 1px;
    background: var(--border);
    margin: 40px 0;
  }

  .chapter-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.02em;
    margin-bottom: 32px;
    padding-top: 32px;
    border-top: 1px solid var(--border-strong);
    scroll-margin-top: 96px;
  }

  .section-block {
    margin-bottom: 28px;
  }

  .section-block:last-child {
    margin-bottom: 0;
  }

  .section-block h3 {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    color: var(--text);
    scroll-margin-top: 96px;
    letter-spacing: -0.01em;
    margin-bottom: 10px;
  }

  .section-block p {
    font-size: 16px;
    color: var(--text-3);
    line-height: 1.8;
    margin-bottom: 10px;
  }

  .section-block p:last-child,
  .section-block p.outro {
    margin-bottom: 0;
  }

  .section-block p.outro {
    margin-top: 10px;
  }

  .section-block ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
  }

  .section-block ul li {
    font-size: 14px;
    color: var(--text-3);
    line-height: 1.75;
    padding-left: 20px;
    position: relative;
  }

  .section-block ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.85em;
    width: 10px;
    height: 2px;
    border-radius: 1px;
    background: var(--g600);
  }

  .section-block ul li strong {
    color: var(--text-2);
    font-weight: 600;
  }

  /* Maxime du club : grande citation, filet vert, sans boîte */
  blockquote {
    margin: 40px 0 4px;
    padding-left: 20px;
    border-left: 2px solid var(--g500);
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    line-height: 1.35;
  }

  /* Sommaire */
  /* Sommaire à plat, visible au défilement */
  .sommaire-inner {
    position: sticky;
    top: 104px;
  }

  .sommaire-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
    margin-bottom: 14px;
  }

  .sommaire-inner nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sommaire-link {
    font-size: 13px;
    color: var(--text-3);
    line-height: 1.4;
    padding: 5px 10px 5px 12px;
    border-left: 2px solid var(--border);
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
    transition: color 200ms ease, border-color 200ms ease, background-color 200ms ease;
  }

  .sommaire-link--parent {
    font-weight: 600;
    color: var(--text-2);
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  .sommaire-link--child {
    font-size: 12px;
    padding-left: 20px;
  }

  /* Section en cours (aria-current, posé par Layout.astro) : même rendu que le survol */
  .sommaire-link[aria-current="location"] {
    color: var(--g400);
    border-color: var(--g500);
    background: rgba(34,197,94,0.05);
  }

  @media (hover: hover) and (pointer: fine) {
    .sommaire-link:hover {
      color: var(--g400);
      border-color: var(--g500);
      background: rgba(34,197,94,0.05);
    }
  }

  /* PDF section */
  .pdf-section {
    margin-top: 96px;
  }

  .pdf-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 24px;
  }

  .pdf-section-header .chapter-title {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .btn-download,
  .btn-open-pdf {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 24px;
    background: var(--g500);
    color: var(--bg);
    font-size: 15px;
    font-weight: 600;
    border-radius: 100px;
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease, transform 160ms var(--ease-out);
    text-decoration: none;
    flex-shrink: 0;
  }

  .btn-download:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-download:hover {
      background: var(--g400);
    }
  }

  .btn-open-pdf { display: none; }

  .pdf-wrapper {
    width: 100%;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--bg1);
  }

  .pdf-frame {
    display: block;
    width: 100%;
    height: 85vh;
    min-height: 600px;
    border: none;
  }

  .pdf-fallback {
    padding: 40px;
    text-align: center;
    font-size: 14px;
    color: var(--text-3);
  }

  .pdf-fallback a {
    color: var(--g400);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    .sparring { padding: 128px 0 80px; }
    .sparring-layout { grid-template-columns: minmax(0, 1fr); }
    .sommaire { display: none; }
    .pdf-frame { height: 75vh; min-height: 480px; }
    .pdf-section { margin-top: 72px; }
  }

  /* Mobile : pas de PDF intégré, deux boutons (ouvrir en plein écran, télécharger) */
  @media (max-width: 768px) {
    .pdf-wrapper { display: none; }
    .pdf-section-header { flex-direction: column; align-items: stretch; }
    .pdf-section-header { gap: 12px; margin-bottom: 0; }
    .pdf-section-header .chapter-title { margin-bottom: 8px; }
    .btn-open-pdf { display: flex; }
    .btn-download { background: transparent; color: var(--text); border: 1px solid rgba(74,222,128,0.45); }
  }
</style>
