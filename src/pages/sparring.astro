---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const sparringSections = [
  {
    id: 'le-sparring-sert-a-apprendre',
    title: 'Le sparring sert à apprendre',
    content: "L'objectif n'est pas de gagner, mais de tenter, appliquer et enchaîner des techniques travaillées à l'entraînement. Oser essayer fait progresser bien plus que chercher à dominer.",
  },
  {
    id: 'la-progression-prime-sur-lego',
    title: "La progression prime sur l'ego",
    content: 'Vouloir absolument "gagner" un sparring pousse souvent à rester sur ses acquis ou à compenser par le physique (force, vitesse, cardio). Cela freine l\'évolution technique et va à l\'encontre de l\'esprit du club.',
  },
  {
    id: 'le-sparring-nest-pas-une-competition',
    title: "Le sparring n'est pas une compétition",
    content: "La compétition existe pour s'exprimer à pleine intensité et chercher la victoire. Le sparring d'entraînement, lui, est un laboratoire : on teste, on ajuste, on apprend, dans le respect et la sécurité de chacun.",
  },
  {
    id: 'securite-et-respect-avant-tout',
    title: 'Sécurité et respect avant tout',
    content: "Chacun est responsable de l'intégrité de son partenaire. Le contrôle, l'écoute et l'adaptation au niveau de l'autre sont des règles fondamentales.",
  },
  {
    id: 'la-victoire-est-une-consequence',
    title: 'La victoire est une conséquence, pas un objectif',
    content: "En cherchant à mieux comprendre, mieux exécuter et mieux enchaîner, les résultats viennent naturellement avec le temps.",
  },
];

const securitySections = [
  {
    id: 'respect-du-tap',
    title: 'Respect du tap',
    intro: 'Le tap signifie l\'arrêt immédiat de l\'action, généralement pour prévenir une blessure.',
    items: [
      'Le tap peut se faire <strong>sur le corps du partenaire</strong>, <strong>sur le tapis</strong> ou <strong>verbalement</strong> en disant "tap"',
      'Arrêt immédiat obligatoire, quelle qu\'en soit la raison',
    ],
  },
  {
    id: 'conscience-de-lespace',
    title: "Conscience de l'espace",
    items: [
      'Attention aux autres groupes et aux limites du tapis',
      'Adapter la technique ou recommencer si un risque de collision existe',
      'La sécurité prime toujours sur la finalisation',
    ],
  },
  {
    id: 'striking-controle',
    title: 'Striking contrôlé',
    items: [
      'Les frappes sont contrôlées et adaptées au niveau et au thème du cours',
      'Puissance réduite, <strong>précision prioritaire</strong>',
      'Aucune frappe non maîtrisée ou hors consignes du coach',
    ],
  },
  {
    id: 'clinch-et-travail-contre-la-cage',
    title: 'Clinch et travail contre la cage',
    items: [
      'Contrôler le partenaire lors du travail au clinch et contre la cage',
      'Interdiction de projeter violemment ou d\'écraser le partenaire contre la cage',
      'Attention particulière aux chutes et aux sorties de cage',
    ],
  },
  {
    id: 'projections-et-amenees-au-sol',
    title: 'Projections et amenées au sol',
    items: [
      'Il est interdit de soulever et projeter violemment un partenaire au sol',
      'Les projections et amenées au sol doivent être <strong>contrôlées et accompagnées</strong>',
      'Toujours accompagner la chute du partenaire',
      'Aucune projection incontrôlée ou dangereuse',
    ],
  },
  {
    id: 'techniques-sautees-interdites',
    title: 'Techniques sautées interdites',
    intro: 'Sont interdits :',
    items: [
      'Armbars volants',
      'Triangles sautés',
      'Guard pulls sautés',
      'Toute technique impliquant une perte de contrôle',
    ],
    outro: 'Privilégier des entrées stables, maîtrisées et sécurisées depuis la position debout.',
  },
  {
    id: 'application-des-soumissions',
    title: 'Application des soumissions',
    items: [
      'Priorité au <strong>contrôle</strong> plutôt qu\'à la vitesse ou à la force',
      'Les soumissions doivent être appliquées <strong>progressivement</strong>',
      'Vigilance renforcée sur les clés de jambes avec rotation (heel hooks, toe holds)',
    ],
  },
  {
    id: 'frappes-au-sol',
    title: 'Frappes au sol',
    items: [
      'Les frappes au sol sont techniques et contrôlées, jamais brutales',
      'Objectif : placement, posture, timing et défense',
      'Les frappes au sol doivent être mesurées et stoppées immédiatement au tap ou à la consigne',
    ],
  },
  {
    id: 'protection-des-doigts-et-des-orteils',
    title: 'Protection des doigts et des orteils',
    items: [
      'Interdiction de saisir ou de tordre un doigt ou un orteil isolé',
      'Saisir la <strong>main entière</strong>, le <strong>pied entier</strong>, le <strong>poignet</strong> ou la <strong>cheville</strong>',
    ],
  },
];
---

<Layout
  title="Sparring & Règles de sécurité — Saint-Lunaire MMA"
  description="Philosophie du sparring et règles de sécurité à respecter pendant les entraînements chez SLAMM. Apprentissage progressif, respect du partenaire."
>
  <Nav />
  <main>
    <section class="sparring">
      <div class="container">

        <div class="sparring-header reveal">
          <p class="section-label">Entraînement SLAMM</p>
          <h1 class="sparring-title">Sparring & Règles de sécurité</h1>
          <p class="sparring-sub">Philosophie du sparring et règles à respecter pour progresser ensemble dans le respect et la sécurité de chacun.</p>
        </div>

        <div class="sparring-layout">

          <article class="sparring-body reveal">

            <div class="chapter">
              <h2 id="philosophie-du-sparring" class="chapter-title">Philosophie du sparring</h2>

              {sparringSections.map(s => (
                <div class="section-block">
                  <h3 id={s.id}>{s.title}</h3>
                  <p>{s.content}</p>
                </div>
              ))}

              <blockquote>
                Chez SLAMM, progresser ensemble vaut toujours plus que gagner seul.
              </blockquote>
            </div>

            <div class="divider"></div>

            <div class="chapter">
              <h2 id="regles-de-securite" class="chapter-title">Règles de sécurité</h2>

              {securitySections.map(s => (
                <div class="section-block">
                  <h3 id={s.id}>{s.title}</h3>
                  {s.intro && <p>{s.intro}</p>}
                  <ul>
                    {s.items.map(item => <li set:html={item} />)}
                  </ul>
                  {s.outro && <p class="outro">{s.outro}</p>}
                </div>
              ))}
            </div>

          </article>

          <aside class="sommaire">
            <div class="sommaire-inner">
              <p class="sommaire-title">Sommaire</p>
              <nav>
                <a href="#philosophie-du-sparring" class="sommaire-link sommaire-link--parent">Philosophie du sparring</a>
                {sparringSections.map(s => (
                  <a href={`#${s.id}`} class="sommaire-link sommaire-link--child">{s.title}</a>
                ))}
                <a href="#regles-de-securite" class="sommaire-link sommaire-link--parent" style="margin-top: 8px;">Règles de sécurité</a>
                {securitySections.map(s => (
                  <a href={`#${s.id}`} class="sommaire-link sommaire-link--child">{s.title}</a>
                ))}
              </nav>
            </div>
          </aside>

        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .sparring {
    padding: 120px 0 80px;
    position: relative;
  }

  .sparring::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
  }

  .sparring-header {
    margin-bottom: 56px;
  }

  .section-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--g500);
    margin-bottom: 16px;
  }

  .sparring-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 16px;
  }

  .sparring-sub {
    font-size: 16px;
    color: var(--text-3);
    line-height: 1.7;
    max-width: 600px;
  }

  /* Layout */
  .sparring-layout {
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: 48px;
    align-items: start;
  }

  /* Body */
  .sparring-body {
    background: var(--bg1);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    padding: 48px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .divider {
    height: 1px;
    background: var(--border);
    margin: 40px 0;
  }

  .chapter-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.02em;
    margin-bottom: 28px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }

  .section-block {
    margin-bottom: 28px;
  }

  .section-block:last-child {
    margin-bottom: 0;
  }

  .section-block h3 {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    color: var(--g400);
    letter-spacing: -0.01em;
    margin-bottom: 10px;
  }

  .section-block p {
    font-size: 14px;
    color: var(--text-3);
    line-height: 1.8;
    margin-bottom: 10px;
  }

  .section-block p:last-child,
  .section-block p.outro {
    margin-bottom: 0;
  }

  .section-block p.outro {
    margin-top: 10px;
  }

  .section-block ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
  }

  .section-block ul li {
    font-size: 14px;
    color: var(--text-3);
    line-height: 1.75;
    padding-left: 20px;
    position: relative;
  }

  .section-block ul li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--g600);
    font-weight: 600;
  }

  .section-block ul li strong {
    color: var(--text-2);
    font-weight: 600;
  }

  blockquote {
    margin: 32px 0 4px;
    padding: 20px 24px;
    background: rgba(34,197,94,0.05);
    border-left: 3px solid var(--g500);
    border-radius: 0 var(--r-md) var(--r-md) 0;
    font-size: 15px;
    font-style: italic;
    color: var(--text-2);
    line-height: 1.7;
  }

  /* Sommaire */
  .sommaire-inner {
    position: sticky;
    top: 100px;
    background: var(--bg1);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 24px;
  }

  .sommaire-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .sommaire-inner nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sommaire-link {
    font-size: 13px;
    color: var(--text-3);
    line-height: 1.4;
    padding: 5px 10px 5px 12px;
    border-left: 2px solid var(--border);
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .sommaire-link--parent {
    font-weight: 600;
    color: var(--text-2);
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  .sommaire-link--child {
    font-size: 12px;
    padding-left: 20px;
  }

  .sommaire-link:hover {
    color: var(--g400);
    border-color: var(--g500);
    background: rgba(34,197,94,0.05);
  }

  @media (max-width: 900px) {
    .sparring-layout { grid-template-columns: 1fr; }
    .sommaire { display: none; }
    .sparring-body { padding: 32px 24px; }
  }
</style>
