---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const pdfPath = '/SLAMM_poster_regles_sparring.pdf';

const sparringSections = [
  {
    id: 'le-sparring-sert-a-apprendre',
    title: 'Le sparring sert à apprendre',
    content: "L'objectif n'est pas de gagner, mais de tenter, appliquer et enchaîner des techniques travaillées à l'entraînement. Oser essayer fait progresser bien plus que chercher à dominer.",
  },
  {
    id: 'la-progression-prime-sur-lego',
    title: "La progression prime sur l'ego",
    content: 'Vouloir absolument "gagner" un sparring pousse souvent à rester sur ses acquis ou à compenser par le physique (force, vitesse, cardio). Cela freine l\'évolution technique et va à l\'encontre de l\'esprit du club.',
  },
  {
    id: 'le-sparring-nest-pas-une-competition',
    title: "Le sparring n'est pas une compétition",
    content: "La compétition existe pour s'exprimer à pleine intensité et chercher la victoire. Le sparring d'entraînement, lui, est un laboratoire : on teste, on ajuste, on apprend, dans le respect et la sécurité de chacun.",
  },
  {
    id: 'securite-et-respect-avant-tout',
    title: 'Sécurité et respect avant tout',
    content: "Chacun est responsable de l'intégrité de son partenaire. Le contrôle, l'écoute et l'adaptation au niveau de l'autre sont des règles fondamentales.",
  },
  {
    id: 'la-victoire-est-une-consequence',
    title: 'La victoire est une conséquence, pas un objectif',
    content: "En cherchant à mieux comprendre, mieux exécuter et mieux enchaîner, les résultats viennent naturellement avec le temps.",
  },
];

---

<Layout
  title="Sparring & Règles de sécurité — Saint-Lunaire MMA"
  description="Philosophie du sparring et règles de sécurité à respecter pendant les entraînements chez SLAMM. Apprentissage progressif, respect du partenaire."
>
  <Nav />
  <main id="main">
    <section class="sparring">
      <div class="container">

        <div class="sparring-header reveal">
          <p class="section-label">Entraînement SLAMM</p>
          <h1 class="sparring-title">Sparring & Règles de sécurité</h1>
          <p class="sparring-sub">Philosophie du sparring et règles à respecter pour progresser ensemble dans le respect et la sécurité de chacun.</p>
        </div>

        <div class="sparring-layout">

          <article class="sparring-body reveal">

            <div class="chapter">
              <h2 id="philosophie-du-sparring" class="chapter-title">Philosophie du sparring</h2>

              {sparringSections.map(s => (
                <div class="section-block">
                  <h3 id={s.id}>{s.title}</h3>
                  <p>{s.content}</p>
                </div>
              ))}

              <blockquote>
                Chez SLAMM, progresser ensemble vaut toujours plus que gagner seul.
              </blockquote>
            </div>

          </article>

          <aside class="sommaire">
            <div class="sommaire-inner">
              <p class="sommaire-title">Sommaire</p>
              <nav>
                <a href="#philosophie-du-sparring" class="sommaire-link sommaire-link--parent">Philosophie du sparring</a>
                {sparringSections.map(s => (
                  <a href={`#${s.id}`} class="sommaire-link sommaire-link--child">{s.title}</a>
                ))}
                <a href="#regles-de-securite" class="sommaire-link sommaire-link--parent" style="margin-top: 8px;">Règles de sécurité</a>
              </nav>
            </div>
          </aside>

        </div>

        <div class="pdf-section reveal">
          <div class="pdf-section-header">
            <h2 id="regles-de-securite" class="chapter-title">Règles de sécurité</h2>
            <a href={pdfPath} download class="btn-download">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              Télécharger le PDF
            </a>
          </div>
          <div class="pdf-wrapper">
            <iframe
              src={pdfPath}
              title="Règles de sécurité SLAMM"
              class="pdf-frame"
              type="application/pdf"
            >
              <p class="pdf-fallback">
                Votre navigateur ne peut pas afficher le PDF.
                <a href={pdfPath} download>Téléchargez-le ici</a>.
              </p>
            </iframe>
          </div>
        </div>

      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .sparring {
    padding: 120px 0 80px;
    position: relative;
  }

  .sparring::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
  }

  .sparring-header {
    margin-bottom: 56px;
  }

  .section-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--g500);
    margin-bottom: 16px;
  }

  .sparring-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 16px;
  }

  .sparring-sub {
    font-size: 16px;
    color: var(--text-3);
    line-height: 1.7;
    max-width: 600px;
  }

  /* Layout */
  .sparring-layout {
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: 48px;
    align-items: start;
  }

  /* Body */
  .sparring-body {
    background: var(--bg1);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    padding: 48px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .divider {
    height: 1px;
    background: var(--border);
    margin: 40px 0;
  }

  .chapter-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.02em;
    margin-bottom: 28px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }

  .section-block {
    margin-bottom: 28px;
  }

  .section-block:last-child {
    margin-bottom: 0;
  }

  .section-block h3 {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    color: var(--g400);
    letter-spacing: -0.01em;
    margin-bottom: 10px;
  }

  .section-block p {
    font-size: 14px;
    color: var(--text-3);
    line-height: 1.8;
    margin-bottom: 10px;
  }

  .section-block p:last-child,
  .section-block p.outro {
    margin-bottom: 0;
  }

  .section-block p.outro {
    margin-top: 10px;
  }

  .section-block ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
  }

  .section-block ul li {
    font-size: 14px;
    color: var(--text-3);
    line-height: 1.75;
    padding-left: 20px;
    position: relative;
  }

  .section-block ul li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--g600);
    font-weight: 600;
  }

  .section-block ul li strong {
    color: var(--text-2);
    font-weight: 600;
  }

  blockquote {
    margin: 32px 0 4px;
    padding: 20px 24px;
    background: rgba(34,197,94,0.05);
    border-left: 3px solid var(--g500);
    border-radius: 0 var(--r-md) var(--r-md) 0;
    font-size: 15px;
    font-style: italic;
    color: var(--text-2);
    line-height: 1.7;
  }

  /* Sommaire */
  .sommaire-inner {
    position: sticky;
    top: 100px;
    background: var(--bg1);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 24px;
  }

  .sommaire-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .sommaire-inner nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sommaire-link {
    font-size: 13px;
    color: var(--text-3);
    line-height: 1.4;
    padding: 5px 10px 5px 12px;
    border-left: 2px solid var(--border);
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .sommaire-link--parent {
    font-weight: 600;
    color: var(--text-2);
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  .sommaire-link--child {
    font-size: 12px;
    padding-left: 20px;
  }

  .sommaire-link:hover {
    color: var(--g400);
    border-color: var(--g500);
    background: rgba(34,197,94,0.05);
  }

  /* PDF section */
  .pdf-section {
    margin-top: 56px;
  }

  .pdf-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 24px;
  }

  .pdf-section-header .chapter-title {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: var(--g600);
    color: #000;
    font-size: 14px;
    font-weight: 700;
    border-radius: var(--r-sm);
    transition: background 0.2s, transform 0.15s;
    text-decoration: none;
    flex-shrink: 0;
  }

  .btn-download:hover {
    background: var(--g400);
    transform: translateY(-1px);
  }

  .pdf-wrapper {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    overflow: hidden;
    background: var(--bg1);
  }

  .pdf-frame {
    display: block;
    width: 100%;
    height: 85vh;
    min-height: 600px;
    border: none;
  }

  .pdf-fallback {
    padding: 40px;
    text-align: center;
    font-size: 14px;
    color: var(--text-3);
  }

  .pdf-fallback a {
    color: var(--g400);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    .sparring-layout { grid-template-columns: 1fr; }
    .sommaire { display: none; }
    .sparring-body { padding: 32px 24px; }
    .pdf-frame { height: 75vh; min-height: 480px; }
  }
</style>
