---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';

const title = 'Sparring';
const description = "Chez SLAMM, le sparring est un outil de progression, pas une fin en soi. Découvrez notre approche du sparring.";

const sections = [
  {
    id: 'le-sparring-sert-a-apprendre',
    title: 'Le sparring sert à apprendre',
    content: `<p>L'objectif n'est pas de gagner, mais de tenter, appliquer et enchaîner des techniques travaillées à l'entraînement. Oser essayer fait progresser bien plus que chercher à dominer.</p>`,
  },
  {
    id: 'la-progression-prime-sur-lego',
    title: "La progression prime sur l'ego",
    content: `<p>Vouloir absolument "gagner" un sparring pousse souvent à rester sur ses acquis ou à compenser par le physique (force, vitesse, cardio). Cela freine l'évolution technique et va à l'encontre de l'esprit du club.</p>`,
  },
  {
    id: 'le-sparring-nest-pas-une-competition',
    title: "Le sparring n'est pas une compétition",
    content: `<p>La compétition existe pour s'exprimer à pleine intensité et chercher la victoire. Le sparring d'entraînement, lui, est un laboratoire : on teste, on ajuste, on apprend, dans le respect et la sécurité de chacun.</p>`,
  },
  {
    id: 'securite-et-respect-avant-tout',
    title: 'Sécurité et respect avant tout',
    content: `<p>Chacun est responsable de l'intégrité de son partenaire. Le contrôle, l'écoute et l'adaptation au niveau de l'autre sont des règles fondamentales.</p>`,
  },
  {
    id: 'la-victoire-est-une-consequence',
    title: 'La victoire est une conséquence, pas un objectif',
    content: `<p>En cherchant à mieux comprendre, mieux exécuter et mieux enchaîner, les résultats viennent naturellement avec le temps.</p>`,
  },
];
---

<BaseLayout
  title="Sparring | SLAMM MMA Saint-Lunaire"
  description={description}
  url="https://mma-saint-lunaire.fr/sparring"
  keywords="sparring MMA, philosophie sparring, SLAMM, Saint-Lunaire"
>
  <main class="container-page py-12 md:py-16">
    <nav class="flex items-center gap-2 text-sm text-text-secondary dark:text-text-secondary-dark mb-8">
      <a href="/" class="hover:text-primary dark:hover:text-primary-dark transition-colors no-underline">Accueil</a>
      <span class="opacity-50">/</span>
      <span class="text-text dark:text-text-dark font-medium">{title}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_250px] gap-8 lg:gap-12">
      <article>
        <header class="mb-8">
          <div class="flex items-center gap-3 mb-4">
            <div class="p-2 rounded-lg bg-primary/10 dark:bg-primary-dark/10 text-primary dark:text-primary-dark">
              <Icon name="mdi:handshake" class="w-6 h-6" />
            </div>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold mb-3">
            <span class="heading-border">{title}</span>
          </h1>
          <p class="text-text-secondary dark:text-text-secondary-dark text-sm md:text-base">{description}</p>
        </header>

        <div class="wiki-prose">
          {sections.map((s) => (
            <Fragment>
              <h2 id={s.id}>{s.title}</h2>
              <Fragment set:html={s.content} />
            </Fragment>
          ))}
          <blockquote><p>Chez SLAMM, progresser ensemble vaut toujours plus que gagner seul.</p></blockquote>
        </div>
      </article>

      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <h2 class="text-sm font-bold uppercase tracking-wider text-text-secondary dark:text-text-secondary-dark mb-4">
            Sommaire
          </h2>
          <nav class="flex flex-col gap-2">
            {sections.map((s) => (
              <a
                href={`#${s.id}`}
                class="text-sm text-text-secondary dark:text-text-secondary-dark hover:text-primary dark:hover:text-primary-dark transition-colors no-underline pl-3 border-l-2 border-outline-variant dark:border-outline-variant-dark hover:border-primary dark:hover:border-primary-dark"
              >
                {s.title}
              </a>
            ))}
          </nav>
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>
