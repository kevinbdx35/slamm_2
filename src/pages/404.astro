---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page non trouvée - SLAMM MMA">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-6">
    <!-- Icon -->
    <div class="mb-8">
      <svg class="w-20 h-20 md:w-32 md:h-32 text-primary dark:text-primary-dark opacity-80" fill="currentColor" viewBox="0 0 24 24">
        <path d="M6.19 21.54a1.22 1.22 0 0 1-.86-2.08l3.93-3.93a1.22 1.22 0 0 1 1.72 1.72l-3.93 3.93a1.21 1.21 0 0 1-.86.36zm11.62 0a1.21 1.21 0 0 1-.86-.36l-3.93-3.93a1.22 1.22 0 0 1 1.72-1.72l3.93 3.93a1.22 1.22 0 0 1-.86 2.08zM12 16a4 4 0 1 1 4-4 4 4 0 0 1-4 4zm0-6a2 2 0 1 0 2 2 2 2 0 0 0-2-2zm6-2a1 1 0 0 1-.71-.29l-1-1a1 1 0 0 1 1.42-1.42l1 1A1 1 0 0 1 18 8zm-12 0a1 1 0 0 1-.71-1.71l1-1a1 1 0 0 1 1.42 1.42l-1 1A1 1 0 0 1 6 8zm6-2a1 1 0 0 1-1-1V4a1 1 0 0 1 2 0v1a1 1 0 0 1-1 1z"/>
      </svg>
    </div>

    <!-- Error code -->
    <h1 class="text-[4rem] md:text-[6rem] font-black text-primary dark:text-primary-dark tracking-[-4px] leading-none mb-4">
      404
    </h1>

    <!-- Message -->
    <h2 class="text-2xl md:text-[2rem] font-semibold mb-4">
      Page non trouvée
    </h2>

    <p class="text-base tracking-wide leading-relaxed max-w-[500px] mb-8 opacity-80">
      Cette page semble avoir quitté le tatami.
      Elle n'existe pas ou a été déplacée.
    </p>

    <!-- Action buttons -->
    <div class="flex gap-4 flex-wrap justify-center">
      <a
        href="/"
        class="btn-primary px-8 py-3 text-lg"
      >
        Retour à l'accueil
      </a>
      <a
        href="/contact"
        class="btn border-2 border-text-secondary dark:border-text-secondary-dark text-text-secondary dark:text-text-secondary-dark px-8 py-3 text-lg hover:bg-brand-orange hover:text-white hover:border-brand-orange hover:-translate-y-0.5"
      >
        Nous contacter
      </a>
    </div>
  </div>
</BaseLayout>
