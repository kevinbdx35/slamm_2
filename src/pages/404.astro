---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page introuvable — Saint-Lunaire MMA"
  description="La page que tu cherches n'existe pas ou a été déplacée."
>
  <Nav />
  <main id="main">
    <section class="not-found">
      <div class="container">

        <div class="not-found-inner">
          <p class="code"><span class="title-slot"><span class="title-slot-text">404</span></span></p>
          <h1 class="title"><span class="title-slot title-slot--late"><span class="title-slot-text">Page introuvable</span></span></h1>
          <p class="sub reveal reveal-delay-2">La page que tu cherches n'existe pas ou a été déplacée.<br/>Reviens à l'accueil pour continuer ta navigation.</p>

          <div class="actions reveal reveal-delay-3">
            <a href="/" class="btn-primary">
              Retour à l'accueil
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <a href="/contact" class="btn-ghost">Nous contacter</a>
          </div>

          <nav class="quick-links reveal reveal-delay-4" aria-label="Pages principales">
            <a href="/disciplines">Disciplines</a>
            <a href="/equipe">Équipe</a>
            <a href="/evenements">Événements</a>
            <a href="/tarifs">Tarifs</a>
            <a href="/faq">FAQ</a>
          </nav>
        </div>

      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .not-found {
    min-height: 100svh;
    display: flex;
    align-items: center;
    position: relative;
    padding: 120px 0 80px;
  }

  .not-found-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
    max-width: 560px;
    margin: 0 auto;
  }

  .code {
    font-family: var(--font-display);
    font-size: clamp(80px, 16vw, 128px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--g400);
    user-select: none;
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(24px, 4vw, 36px);
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-top: -4px;
  }

  .sub {
    font-size: 16px;
    color: var(--text-3);
    line-height: 1.75;
    max-width: 420px;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 8px;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--bg);
    background: var(--g500);
    padding: 13px 26px;
    border-radius: 100px;
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease, transform 160ms var(--ease-out);
  }

  .btn-primary:active {
    transform: scale(0.97);
  }

  .btn-primary svg { transition: transform 200ms var(--ease-out); }

  /* Hors du bloc « souris » : sur tactile, le bouton perdait bordure et marges */
  .btn-ghost {
    font-size: 15px;
    font-weight: 500;
    color: var(--text-3);
    padding: 13px 22px;
    border-radius: 100px;
    border: 1px solid var(--border-strong);
    transition: color 200ms ease, border-color 200ms ease, background-color 200ms ease, transform 160ms var(--ease-out);
  }
  .btn-ghost:active { transform: scale(0.97); }

  .quick-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 16px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
    width: 100%;
  }

  .quick-links a {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
    padding: 5px 14px;
    border-radius: 100px;
    border: 1px solid var(--border);
    transition: color 200ms ease, border-color 200ms ease, background-color 200ms ease, transform 160ms var(--ease-out);
  }
  .quick-links a:active { transform: scale(0.97); }

  @media (hover: hover) and (pointer: fine) {
    .btn-primary:hover { background: var(--g400); }
    .btn-primary:hover svg { transform: translateX(3px); }
    .btn-ghost:hover {
      color: var(--text);
      border-color: rgba(74,222,128,0.4);
      background: rgba(34,197,94,0.04);
    }
    .quick-links a:hover {
      color: var(--g400);
      border-color: rgba(34,197,94,0.3);
      background: rgba(34,197,94,0.05);
    }
  }

  /* « 404 » puis titre : deux fentes dans deux éléments distincts, le titre
     part 60ms après (le nth-child global ne peut pas les enchaîner) */
  .title-slot--late .title-slot-text { animation-delay: 120ms; }

  @media (prefers-reduced-motion: reduce) {
    .btn-primary svg { transition: none; }
    .btn-primary:hover svg,
    .btn-ghost:active,
    .quick-links a:active { transform: none; }
  }
</style>
