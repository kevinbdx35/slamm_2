---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
---

<BaseLayout title="Page non trouvée - SLAMM MMA">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-6">
    <!-- Icon -->
    <div class="mb-8">
      <Icon name="mdi:emoticon-confused-outline" class="w-20 h-20 md:w-32 md:h-32 text-primary dark:text-primary-dark opacity-80" />
    </div>

    <!-- Error code -->
    <h1 class="text-[4rem] md:text-[6rem] font-black text-primary dark:text-primary-dark tracking-[-4px] leading-none mb-4">
      404
    </h1>

    <!-- Message -->
    <h2 class="text-2xl md:text-[2rem] font-semibold mb-4">
      Page non trouvée
    </h2>

    <p class="text-base tracking-wide leading-relaxed max-w-[500px] mb-8 opacity-80">
      Cette page semble avoir quitté le tatami.
      Elle n'existe pas ou a été déplacée.
    </p>

    <!-- Action buttons -->
    <div class="flex gap-4 flex-wrap justify-center">
      <a
        href="/"
        class="btn-primary px-8 py-3 text-lg"
      >
        Retour à l'accueil
      </a>
      <a
        href="/contact"
        class="btn-secondary px-8 py-3 text-lg"
      >
        Nous contacter
      </a>
    </div>
  </div>
</BaseLayout>
