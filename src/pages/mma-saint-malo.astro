---
import GeoPage from '../components/GeoPage.astro';

const AREA_SERVED = ["Saint-Malo", "Paramé", "Saint-Servan", "Rothéneuf", "Saint-Coulomb"];

// Même entité que le SportsClub global du Layout (même @id) : on ne fait
// qu'ajouter la zone desservie, sans déclarer un second établissement
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SportsClub',
  '@id': 'https://mma-saint-lunaire.fr/#club',
  areaServed: AREA_SERVED,
};
---

<GeoPage
  title="Club MMA Saint-Malo – À 15 min de Saint-Malo | SLAMM Saint-Lunaire"
  description="Tu cherches un club de MMA proche de Saint-Malo ? SLAMM est à 15 min à Saint-Lunaire. Grappling, No-Gi, boxe, kickboxing, lutte. Tous niveaux, coachs FMMAF."
  canonical="/mma-saint-malo/"
  city="Saint-Malo"
  distance="15 min"
  areaServed={AREA_SERVED}
  {schema}
/>
