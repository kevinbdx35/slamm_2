---
import FloatingTrialButton from '../components/FloatingTrialButton.astro';
import SummerBreakBanner from '../components/SummerBreakBanner.astro';
import { CONTACT_INFO, SOCIAL_URLS } from '../config/urls.js';
import { SUMMER_BREAK } from '../config/schedule.js';

// Polices auto-hébergées (perf + RGPD/CSP, plus de dépendance à Google Fonts)
import '../styles/fonts.css';
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  pageSchema?: object | object[];
}
const {
  title = 'Saint-Lunaire Arts Martiaux Mixtes',
  description = 'Club de MMA à Saint-Lunaire, Bretagne. Association loi 1901. Entraînement, compétition, bien-être.',
  canonical,
  ogImage,
  pageSchema,
} = Astro.props;

const siteUrl = Astro.site?.origin ?? 'https://mma-saint-lunaire.fr';
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : `${siteUrl}${Astro.url.pathname}`;
const ogImageUrl = ogImage ? `${siteUrl}${ogImage}` : `${siteUrl}/og-image.png`;

const pageNames: Record<string, string> = {
  '/disciplines': 'Disciplines',
  '/equipe': 'Équipe',
  '/evenements': 'Événements',
  '/tarifs': 'Tarifs',
  '/contact': 'Contact',
  '/faq': 'FAQ',
  '/hygiene': 'Hygiène & Sécurité',
  '/sparring': 'Sparring & Sécurité',
  '/equipements': 'Équipements',
  '/reglement': 'Règlement intérieur',
  '/mentions-legales': 'Mentions légales',
  '/politique-confidentialite': 'Politique de confidentialité',
  '/mma-dinard': 'MMA à Dinard',
  '/mma-saint-malo': 'MMA à Saint-Malo',
};
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const breadcrumbSchema = pathname !== '/' && pageNames[pathname] ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: pageNames[pathname], item: `${siteUrl}${pathname}` },
  ],
} : null;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SportsClub',
  name: 'Saint-Lunaire Arts Martiaux Mixtes',
  alternateName: 'SLAMM',
  description: 'Club de MMA à Saint-Lunaire, Bretagne. Association loi 1901.',
  url: siteUrl,
  telephone: CONTACT_INFO.PHONE,
  email: CONTACT_INFO.EMAIL,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '361 Rue de la Saudrais',
    addressLocality: 'Saint-Lunaire',
    postalCode: '35800',
    addressCountry: 'FR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 48.629217,
    longitude: -2.112208,
  },
  sport: 'Arts martiaux mixtes (MMA)',
  sameAs: [SOCIAL_URLS.INSTAGRAM],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Saint-Lunaire Arts Martiaux Mixtes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    {pageSchema && <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />}
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class:list={[{ 'has-banner': SUMMER_BREAK.active }]}>
    <a href="#main" class="skip-link">Aller au contenu principal</a>
    <SummerBreakBanner />
    <div class="site-bg" aria-hidden="true"></div>
    <slot />
    <FloatingTrialButton />
  </body>
  <script>
    // Bandeau de fermeture (fixe) : reporte sa hauteur réelle sur --banner-h
    // pour décaler la nav et le contenu (le message peut passer sur 2 lignes).
    const banner = document.querySelector<HTMLElement>('.summer-break');
    if (banner) {
      const setBannerHeight = () =>
        document.documentElement.style.setProperty('--banner-h', `${banner.offsetHeight}px`);
      setBannerHeight();
      window.addEventListener('resize', setBannerHeight);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
    );
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  </script>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --g50:  #f0fdf4;
    --g100: #dcfce7;
    --g200: #bbf7d0;
    --g400: #4ade80;
    --g500: #22c55e;
    --g600: #16a34a;
    --g700: #15803d;
    --g900: #14532d;
    --g950: #052e16;

    --bg:   #080f0a;
    --bg1:  #0d1a10;
    --bg2:  #111f15;
    --surface: #152018;
    --border: rgba(34,197,94,0.12);
    --border-strong: rgba(34,197,94,0.25);

    /* Textes neutres (très légère teinte verte) : le vert reste réservé aux accents */
    --text:    #eef2ef;
    --text-2:  #d2dad4;
    --text-3:  #a9b5ad;
    --text-muted: #87948b;

    /* Une seule famille : Archivo élargie (titres) / largeur normale (texte) */
    --font-display: 'Archivo Expanded', 'Archivo Variable', sans-serif;
    --font-body:    'Archivo Variable', sans-serif;

    /* Arrondis : boutons en pilule (100px), cartes 20px, éléments internes 12px */
    --r-sm: 8px;
    --r-md: 12px;
    --r-lg: 20px;
    --r-xl: 20px;

    /* Échelle des titres de section (Archivo élargie 800 : min 28px pour tenir à 375px) */
    --fs-h2: clamp(28px, 4.4vw, 52px);

    /* Avertissements (pages ressources) : seule teinte hors palette, porteuse de sens */
    --warn: #f5b546;
    --warn-bg: rgba(245,181,70,0.07);

    /* Courbes fortes : ease-out pour entrées/réponses, ease-in-out pour déplacements */
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);

    /* Permet d'animer height: auto (accordéons <details>) là où c'est supporté */
    interpolate-size: allow-keywords;
  }

  html {
    /* Réserve la place de la barre : pas de saut quand le menu mobile bloque le scroll */
    scrollbar-gutter: stable;
    scroll-behavior: smooth;
    scroll-padding-top: 80px;
  }

  /* Bandeau de fermeture estivale (fixe en haut) : réserve la place sous le
     bandeau et décale la nav. --banner-h est affiné en JS selon la hauteur réelle. */
  body.has-banner {
    --banner-h: 42px;
    padding-top: var(--banner-h);
  }
  body.has-banner #nav {
    top: var(--banner-h);
  }
  html:has(body.has-banner) {
    scroll-padding-top: calc(80px + 42px);
  }

  body {
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  /* Fond global : un seul halo statique en haut à gauche (pas de flou ni d'animation) */
  .site-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 55% at 0% 0%, rgba(22,163,74,0.16), transparent 70%),
      var(--bg);
  }

  /* Titres display : lignes équilibrées */
  h1, h2 {
    text-wrap: balance;
  }


  :focus-visible {
    outline: 2px solid var(--g400);
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* Lien d'évitement — visible uniquement au focus clavier */
  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 1000;
    padding: 10px 18px;
    background: var(--g500);
    color: var(--bg);
    font-weight: 600;
    font-size: 14px;
    border-radius: var(--r-sm);
    transform: translateY(-150%);
    transition: transform 0.2s var(--ease-out);
  }
  .skip-link:focus {
    transform: translateY(0);
  }

  ::selection {
    background: var(--g600);
    color: white;
  }

  ::-webkit-scrollbar {
    width: 12px;
  }
  ::-webkit-scrollbar-track {
    background: var(--bg);
  }
  ::-webkit-scrollbar-thumb {
    background: var(--g700);
    border-radius: 6px;
    border: 3px solid var(--bg);
    background-clip: padding-box;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--g600);
    background-clip: padding-box;
    border: 3px solid var(--bg);
  }
  html {
    scrollbar-width: thin;
    scrollbar-color: var(--g700) var(--bg);
  }

  img { display: block; max-width: 100%; }
  a { color: inherit; text-decoration: none; }

  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  @media (max-width: 768px) {
    .container { padding: 0 16px; }
  }

  /* Reveal animation — appliquée uniquement si le JS est actif (sinon le
     contenu reste visible : pas de page blanche si l'observer ne tourne pas) */
  .js .reveal {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 500ms var(--ease-out), transform 500ms var(--ease-out);
  }
  .js .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .reveal-delay-1 { transition-delay: 60ms; }
  .reveal-delay-2 { transition-delay: 120ms; }
  .reveal-delay-3 { transition-delay: 180ms; }
  .reveal-delay-4 { transition-delay: 240ms; }

  /* Accordéons <details> : ouverture en douceur (amélioration progressive,
     les navigateurs sans ::details-content s'ouvrent instantanément) */
  .accordion-item::details-content {
    block-size: 0;
    overflow: clip;
    /* Fermeture plus rapide que l'ouverture */
    transition: block-size 180ms var(--ease-out), content-visibility 180ms allow-discrete;
  }
  .accordion-item[open]::details-content {
    block-size: auto;
    transition: block-size 250ms var(--ease-out), content-visibility 250ms allow-discrete;
  }

  /* Comportement commun des accordéons (accueil + /faq) ; l'apparence reste
     dans chaque composant. Sélecteurs préfixés par .accordion-item pour
     l'emporter sur les styles scopés. */
  .accordion-item .accordion-summary {
    transition: color 200ms ease, opacity 100ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .accordion-item .accordion-summary:hover { color: var(--g400); }
  }
  /* Appui : la question s'estompe, le chevron s'enfonce d'1px */
  .accordion-item .accordion-summary:active { opacity: 0.8; }

  .accordion-item .accordion-icon {
    transition: transform 250ms var(--ease-out), translate 100ms var(--ease-out), color 200ms ease;
  }
  .accordion-item[open] .accordion-icon { transform: rotate(180deg); }
  .accordion-item .accordion-summary:active .accordion-icon { translate: 0 1px; }

  /* La réponse se pose une fois le panneau lancé (60ms), et s'efface
     aussitôt à la fermeture */
  .accordion-item .accordion-body {
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 100ms ease, transform 100ms ease;
  }
  .accordion-item[open] .accordion-body {
    opacity: 1;
    transform: none;
    transition:
      opacity 200ms var(--ease-out) 60ms,
      transform 200ms var(--ease-out) 60ms;
  }
  /* Le contenu fermé est ignoré par le rendu : sans état de départ explicite,
     la transition d'ouverture ne se déclencherait pas */
  @starting-style {
    .accordion-item[open] .accordion-body { opacity: 0; transform: translateY(-4px); }
  }

  /* Mouvement réduit : on retire les déplacements, on garde les fondus
     (opacité, couleurs) qui aident à comprendre les changements d'état */
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-delay: 0ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
    }
    .js .reveal {
      transform: none;
      transition: opacity 300ms ease;
    }
    .accordion-item::details-content,
    .accordion-item[open]::details-content { transition: none; }
    .accordion-item .accordion-icon { transition: color 200ms ease; }
    .accordion-item[open] .accordion-icon { transform: none; }
    .accordion-item .accordion-summary:active .accordion-icon { translate: none; }
    .accordion-item .accordion-body,
    .accordion-item[open] .accordion-body { transform: none; }
    @starting-style {
      .accordion-item[open] .accordion-body { transform: none; }
    }
  }
</style>
